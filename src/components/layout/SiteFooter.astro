---
// Site footer (study 6, FR-17 links): closing CTA (every page except home, which has its own final CTA),
// base and timezone, site links on column 7 (like the header nav), contact on column 10, an edge-to-edge
// wordmark, and small print. Links to unbuilt or under-filled sections are gated (src/lib/routes.ts).
import { t } from '@/i18n';
import { mailtoHref, whatsappHref } from '@/lib/contact';
import { getSettings } from '@/lib/content';
import { countryName, languageList, utcOffset } from '@/lib/place';
import { links, mainNav } from '@/lib/routes';
import WhatsAppButton from '@/components/site/WhatsAppButton.astro';

interface Props {
  /** Show the closing CTA block. Off on the home page. */
  cta?: boolean;
}

const { cta = true } = Astro.props;
const settings = await getSettings();
const { pathname } = Astro.url;
const site = await mainNav(pathname);
const legal = await links(['privacy', 'rss'], pathname);
const { city, countryCode, timezone } = settings.location;

const contact = [
  {
    label: t('whatsapp.short'),
    href: whatsappHref(settings.whatsappNumber),
    newTab: true,
  },
  { label: settings.email, href: mailtoHref(settings.email) },
  { label: t('contact.linkedin'), href: settings.links.linkedin, rel: 'me' },
  { label: t('contact.upwork'), href: settings.links.upwork, rel: 'me' },
  { label: t('contact.github'), href: settings.links.github, rel: 'me' },
];
const listLink = 'decoration-1 underline-offset-[0.2em] hover:underline';
---

<footer>
  {cta && (
    <section
      aria-labelledby="footer-cta-title"
      class="wrap grid-page py-section"
    >
      <h2
        id="footer-cta-title"
        class="col-span-12 text-4xl md:col-span-9 lg:col-span-8"
      >
        {t('footer.cta.title')}
      </h2>
      <p class="col-span-12 mt-5 max-w-measure text-lg text-muted-foreground md:col-span-7 lg:col-span-6">
        {t('footer.cta.body')}
      </p>
      <div class="col-span-12 mt-9 flex flex-wrap items-center gap-x-6 gap-y-4">
        <WhatsAppButton size="lg" />
        <a href={mailtoHref(settings.email)} class="link text-lg text-ink">
          {settings.email}
        </a>
      </div>
    </section>
  )}

  <div class="border-t border-rule">
    <div class="wrap grid-page gap-y-10 pt-10 pb-14">
      <div class="col-span-12 max-w-measure md:col-span-5">
        <p>
          {t('footer.base', {
            city,
            country: countryName(countryCode),
            offset: utcOffset(timezone),
          })}
        </p>
        <p>
          {t('footer.languages', {
            languages: languageList(settings.languages.map((l) => l.code)),
          })}
        </p>
      </div>

      {site.length > 0 && (
        <nav
          aria-labelledby="footer-site-title"
          class="col-span-6 md:col-span-3 md:col-start-7"
        >
          <h2
            id="footer-site-title"
            class="mb-3 text-sm font-medium text-muted-foreground"
          >
            {t('footer.site')}
          </h2>
          <ul class="grid gap-1.5">
            {site.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={item.current ? 'page' : undefined}
                  class={listLink}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}

      <div class="col-span-6 md:col-span-3 md:col-start-10">
        <h2 class="mb-3 text-sm font-medium text-muted-foreground">
          {t('footer.contact')}
        </h2>
        <ul class="grid gap-1.5">
          {contact.map((c) => (
            <li>
              <a
                href={c.href}
                class={listLink}
                rel={c.newTab ? 'noopener noreferrer' : c.rel}
                target={c.newTab ? '_blank' : undefined}
              >
                {c.label}
                {c.newTab && <span class="sr-only"> {t('a11y.newTab')}</span>}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    {/* Brand moment: the wordmark set edge to edge on the grid. 40.2cqi fits "Deyra" in Geist Semibold
         at -0.05em tracking; the negative indent cancels the D's side bearing so its stem sits on the
         grid edge. Decorative duplicate of the header wordmark, so hidden from assistive tech. */}
    <div class="wrap" aria-hidden="true">
      <div class="@container">
        <p class="-ms-[0.08em] pb-[0.16em] text-[length:40.2cqi] leading-[0.75] font-semibold tracking-[-0.05em] text-ink select-none">
          {settings.brand}
        </p>
      </div>
    </div>

    <div class="wrap">
      <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-t border-border py-6 text-xs text-muted-foreground">
        <p>
          {t('footer.copyright', {
            year: new Date().getFullYear(),
            name: settings.name,
          })}
        </p>
        {legal.length > 0 && (
          <ul class="flex gap-6">
            {legal.map((item) => (
              <li>
                <a href={item.href} class={listLink}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </div>
  </div>
</footer>
