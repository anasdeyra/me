---
// Home section 7 ("How we work"): the process as a chat between a founder and me (ProcessThread: one chip per step,
// then its messages), with how quotes work and languages + time zone beside it. From lg the notes column sticks
// beside the chat; below lg they follow it (`contents` wrapper + order).
import ProcessThread from '@/components/home/ProcessThread.astro';
import SectionHeading from '@/components/site/SectionHeading.astro';
import Section from '@/components/site/Section.astro';
import { t } from '@/i18n';
import { getHome, getSettings } from '@/lib/content';
import { languageList, utcOffset } from '@/lib/place';

const [home, settings] = await Promise.all([getHome(), getSettings()]);
const { city, timezone } = settings.location;
---

<Section id="how-we-work" labelledby="process-title">
  <div
    class="contents lg:sticky lg:top-[calc(var(--spacing-header)+1.5rem)] lg:col-span-5 lg:row-start-1 lg:block lg:self-start"
  >
    <SectionHeading id="process-title" class="reveal order-1 lg:col-span-5">
      {t('home.process.title')}
    </SectionHeading>
    <div class="reveal order-3 col-span-12 mt-16 space-y-10 lg:mt-6">
      <div>
        <h3 class="text-xl">{t('home.process.quotes')}</h3>
        <p class="mt-3 max-w-measure">{home.quoteProcess}</p>
      </div>
      <div>
        <h3 class="text-xl">{t('home.process.languages')}</h3>
        <p class="mt-3 max-w-measure">
          {t('home.process.languagesBody', {
            languages: languageList(settings.languages.map((l) => l.code)),
          })}
          {' '}
          {t('home.process.timezone', { city, offset: utcOffset(timezone) })}
        </p>
      </div>
    </div>
  </div>

  <ProcessThread class="order-2 col-span-12 lg:col-span-6 lg:col-start-7 lg:row-start-1" />
</Section>
