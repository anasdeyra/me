---
// Home section 7 ("How we work"): four steps across the grid, then quotes + languages on the left and the
// time-zone table on the right. The overlap column appears only once working hours are set in settings.
import Section from '@/components/site/Section.astro';
import SectionHeading from '@/components/site/SectionHeading.astro';
import { t } from '@/i18n';
import { getHome, getSettings } from '@/lib/content';
import { overlapRows } from '@/lib/overlap';
import { languageList, utcOffset } from '@/lib/place';

const [home, settings] = await Promise.all([getHome(), getSettings()]);
const rows = overlapRows(settings);
const hasOverlap = rows.some((r) => r.standard.overlap);
const { city, timezone } = settings.location;

const stagger = ['', 'sm:[--i:1]', 'lg:[--i:2]', 'lg:[--i:3]'];
const diffLabel = (h: number) =>
  h === 0
    ? t('home.tz.same')
    : t(h > 0 ? 'home.tz.ahead' : 'home.tz.behind', { n: Math.abs(h) });
// Standard value, plus the summer-time value when the region observes DST.
const seasonal = (std: string, summer?: string) =>
  summer && summer !== std
    ? `${std} ${t('home.tz.summer', { value: summer })}`
    : std;
---

<Section id="how-we-work" labelledby="process-title">
  <SectionHeading id="process-title" class="reveal md:col-span-8 lg:col-span-6">
    {t('home.process.title')}
  </SectionHeading>

  <ol class="col-span-12 grid gap-x-gutter gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
    {home.process.map((step, i) => (
      <li class:list={['reveal border-t-[3px] border-rule pt-4', stagger[i]]}>
        <p
          class="text-sm font-medium text-muted-foreground tabular-nums"
          aria-hidden="true"
        >
          {String(i + 1).padStart(2, '0')}
        </p>
        <h3 class="mt-3 text-lg">{step.title}</h3>
        <p class="mt-2 text-muted-foreground">{step.text}</p>
      </li>
    ))}
  </ol>

  <div class="reveal col-span-12 mt-16 space-y-10 lg:col-span-4 lg:mt-24">
    <div>
      <h3 class="text-xl">{t('home.process.quotes')}</h3>
      <p class="mt-3 max-w-measure">{home.quoteProcess}</p>
    </div>
    <div>
      <h3 class="text-xl">{t('home.process.languages')}</h3>
      <p class="mt-3">
        {t('home.process.languagesBody', {
          languages: languageList(settings.languages.map((l) => l.code)),
        })}
      </p>
    </div>
  </div>

  <div class="reveal col-span-12 mt-12 overflow-x-auto lg:col-span-7 lg:col-start-6 lg:mt-24">
    <table class="w-full border-collapse text-start text-sm md:text-base">
      <caption class="mb-4 text-start text-sm text-muted-foreground">
        {t('home.tz.caption', { city, offset: utcOffset(timezone) })}
      </caption>
      <thead>
        <tr class="border-b border-rule text-start">
          <th scope="col" class="py-3 pe-4 text-start font-semibold text-ink">
            {t('home.tz.region')}
          </th>
          <th scope="col" class="py-3 pe-4 text-start font-semibold text-ink">
            {t('home.tz.offset')}
          </th>
          <th scope="col" class="py-3 pe-4 text-start font-semibold text-ink">
            {t('home.tz.diff')}
          </th>
          {hasOverlap && (
            <th scope="col" class="py-3 text-start font-semibold text-ink">
              {t('home.tz.overlap')}
            </th>
          )}
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr class="border-b border-border">
            <th scope="row" class="py-3 pe-4 text-start font-medium text-ink">
              {r.region}
            </th>
            <td class="py-3 pe-4 tabular-nums">
              {seasonal(r.standard.offset, r.summer?.offset)}
            </td>
            <td class="py-3 pe-4">
              {seasonal(
                diffLabel(r.standard.diffHours),
                r.summer && diffLabel(r.summer.diffHours),
              )}
            </td>
            {hasOverlap && (
              <td class="py-3 tabular-nums">
                {seasonal(r.standard.overlap ?? '', r.summer?.overlap)}
              </td>
            )}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Section>
