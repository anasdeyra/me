---
// Home section 1 (owner review 2026-11-17): a full-bleed black hero in both themes. The section carries the `.dark`
// token set, so every token below it (ink, foreground, border, WhatsApp, outline button) resolves to its dark value
// even in the light theme; the page under it follows the theme. Composition: a giant uppercase name across the
// width, a portrait card breaking the name at its slash, a thin tick ring behind the card, tiny mono corner labels,
// then the outcome headline (the H1) with the two doors (WhatsApp for clients, CV for recruiters).
//
// Name vs H1: the name is a real <p> (read by screen readers, found by search, translate="no"), not the H1. The H1
// stays the outcome headline ("what I do for whom"), which carries the conversion message and the SEO text; the
// name also lives in <title>, the header wordmark, the portrait alt and the Person schema.
// The portrait is the eager, high-priority image. No `.reveal` here (LCP, first screen). Zero JS: the ring turns
// with the scroll only where animation-timeline exists and motion is allowed (see .tick-ring in global.css).
import { Image } from 'astro:assets';
import ArrowIcon from '@/components/site/ArrowIcon.astro';
import Button from '@/components/site/Button.astro';
import WhatsAppButton from '@/components/site/WhatsAppButton.astro';
import { t } from '@/i18n';
import { mailtoHref, whatsappPrefill } from '@/lib/contact';
import { contentImage, getHome, getProfile, getSettings } from '@/lib/content';
import { utcOffset } from '@/lib/place';
import { isLive } from '@/lib/routes';

const [home, profile, settings] = await Promise.all([
  getHome(),
  getProfile(),
  getSettings(),
]);
const photo = contentImage('en/profile', profile.photo);
const showCv = await isLive('cv');
const { city, countryCode, timezone } = settings.location;
// Static, computed at build: Africa/Tunis has no DST, so "UTC+1" never goes stale and no clock script is needed.
const offset = utcOffset(timezone);
const [firstName, ...rest] = settings.name.split(' ');
const lastName = rest.join(' ');
---

<section class="hero dark relative isolate overflow-clip bg-background text-foreground">
  <div class="wrap hero-micro flex items-start justify-between gap-x-6 pt-4 md:pt-5">
    <p class="mono">{t('home.hero.place', { city, country: countryCode })}</p>
    <p class="mono max-sm:hidden">{t('home.hero.time', { city, offset })}</p>
    <a
      href={mailtoHref(settings.email)}
      class="mono hero-mail"
      data-track="contact_email_click"
      data-track-location="hero"
    >
      {settings.email}
    </a>
  </div>

  <div class="wrap">
    <div class="hero-stage">
      <div class="hero-inner">
        <span class="mono hero-corner hero-corner-ts max-md:hidden" aria-hidden="true">//</span>
        <span class="mono hero-corner hero-corner-te max-md:hidden" aria-hidden="true">//</span>
        <span class="mono hero-corner hero-corner-bs max-md:hidden" aria-hidden="true">//</span>
        <span class="mono hero-corner hero-corner-be max-md:hidden" aria-hidden="true">//</span>

        <span class="tick-ring hero-ring" aria-hidden="true"></span>

        <p class="hero-name" translate="no">
          <span>{firstName}</span>
          <span class="hero-slash" aria-hidden="true">/</span>
          <span>{lastName}</span>
        </p>

        {photo && (
          <div class="hero-card">
            <Image
              src={photo}
              alt={profile.photoAlt}
              width={560}
              height={700}
              widths={[140, 280, 420, 560]}
              sizes="(min-width: 1600px) 280px, (min-width: 768px) 19vw, 32vw"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        )}
      </div>
    </div>
  </div>

  <div class="wrap grid-page hero-copy">
    <div class="col-span-12 lg:col-span-7">
      <p class="eyebrow mb-4 text-sm font-medium text-muted-foreground md:mb-5">
        {profile.title}
      </p>
      <h1 class="text-3xl">{home.hero.headline}</h1>
      <p class="mt-4 max-w-measure text-base md:mt-6 md:text-lg">{home.hero.subline}</p>
    </div>

    <div class="col-span-12 mt-7 flex flex-col items-start gap-3 md:mt-9 lg:col-span-4 lg:col-start-9 lg:mt-0 lg:justify-end">
      <WhatsAppButton
        size="lg"
        class="max-w-full rounded-full ps-6 pe-2"
        text={whatsappPrefill('home_hero')}
        trackLocation="hero"
      >
        <span slot="end" class="hero-go bg-background text-ink" aria-hidden="true">
          <ArrowIcon class="size-4" />
        </span>
      </WhatsAppButton>
      {showCv && (
        <Button
          href="/cv"
          variant="outline"
          size="lg"
          class="rounded-full ps-6 pe-2"
          data-track="cv_view"
          data-track-source="hero"
        >
          {t('cta.viewCv')}
          <span class="hero-go bg-ink text-background" aria-hidden="true">
            <ArrowIcon class="size-4" />
          </span>
        </Button>
      )}
      <p class="mt-1 text-sm text-muted-foreground">{t('home.hero.reply')}</p>
    </div>
  </div>

  <div class="wrap hero-micro max-md:hidden">
    <a href="#statement" class="mono hero-scroll">
      <span>{t('home.hero.scroll')}</span>
      <span class="hero-scroll-line" aria-hidden="true"></span>
    </a>
  </div>
</section>

<style>
  /*
   * Hero block (owner review 2026-11-17). The only raw values here are geometry in em/cqi of the name's size. Colour is
   * tokens only: the section's `.dark` scope makes --ink white, --muted-foreground #a3a3a3 (8.3:1 on black).
   */
  .hero {
    min-block-size: calc(100svh - var(--spacing-header));
  }
  /* Film grain: the shared grain tile at low opacity (flat black reads as digital without it). */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: var(--grain);
    background-size: 240px;
    opacity: 0.07;
    pointer-events: none;
  }
  @media (forced-colors: active) {
    .hero::before {
      display: none;
    }
  }

  .mono {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.3;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }
  .hero-mail,
  .hero-scroll {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    margin-block: -0.75rem;
    transition: color var(--dur-1) var(--ease-out);
  }
  .hero-mail {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
  }
  .hero-mail:focus-visible,
  .hero-scroll:focus-visible {
    color: var(--ink);
  }
  @media (hover: hover) {
    .hero-mail:hover,
    .hero-scroll:hover {
      color: var(--ink);
    }
  }

  /* Stage: the name, the card and the ring share one box whose type size is a share of the page column's width,
     so the name always fits (everything inside is in em). */
  .hero-stage {
    container-type: inline-size;
    margin-block: 1.25rem 0.5rem;
  }
  @media (width >= 48rem) {
    .hero-stage {
      margin-block: 2.75rem 0.5rem;
    }
  }
  .hero-inner {
    --slash-shift: 0em;
    position: relative;
    font-size: 24.5cqi;
    padding-block-start: 0.5em;
    padding-block-end: 0.15em;
  }
  .hero-name {
    display: grid;
    justify-items: start;
    margin: 0;
    font-weight: 800;
    font-size: 1em;
    line-height: 0.82;
    letter-spacing: -0.055em;
    text-transform: uppercase;
    color: var(--ink);
    white-space: nowrap;
  }
  .hero-slash {
    display: none;
    color: var(--link);
  }
  /* Phone: the card sits at the end of the first line and dips into the second, breaking its last letters. */
  .hero-card {
    position: absolute;
    inset-block-start: 0;
    inset-inline-end: 0;
    inline-size: 1.22em;
    border-radius: var(--radius);
    overflow: clip;
  }
  .hero-card :global(img) {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .hero-ring {
    position: absolute;
    inset-block-start: 0.7em;
    inset-inline-end: -0.6em;
    inline-size: 2.5em;
    translate: 0 -50%;
    color: var(--muted-foreground);
    opacity: 0.55;
    z-index: -1;
  }
  .hero-corner {
    position: absolute;
  }

  @media (width >= 48rem) {
    .hero-inner {
      font-size: 14.5cqi;
      --slash-shift: -0.21em;
      display: grid;
      place-items: center;
      padding-block: 0.4em;
    }
    .hero-name {
      display: flex;
      align-items: center;
      justify-items: initial;
      white-space: nowrap;
    }
    .hero-slash {
      display: block;
      margin-inline: 0.3em;
      font-weight: 300;
    }
    .hero-card {
      inset-block-start: 0;
      inset-inline: 0;
      margin-inline: auto;
      inline-size: 1.2em;
      translate: var(--slash-shift) 0;
    }
    .hero-ring {
      inset-block-start: 50%;
      inset-inline: 0;
      margin-inline: auto;
      inline-size: 2.15em;
      translate: var(--slash-shift) -50%;
      opacity: 0.6;
    }
    .hero-corner-ts,
    .hero-corner-te {
      inset-block-start: 0.1em;
    }
    .hero-corner-bs,
    .hero-corner-be {
      inset-block-end: 0.1em;
    }
    .hero-corner-ts,
    .hero-corner-bs {
      inset-inline-start: 0;
    }
    .hero-corner-te,
    .hero-corner-be {
      inset-inline-end: 0;
    }
  }

  .hero-copy {
    padding-block: 2.5rem 3rem;
    align-items: end;
  }
  @media (width >= 48rem) {
    .hero-copy {
      padding-block: 2.5rem 1.5rem;
    }
  }

  /* The circular arrow inside each pill. Slides up and out a hair on hover / keyboard focus (decorative; off for
     reduced motion). */
  .hero-go {
    display: grid;
    place-items: center;
    inline-size: 2.25rem;
    block-size: 2.25rem;
    border-radius: 50%;
    margin-inline-start: 0.25rem;
    flex-shrink: 0;
    transition: translate var(--dur-2) var(--ease-out);
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    :global([data-slot='button']:hover) .hero-go {
      translate: 0.125rem -0.125rem;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    :global([data-slot='button']:focus-visible) .hero-go {
      translate: 0.125rem -0.125rem;
    }
  }

  .hero-scroll {
    gap: 0.75rem;
  }
  .hero-scroll-line {
    inline-size: 2.5rem;
    block-size: 1px;
    background: currentColor;
  }
  @media (width >= 48rem) {
    .hero-micro:last-child {
      display: flex;
      justify-content: flex-end;
      padding-block-end: 0.75rem;
    }
  }
</style>
