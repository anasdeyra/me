---
// Home section 1 (owner pick 2026-11-23, hero lab 2 option C "Composer"): the outcome headline and subline on the
// left; on the right the primary action in its working form, a WhatsApp draft addressed to Anas. The visitor picks
// what they need and the draft and its link change with it, so the first message is already half written.
//
// Zero JS: the chips are radios, and `:has()` shows one pre-rendered draft and one link. Without `:has()` the chips
// hide and the generic draft and link show. The draft bubble pops on the bouncy spring when the choice changes
// (display toggles restart the animation); off under reduced motion.
//
// Under 64rem: headline, CV link (the recruiter door), the draft, then the subline, so both doors stay above the fold.
// The H1 carries the conversion message and the SEO text; the avatar is decorative (the name sits beside it).
import { Image } from 'astro:assets';
import ArrowIcon from '@/components/site/ArrowIcon.astro';
import WhatsAppButton from '@/components/site/WhatsAppButton.astro';
import { t } from '@/i18n';
import { whatsappPrefill } from '@/lib/contact';
import { contentImage, getHome, getProfile, getSettings } from '@/lib/content';
import { utcOffset } from '@/lib/place';
import { isLive } from '@/lib/routes';

const [home, profile, settings, showCv] = await Promise.all([
  getHome(),
  getProfile(),
  getSettings(),
  isLive('cv'),
]);
const photo = contentImage('en/profile', profile.photo);
// One chip per engagement, then a generic option. Each draft ends open so the visitor types on.
const needs = [
  ...(['booking', 'integration', 'ai', 'product'] as const).map((id) => ({
    id,
    label: t(`home.hero.need.${id}`),
    text: t(`whatsapp.prefill.need.${id}`),
  })),
  {
    id: 'other',
    label: t('home.hero.need.other'),
    text: whatsappPrefill('home_hero'),
  },
];
---

<section class="hero wrap grid-page" aria-labelledby="hero-head">
  <div class="hero-copy">
    <h1 id="hero-head" class="text-4xl lg:text-5xl">
      {home.hero.headline}
    </h1>
    <p class="hero-line text-lg">{home.hero.subline}</p>
    {showCv && (
      <p class="hero-cv text-sm">
        <a
          class="link"
          href="/cv"
          data-track="cv_view"
          data-track-source="hero"
        >
          {t('cta.viewCv')}
        </a>
      </p>
    )}
  </div>

  <div class="hero-box">
    <div class="hero-to">
      {photo && (
        <Image
          src={photo}
          alt=""
          widths={[96]}
          sizes="48px"
          class="hero-avatar"
          loading="eager"
        />
      )}
      <p>
        <span class="hero-who" translate="no">
          {settings.name}
        </span>
        <span class="hero-where text-sm">
          {t('home.hero.where', {
            title: profile.title,
            city: settings.location.city,
            offset: utcOffset(settings.location.timezone),
          })}
        </span>
      </p>
    </div>

    <fieldset class="hero-needs">
      <legend class="text-sm">{t('home.hero.needs')}</legend>
      {needs.map(({ id, label }, i) => (
        <>
          <input
            type="radio"
            name="hero-need"
            id={`hero-need-${i}`}
            value={id}
            checked={i === 0}
          />
          <label for={`hero-need-${i}`}>{label}</label>
        </>
      ))}
    </fieldset>

    <div class="hero-draft" aria-live="polite">
      {needs.map(({ text }, i) => (
        <p class="hero-bubble" data-need={i}>
          {text}
          <span class="hero-caret" aria-hidden="true" />
        </p>
      ))}
      <p class="hero-bubble is-fallback">
        {whatsappPrefill('home_hero')}
        <span class="hero-caret" aria-hidden="true" />
      </p>
    </div>

    <div class="hero-send">
      {needs.map(({ id, text }, i) => (
        <span data-need={i}>
          <WhatsAppButton
            size="lg"
            label={t('home.hero.send')}
            text={text}
            trackLocation="hero"
            trackSlug={id}
            class="hero-go ps-6 pe-2"
          >
            <span
              slot="end"
              class="go-chip bg-white text-whatsapp"
              aria-hidden="true"
            >
              <ArrowIcon class="size-4" />
            </span>
          </WhatsAppButton>
        </span>
      ))}
      <span class="is-fallback">
        <WhatsAppButton
          size="lg"
          label={t('home.hero.client')}
          text={whatsappPrefill('home_hero')}
          trackLocation="hero"
          class="hero-go ps-6 pe-2"
        >
          <span
            slot="end"
            class="go-chip bg-white text-whatsapp"
            aria-hidden="true"
          >
            <ArrowIcon class="size-4" />
          </span>
        </WhatsAppButton>
      </span>
    </div>
  </div>
</section>

<style>
  .hero {
    row-gap: 2.5rem;
    align-content: center;
    padding-block: 2rem 3rem;
  }
  /* Phone: headline, CV link, the draft (the action), then the subline. */
  .hero-copy {
    display: contents;
  }
  .hero-copy > *,
  .hero-box {
    grid-column: 1 / -1;
  }
  .hero-cv {
    order: 1;
    margin-block-start: -1.5rem;
  }
  .hero-box {
    order: 2;
  }
  .hero-line {
    order: 3;
    margin-block-start: -1rem;
    max-inline-size: 34ch;
  }
  .hero-copy h1 {
    max-inline-size: 14ch;
    font-weight: 600;
    color: var(--ink);
    text-wrap: balance;
  }

  /* The draft: one bordered surface, the conversation it starts. */
  .hero-box {
    display: grid;
    gap: 1.5rem;
    align-self: center;
    padding: clamp(1.25rem, 0.75rem + 2vw, 2rem);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: var(--background);
  }
  .hero-to {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }
  .hero-to p {
    display: grid;
  }
  .hero-box :global(.hero-avatar) {
    inline-size: 3rem;
    block-size: 3rem;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 25%;
  }
  .hero-who {
    font-weight: 600;
    color: var(--ink);
  }
  .hero-where {
    color: var(--muted-foreground);
  }

  /* Chips: real radios, visually hidden, labels as pills. */
  .hero-needs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .hero-needs legend {
    margin-block-end: 0.75rem;
    padding: 0;
    color: var(--muted-foreground);
  }
  .hero-needs input {
    position: absolute;
    opacity: 0;
    inline-size: 1px;
    block-size: 1px;
  }
  .hero-needs label {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.5rem;
    padding-inline: 1rem;
    border: 1px solid var(--border);
    border-radius: 1.25rem;
    font-size: var(--text-sm);
    color: var(--ink);
    cursor: pointer;
    transition:
      background-color var(--dur-effect) var(--ease-effect),
      color var(--dur-effect) var(--ease-effect),
      border-color var(--dur-effect) var(--ease-effect),
      border-radius var(--dur-spring-fast) var(--ease-spring-fast);
  }
  @media (hover: hover) {
    .hero-needs label:hover {
      border-color: var(--ink);
    }
  }
  .hero-needs input:checked + label {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--background);
  }
  .hero-needs input:focus-visible + label {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-needs input:checked + label {
      border-radius: var(--radius-sm);
    }
  }

  /* The draft bubble: an outgoing message, tail at the end-bottom corner. */
  .hero-draft {
    display: grid;
    justify-items: end;
  }
  .hero-bubble {
    max-inline-size: 34ch;
    margin: 0;
    padding: 0.875rem 1.125rem;
    border-radius: var(--radius-lg) var(--radius-lg) var(--radius-xs)
      var(--radius-lg);
    background: var(--muted);
    color: var(--ink);
    transform-origin: 100% 100%;
  }
  .hero-bubble:dir(rtl) {
    border-radius: var(--radius-lg) var(--radius-lg) var(--radius-lg)
      var(--radius-xs);
    transform-origin: 0 100%;
  }
  .hero-caret {
    display: inline-block;
    inline-size: 2px;
    block-size: 1.1em;
    margin-inline-start: 1px;
    vertical-align: text-bottom;
    background: var(--ink);
  }
  .hero-send {
    display: flex;
    justify-content: end;
  }
  .hero-send :global(.hero-go) {
    gap: 1rem;
  }

  /* One draft and one link at a time. Without :has(), the chips go and the generic draft stays. */
  [data-need] {
    display: none;
  }
  @supports selector(:has(*)) {
    .is-fallback {
      display: none;
    }
    .hero:has(#hero-need-0:checked) [data-need='0'],
    .hero:has(#hero-need-1:checked) [data-need='1'],
    .hero:has(#hero-need-2:checked) [data-need='2'],
    .hero:has(#hero-need-3:checked) [data-need='3'],
    .hero:has(#hero-need-4:checked) [data-need='4'] {
      display: block;
    }
  }
  @supports not selector(:has(*)) {
    .hero-needs {
      display: none;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-bubble {
      animation: hero-pop var(--dur-spring-bouncy) var(--ease-spring-bouncy)
        both;
    }
  }
  @keyframes hero-pop {
    from {
      opacity: 0;
      scale: 0.92;
    }
  }

  @media (width >= 64rem) {
    .hero {
      min-block-size: calc(100svh - var(--spacing-header));
    }
    .hero-copy {
      display: block;
      grid-column: 1 / span 6;
      align-self: center;
    }
    .hero-line {
      margin-block-start: 1.5rem;
    }
    .hero-cv {
      margin-block-start: 2rem;
    }
    .hero-box {
      grid-column: 8 / -1;
    }
  }
  @media print {
    .hero-box {
      display: none;
    }
  }
</style>
