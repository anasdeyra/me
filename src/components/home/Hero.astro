---
// Home section 1 (owner review 2026-11-17, soft & round): one centred stack on a rounded panel that follows the
// theme, like every other section. Order: the morphing portrait, the name, the outcome headline (H1), the subline,
// the Upwork proof line (TrustStrip: stars that fill once on load, then a chip of claims that rolls twice and rests),
// then the two doors (WhatsApp for clients, CV for recruiters), each with one line of reassurance under it.
//
// Name vs H1: the name is a real <p> (read by screen readers, found by search, translate="no"), not the H1. The H1
// stays the outcome headline ("what I do for whom"), which carries the conversion message and the SEO text; the
// name also lives in <title>, the header wordmark, the portrait alt and the Person schema.
//
// The portrait is the eager, high-priority LCP image in a fixed square box (no layout shift). Its M3 shape morph is
// CSS only (HeroShapeStyle, rendered in the page head): the clip-path never delays the image. A Dusk halo and a
// scroll-linked MorphShape sit behind it, never behind text. No `.reveal` and no JS here.
import { Image } from 'astro:assets';
import ArrowIcon from '@/components/site/ArrowIcon.astro';
import Button from '@/components/site/Button.astro';
import DuskGlow from '@/components/site/DuskGlow.astro';
import MorphShape from '@/components/site/MorphShape.astro';
import WhatsAppButton from '@/components/site/WhatsAppButton.astro';
import TrustStrip from '@/components/home/TrustStrip.astro';
import { t } from '@/i18n';
import { whatsappPrefill } from '@/lib/contact';
import { contentImage, getHome, getProfile, getSettings } from '@/lib/content';
import { isLive } from '@/lib/routes';

const [home, profile, settings] = await Promise.all([
  getHome(),
  getProfile(),
  getSettings(),
]);
const photo = contentImage('en/profile', profile.photo);
const showCv = await isLive('cv');
const { career } = settings;
const modes = new Intl.ListFormat('en', { type: 'conjunction' }).format(
  career.workModes.map((m) => t(`workMode.${m}` as const)),
);
---

<section class="hero wrap pt-3 md:pt-4">
  <div class="hero-panel relative isolate flex flex-col items-center overflow-clip bg-muted text-center">
    {photo && (
      <div class="hero-portrait relative isolate" data-glow>
        <DuskGlow class="hero-halo" />
        <MorphShape
          uid="hero"
          shapes={['12-sided-cookie', 'soft-burst', 'flower']}
          timeline="root"
          range={['0', '80vh']}
          turn={120}
          class="hero-ring"
        />
        <div class="hero-shape">
          <Image
            src={photo}
            alt={profile.photoAlt}
            width={500}
            height={625}
            widths={[200, 250, 400, 500]}
            sizes="(min-width: 1080px) 250px, 200px"
            loading="eager"
            fetchpriority="high"
            class="hero-photo"
          />
        </div>
      </div>
    )}

    <div class="mt-7 flex flex-wrap items-baseline justify-center gap-x-2.5 gap-y-1 md:mt-9">
      <p class="text-lg font-semibold text-ink" translate="no">
        {settings.name}
      </p>
      <p class="hero-title text-lg text-muted-foreground">{profile.title}</p>
    </div>

    <h1 class="mt-4 max-w-[18ch] text-4xl md:mt-5">{home.hero.headline}</h1>
    <p class="mt-5 max-w-[54ch] text-base md:mt-6 md:text-lg">
      {home.hero.subline}
    </p>

    <div class="mt-7 md:mt-8">
      <TrustStrip />
    </div>

    <ul class="hero-doors mt-8 md:mt-10" role="list">
      <li>
        <WhatsAppButton
          size="lg"
          label={t('home.hero.client')}
          class="hero-door ps-6 pe-2"
          text={whatsappPrefill('home_hero')}
          trackLocation="hero"
          describedBy="hero-client-hint"
        >
          <span
            slot="end"
            class="go-chip bg-background text-ink"
            aria-hidden="true"
          >
            <ArrowIcon class="size-4" />
          </span>
        </WhatsAppButton>
        <p id="hero-client-hint" class="hero-hint">
          {t('home.hero.clientHint')}
        </p>
      </li>
      {showCv && (
        <li>
          <Button
            href="/cv"
            variant="outline"
            size="lg"
            class="hero-door ps-6 pe-2"
            data-track="cv_view"
            data-track-source="hero"
            aria-describedby={career.openToRoles ? 'hero-cv-hint' : undefined}
          >
            {t('cta.viewCv')}
            <span class="go-chip bg-ink text-background" aria-hidden="true">
              <ArrowIcon class="size-4" />
            </span>
          </Button>
          {career.openToRoles && (
            <p id="hero-cv-hint" class="hero-hint">
              {t('home.hero.cvHint', { modes })}
            </p>
          )}
        </li>
      )}
    </ul>
  </div>
</section>

<style>
  /* Panel: the site's soft radius scale (3xl on phones, 4xl from md), --muted surface in both themes. */
  .hero-panel {
    border-radius: var(--radius-3xl);
    padding: clamp(2.25rem, 1.5rem + 3vw, 4rem) var(--spacing-gutter)
      clamp(2.5rem, 1.75rem + 3vw, 4rem);
  }
  @media (width >= 48rem) {
    .hero-panel {
      border-radius: var(--radius-4xl);
    }
  }

  /* Portrait: a fixed square, so the morph and the turn never move anything around it. */
  .hero-portrait {
    --size: clamp(10rem, 7rem + 9vw, 14rem);
    inline-size: var(--size);
    block-size: var(--size);
  }
  .hero-halo {
    --dusk-inset: -32%;
    --dusk-opacity: 0.9;
  }
  /* A Material 3 shape behind the portrait (MorphShape; replaces the tick ring): twists, morphs and shifts tone as the
     page scrolls away from the top. */
  .hero-ring {
    inset: -14%;
  }
  .hero-shape {
    position: absolute;
    inset: 0;
    overflow: clip;
    background: var(--border);
  }
  /* Overscan (position and size) comes from HeroShapeStyle: the photo stays larger than the frame so it covers it while turning. */
  .hero-shape :global(.hero-photo) {
    position: absolute;
    max-inline-size: none;
    object-fit: cover;
    object-position: 50% 30%;
  }

  /* The title follows the name after a small dot (decorative). */
  .hero-title::before {
    content: '';
    display: inline-block;
    inline-size: 0.3em;
    block-size: 0.3em;
    margin-inline-end: 0.625rem;
    vertical-align: 0.2em;
    border-radius: 50%;
    background: var(--brand);
  }

  /* Doors: side by side and centred from sm, stacked full width (to a comfortable cap) on phones. */
  .hero-doors {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.25rem 1rem;
    inline-size: 100%;
    padding: 0;
    list-style: none;
  }
  .hero-doors > li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.625rem;
    inline-size: min(100%, 22rem);
  }
  @media (width >= 40rem) {
    .hero-doors > li {
      inline-size: auto;
    }
  }
  .hero-doors :global(.hero-door) {
    inline-size: 100%;
    justify-content: space-between;
  }
  @media (width >= 40rem) {
    .hero-doors :global(.hero-door) {
      inline-size: auto;
    }
  }
  .hero-hint {
    font-size: var(--text-sm);
    line-height: var(--text-sm--line-height);
    color: var(--muted-foreground);
  }

  @media print {
    .hero-panel {
      background: none;
      padding-block: 0 2rem;
    }
    .hero-doors,
    .hero-halo {
      display: none;
    }
  }
</style>
