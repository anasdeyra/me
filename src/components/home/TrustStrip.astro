---
// Home section 2: Upwork proof straight under the hero. Figures come from settings only. The clients item
// links to the map section only when that section is live (FR-22); otherwise it is plain text.
import { t } from '@/i18n';
import { getClients, getSettings } from '@/lib/content';
import { isSectionLive } from '@/lib/routes';
import { upworkBadgeLabel } from '@/lib/upwork';

const settings = await getSettings();
const { upwork } = settings;
const clientCount = (await getClients()).length;
const clientsLive = await isSectionLive('clients');

const items = [
  { value: upworkBadgeLabel(upwork.badge), label: t('trust.topRatedLabel') },
  {
    value: t('trust.jss', { value: upwork.jobSuccess }),
    label: t('trust.jssLabel'),
  },
  {
    value: t('trust.rating', { rating: upwork.rating.toFixed(1) }),
    label: t('trust.ratingLabel', { reviews: upwork.reviews }),
  },
  ...(clientCount > 0
    ? [
        {
          value: t('trust.clients', { count: clientCount }),
          label: t('trust.clientsLabel'),
          href: clientsLive ? '#clients' : undefined,
        },
      ]
    : []),
];
---

<section
  aria-label={t('home.trust.label')}
  data-spec="spacing"
  class="wrap grid-page border-t border-rule py-10 md:py-14"
>
  <p class="col-span-12 mb-6 text-sm font-medium text-muted-foreground lg:col-span-3 lg:mb-0">
    {t('home.trust.label')}
  </p>
  <ul class="col-span-12 grid grid-cols-2 gap-x-gutter gap-y-8 lg:col-span-9 lg:grid-cols-4">
    {items.map((item, i) => (
      <li>
        {item.href ? (
          <a href={item.href} class="link text-ink">
            <span
              class="block text-2xl font-semibold"
              data-spec={i === 0 ? 'type:text-2xl' : undefined}
            >
              {item.value}
            </span>
            <span class="mt-1 block text-sm">{item.label}</span>
          </a>
        ) : (
          <>
            <span
              class="block text-2xl font-semibold text-ink"
              data-spec={i === 0 ? 'type:text-2xl' : undefined}
            >
              {item.value}
            </span>
            <span class="mt-1 block text-sm text-muted-foreground">
              {item.label}
            </span>
          </>
        )}
      </li>
    ))}
  </ul>
  <p class="col-span-12 mt-8 lg:col-span-9 lg:col-start-4">
    <a
      href={settings.links.upwork}
      class="link text-ink"
      target="_blank"
      rel="noopener noreferrer"
      data-track="upwork_click"
      data-track-location="trust"
    >
      {t('trust.verify')}
      <span class="sr-only"> {t('a11y.newTab')}</span>
    </a>
  </p>
</section>
