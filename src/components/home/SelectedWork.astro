---
// Home section 3: up to four projects (featured first). Hidden until at least MIN_PROJECTS are published (FR-22).
import MetisFeature from './MetisFeature.astro';
import ProjectCard from '@/components/work/ProjectCard.astro';
import Section from '@/components/site/Section.astro';
import SectionHeading from '@/components/site/SectionHeading.astro';
import { t } from '@/i18n';
import { getFeaturedProjects } from '@/lib/projects';
import { isSectionLive } from '@/lib/routes';

const live = await isSectionLive('selectedWork');
const all = live ? await getFeaturedProjects(3) : [];
const lead = all.find((p) => p.slug === 'metis');
const projects = all.filter((p) => p !== lead);
---

{live && all.length > 0 && (
  <Section id="work" labelledby="work-title">
    <SectionHeading
      id="work-title"
      class="reveal"
      eyebrow={t('home.work.eyebrow')}
    >
      {t('home.work.title')}
    </SectionHeading>
    {lead && (
      <MetisFeature project={lead} headingId="metis-title" class="reveal col-span-12" />
    )}
    {projects.length > 0 && (
      <>
        {lead && (
          <h3 class="col-span-12 mt-16 text-xl">{t('home.work.more')}</h3>
        )}
        <ul class="col-span-12 grid gap-x-gutter gap-y-14 sm:grid-cols-2">
          {projects.map((p, i) => (
            <li class:list={['reveal', i % 2 === 1 && 'sm:[--i:1]']}>
              <ProjectCard project={p} headingLevel={3} class="h-full" />
            </li>
          ))}
        </ul>
      </>
    )}
    <p class="col-span-12 mt-12">
      <a href="/work" class="link text-ink">
        {t('home.work.all')}
      </a>
    </p>
  </Section>
)}
