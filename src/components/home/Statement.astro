---
// Home section 2 (owner review 2026-11-17): the hand-off from the hero panel (no rule: the panel's edge separates). A centred uppercase statement and a
// "More about me" pill with a circular arrow, with two Material 3 shapes peeking in at the edges (owner review
// 2026-11-18, replacing the tick rings). Follows the theme (light by default).
// The shapes are decorative (MorphShape: aria-hidden, absolute, contained). As the section scrolls through the viewport
// they morph through three shapes, twist in opposite directions and walk the tones in opposite directions (grey ->
// mist and back; neutral tones only), only when motion is allowed. They stay mostly off-canvas; on narrow screens their edges can sit under the text, where the container
// tones keep the statement at AAA contrast. The pill is shown only when /about is live (FR-22).
import ArrowIcon from '@/components/site/ArrowIcon.astro';
import Button from '@/components/site/Button.astro';
import MorphShape from '@/components/site/MorphShape.astro';
import { t } from '@/i18n';
import { isLive } from '@/lib/routes';

const aboutLive = await isLive('about');
---

<section
  id="statement"
  aria-label={t('home.statement.label')}
  class="statement relative isolate overflow-clip pt-section pb-14 text-center md:pb-20"
>
  <MorphShape
    uid="statement-start"
    shapes={['sunny', 'flower', '4-sided-cookie']}
    tones={['grey', 'mist']}
    turn={150}
    class="statement-shape statement-shape-s"
  />
  <MorphShape
    uid="statement-end"
    shapes={['clamshell', '6-sided-cookie', 'pill']}
    tones={['mist', 'grey']}
    turn={-120}
    class="statement-shape statement-shape-e"
  />

  <div class="wrap">
    <p class="mx-auto max-w-[32ch] text-2xl font-semibold tracking-[-0.03em] text-ink uppercase">
      {t('home.statement.body')}
    </p>
    {aboutLive && (
      <p class="mt-10 md:mt-14">
        <Button
          href="/about"
          class="bg-muted ps-6 pe-2 text-ink hover:bg-border"
          size="lg"
        >
          {t('home.about.more')}
          <span class="go-chip bg-ink text-background" aria-hidden="true">
            <ArrowIcon class="size-4" />
          </span>
        </Button>
      </p>
    )}
  </div>
</section>

<style>
  /* Each shape shows about 40% of itself inside the edge (30% on phones, where the text runs wider): start one high,
     end one low, for a diagonal. */
  .statement-shape {
    --s: min(64vw, 32rem);
    --in: -0.7;
    inline-size: var(--s);
  }
  @media (width >= 48rem) {
    .statement-shape {
      --in: -0.6;
    }
  }
  .statement-shape-s {
    inset-block-start: 8%;
    inset-inline-start: calc(var(--s) * var(--in));
  }
  .statement-shape-e {
    inset-block-end: 4%;
    inset-inline-end: calc(var(--s) * var(--in));
  }
</style>
