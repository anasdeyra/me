---
// The hero portrait's Material 3 shape morph, generated at build time from src/lib/m3-shapes.ts (96-point polygons,
// so clip-path interpolates point by point). Emitted as one inline <style> in the page head (pass `slot="head"` to
// BaseLayout) and hashed for the CSP; config/security-headers.mjs also adds the hash to style-src post-build.
//
// Motion (owner decision 2026-11-17: the morph loops forever, an explicit override of the repo's WCAG 2.2.2 "no
// infinite animation" rule for this element only). Each shape holds, then springs into the next while the frame turns;
// the photo counter-turns so the face stays upright. Every held angle is a multiple of that shape's symmetry, so each
// shape lands upright: arch 0, 7-sided cookie 360/7, 4-leaf clover 90, pentagon 144 (5-fold), 8-leaf clover 225
// (8-fold), circle 300 (any angle), arch 360. From the suggested set, soft burst and puffy diamond were swapped for
// the 8-leaf clover and the circle: their deep notches cut into the forehead, cheeks and chin. Shapes that reach into
// the frame's corners (square, arch) cost zoom, since the photo must cover them while it turns. Without motion (reduced
// motion, print) the frame is a still arch.
//
// Spring (owner review 2026-11-18, M3 Expressive shape morphing): every morph and its turn ride one bouncy spring
// (src/lib/spring.ts), so the outline and the angle overshoot the next shape (~16%) and settle; the morph lasts the
// spring's own settle time, so it plays at its natural tempo. On top, a breath: the frame dips to 95% as it leaves a
// shape and springs back as it lands. Overshoot has two costs, both computed here from the sampled spring:
//   - room: points extrapolate past the target shape, and a clip-path cannot paint outside its element's box. The
//     shapes are drawn inset by `pad` and the frame grows by a negative margin to match, so at rest nothing moves.
//   - zoom: the photo must cover the clip outline at every progress the spring reaches (not just 0..1) and every angle
//     the overshooting turn passes through.
import { createHash } from 'node:crypto';
import {
  morphBounds,
  morphKeyframes,
  shapePoints,
  shapePolygon,
  type ShapeName,
} from '@/lib/m3-shapes';
import { springEasing } from '@/lib/spring';

const steps: { shape: ShapeName; turn: number }[] = [
  { shape: 'arch', turn: 0 },
  { shape: '7-sided-cookie', turn: 360 / 7 },
  { shape: '4-leaf-clover', turn: 90 },
  { shape: 'pentagon', turn: 144 },
  { shape: '8-leaf-clover', turn: 225 },
  { shape: 'circle', turn: 300 },
];
// A softer sibling of --ease-spring-bouncy (same damping 0.5, lower stiffness for a large surface): ~830 ms.
const spring = springEasing({ damping: 0.5, stiffness: 220 });
const HOLD_S = 1.4; // seconds each shape rests
const STEP_S = HOLD_S + spring.ms / 1000; // + the morph, at the spring's own tempo
const HOLD = HOLD_S / STEP_S; // share of each step spent holding
const BREATH = 0.95; // scale at the bottom of the breath
const DIP = 0.25; // share of the morph spent dipping; the spring brings it back over the rest
const ACCELERATE = 'cubic-bezier(.3,0,.8,.15)'; // M3 emphasized accelerate: leave the shape

const sequence = steps.map((s) => s.shape);
const n = steps.length;
const size = 100 / n;
const pct = (v: number) => `${Math.round(v * 1000) / 1000}%`;
const deg = (v: number) => `${Math.round(v * 100) / 100}deg`;
const turnAt = (i: number) => (i === n ? 360 : steps[i]!.turn);

// Progress anywhere in [lo, hi] is reached during a morph (the linear() stops are the curve's extremes).
const [lo, hi] = [spring.min, spring.max];

// Room: how far any morph's outline leaves the 0..100 box, rounded up.
let out = 0;
steps.forEach(({ shape }, i) => {
  const b = morphBounds(shape, steps[(i + 1) % n]!.shape, lo, hi);
  out = Math.max(out, -b.min, b.max - 100);
});
const pad = Math.ceil(out * 10) / 10 + 0.2;
const k = (100 - 2 * pad) / 100; // shapes span this share of the grown frame
// Margins in percent resolve against the portrait box's width, which is the resting shape's size.
const grow = Math.round(((1 / k - 1) / 2) * 100 * 1000) / 1000;

// Zoom: walk every morph over the progress range the spring reaches. Clip points and the turn share one eased
// progress, so sampling progress is exact. Measure how far the outline reaches along the photo's own axes (rotate(turn)
// maps frame -> screen; the photo sits at -turn inside the frame), then convert to the grown frame's units.
const polys = sequence.map((s) => shapePoints(s));
let reach = 50;
steps.forEach(({ turn }, i) => {
  const next = (i + 1) % n;
  const to = turnAt(i + 1);
  for (let s = 0; s <= 96; s++) {
    const p = lo + ((hi - lo) * s) / 96;
    const a = ((turn + (to - turn) * p) * Math.PI) / 180;
    const [c, si] = [Math.cos(a), Math.sin(a)];
    polys[i]!.forEach(([x0, y0], j) => {
      const [x1, y1] = polys[next]![j]!;
      const x = x0 + (x1 - x0) * p - 50;
      const y = y0 + (y1 - y0) * p - 50;
      reach = Math.max(
        reach,
        Math.abs(x * c - y * si),
        Math.abs(x * si + y * c),
      );
    });
  }
});
const overscan = Math.ceil((reach - 50) * k * 10) / 10 + 0.5;
const side = Math.round((100 + 2 * overscan) * 10) / 10;

const morph = morphKeyframes('hero-morph', sequence, {
  hold: HOLD,
  easing: spring.easing,
  pad,
  extra: (i) => `rotate:${deg(turnAt(i))}`,
});

// The photo's counter-turn: same offsets and easing as the morph, so the face stays upright through the overshoot.
const unturn = `@keyframes hero-unturn{${steps
  .map(
    ({ turn }, i) =>
      `${pct(i * size)},${pct(i * size + HOLD * size)}{rotate:${deg(-turn)};animation-timing-function:${spring.easing}}`,
  )
  .join('')}100%{rotate:-360deg}}`;

// The breath: rest at 1, dip while leaving a shape, spring back while landing.
const breath = `@keyframes hero-breath{${steps
  .map((_, i) => {
    const leave = i * size + HOLD * size;
    const dip = leave + DIP * (1 - HOLD) * size;
    return `${pct(i * size)}{scale:1}${pct(leave)}{scale:1;animation-timing-function:${ACCELERATE}}${pct(dip)}{scale:${BREATH};animation-timing-function:${spring.easing}}`;
  })
  .join('')}100%{scale:1}}`;

const duration = `${Math.round(STEP_S * n * 1000) / 1000}s`;
const css = [
  `.hero-shape{margin:-${grow}%;clip-path:${shapePolygon(sequence[0]!, undefined, { pad })}}`,
  `.hero-photo{top:-${overscan}%;left:-${overscan}%;width:${side}%;height:${side}%}`,
  morph,
  unturn,
  breath,
  `@media screen and (prefers-reduced-motion:no-preference){`,
  `.hero-shape{animation:hero-morph ${duration} linear infinite,hero-breath ${duration} linear infinite}`,
  `.hero-photo{animation:hero-unturn ${duration} linear infinite}}`,
].join('');

Astro.csp?.insertStyleHash(
  `sha256-${createHash('sha256').update(css).digest('base64')}`,
);
---

<style is:inline set:html={css} />
