---
// Home "Selected work" lead: Metis as a boarding pass. The booking flow is a race between two lanes on one grid:
// Before (six steps, about 3 min) and After (Recap page and Confirm modal removed, Ancillaries in the background,
// about 1 min). Lanes are rows and steps columns on a wide card; on a narrow one the grid flips (steps are rows).
// Both planes take off together and fly for 3:1 of the same time, so After lands first. The finished race is the
// default (no JS, reduced motion, Auto-play off); every number comes from the Metis project entry.
import { createHash } from 'node:crypto';
import ArrowIcon from '@/components/site/ArrowIcon.astro';
import Button from '@/components/site/Button.astro';
import { t } from '@/i18n';
import { morphBounds, shapePolygon } from '@/lib/m3-shapes';
import type { ProjectView } from '@/lib/projects';
import { SPRINGS, springEasing } from '@/lib/spring';
import { cn } from '@/lib/utils';

interface Props {
  project: ProjectView;
  headingId: string;
  class?: string;
}

const { project, headingId, class: className } = Astro.props;
const steps: {
  key: 'search' | 'pricing' | 'recap' | 'ancillaries' | 'modal' | 'booked';
  after: 'kept' | 'gone' | 'background';
}[] = [
  { key: 'search', after: 'kept' },
  { key: 'pricing', after: 'kept' },
  { key: 'recap', after: 'gone' },
  { key: 'ancillaries', after: 'background' },
  { key: 'modal', after: 'gone' },
  { key: 'booked', after: 'kept' },
];

// Booked's badge springs from a circle into the M3 Expressive "sunny" shape on landing. Both outlines share a point
// count and anchor, so clip-path morphs point by point; `pad` keeps the bouncy spring's overshoot inside the box.
// CSP: one hashed inline <style> with the two polygons as custom properties (pattern: MorphShape).
const POINTS = 48;
const bouncy = springEasing(SPRINGS.bouncy);
const reach = morphBounds('circle', 'sunny', bouncy.min, bouncy.max, POINTS);
const pad = Math.ceil(Math.max(-reach.min, reach.max - 100) * 10) / 10 + 0.2;
const goalCss = `.metis-race-wrap{--goal-c:${shapePolygon('circle', POINTS, { pad, decimals: 1 })};--goal-s:${shapePolygon('sunny', POINTS, { pad, decimals: 1 })}}`;
Astro.csp?.insertStyleHash(
  `sha256-${createHash('sha256').update(goalCss).digest('base64')}`,
);
---

<style is:inline set:html={goalCss} />

<article class={cn('metis', className)} aria-labelledby={headingId}>
  <div class="metis-main">
    <p class="metis-kicker">
      <span>{t('home.metis.kicker')}</span>
      <span aria-hidden="true">{t('home.metis.pass')}</span>
    </p>
    <h3 id={headingId} class="text-4xl">
      {project.title}
    </h3>
    <p class="mt-4 max-w-measure text-muted-foreground">
      {t('home.metis.lede')}
    </p>

    <div class="metis-race-wrap mt-8">
      <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
        <p class="text-sm text-muted-foreground">
          {t('home.metis.stepsLabel')}
        </p>
        <label class="switch metis-switch js-only">
          <input type="checkbox" role="switch" class="metis-auto" checked />
          <span class="track-ui" aria-hidden="true"></span>
          <span>{t('home.metis.auto')}</span>
        </label>
      </div>
      <div class="race mt-5" role="group" aria-label={t('home.metis.compare')}>
        <p class="race-axis" aria-hidden="true">
          <span></span>
          <span>{t('home.metis.before')}</span>
          <span class="is-after">{t('home.metis.after')}</span>
        </p>
        <ol class="race-steps">
          {steps.map((s) => (
            <li
              class:list={['race-step', s.after !== 'kept' && `is-${s.after}`]}
            >
              <span class="race-name">{t(`home.metis.step.${s.key}`)}</span>
              <span class="race-cell">
                <span
                  class:list={['race-dot', s.key === 'booked' && 'metis-goal']}
                  aria-hidden="true"
                />
                {s.key === 'search' && (
                  <span class="race-note is-wide">
                    {t('home.metis.searchBefore')}
                  </span>
                )}
              </span>
              <span class="race-cell is-after">
                <span
                  class:list={['race-dot', s.key === 'booked' && 'metis-goal']}
                  aria-hidden="true"
                />
                {s.key === 'search' && (
                  <span class="race-note is-wide">
                    {t('home.metis.searchAfter')}
                  </span>
                )}
                {s.after === 'gone' && (
                  <span class="race-note">{t('home.metis.stepNowGone')}</span>
                )}
                {s.after === 'background' && (
                  <span class="race-note">
                    {t('home.metis.stepNowBackground')}
                  </span>
                )}
              </span>
            </li>
          ))}
        </ol>
        <p class="race-times">
          <span></span>
          <span class="race-time">
            <span class="sr-only">{t('home.metis.before')} </span>
            {t('home.metis.timeBefore')}
          </span>
          <span class="race-time is-after">
            <span class="sr-only">{t('home.metis.after')} </span>
            {t('home.metis.timeAfter')}
          </span>
        </p>
        {['', 'is-after'].map((lane) => (
          <>
            <div class:list={['race-path race-line', lane]} aria-hidden="true">
              <i class="race-trail"></i>
            </div>
            <div
              class:list={['race-path race-flight', lane]}
              aria-hidden="true"
            >
              <svg viewBox="0 0 24 24" class="race-plane" fill="currentColor">
                <path d="M21 16v-2l-8-5V3.5a1.5 1.5 0 0 0-3 0V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5z"></path>
              </svg>
            </div>
          </>
        ))}
      </div>
    </div>

    <dl class="mt-8 grid gap-6 sm:grid-cols-2">
      <div>
        <dt class="text-sm text-muted-foreground">
          {t('home.metis.problemLabel')}
        </dt>
        <dd class="mt-1 text-sm">{t('home.metis.problem')}</dd>
      </div>
      <div>
        <dt class="text-sm text-muted-foreground">
          {t('home.metis.doneLabel')}
        </dt>
        <dd class="mt-1 text-sm">{t('home.metis.done')}</dd>
      </div>
    </dl>
  </div>

  <aside class="metis-stub" aria-label={t('home.metis.pass')}>
    <ul class="grid gap-6">
      {project.metrics.map((m) => (
        <li>
          <p class="text-5xl font-semibold tracking-tight text-ink">
            {m.value}
          </p>
          <p class="mt-1 text-sm text-muted-foreground">{m.label}</p>
        </li>
      ))}
    </ul>
    <ul class="mt-6 flex flex-wrap gap-1.5">
      {project.stack.map((s) => (
        <li class="chip">{s}</li>
      ))}
    </ul>
    <Button href={project.href} size="lg" class="mt-8 w-full justify-between">
      {t('home.metis.cta')}
      <span class="go-chip bg-background text-ink">
        <ArrowIcon class="size-4" />
      </span>
    </Button>
  </aside>
</article>

<script>
  // Auto-play the race while it is on screen. All motion is CSS keyed on data-race; this only sequences it:
  // 'armed' (paused at take-off), 'flying', 'resetting' (a spring rewind to empty), then a fresh take-off.
  // WCAG 2.2.2: the Auto-play switch stops it. Off, off screen or in a hidden tab, it rests (finished, or armed).
  const race = document.querySelector<HTMLElement>('.metis .race');
  const auto = document.querySelector<HTMLInputElement>('.metis-auto');
  if (race && auto && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const FLY = 7500; // the Before plane lands at 4.9 s, then the finished race holds
    const FADE = 600; // the rewind: dots deflate from Booked back to Search (0.24 s stagger + the spring's settle)
    let timer = 0;
    let inView = false;
    let playing = false;
    const restart = (state: string) => {
      race.dataset.race = '';
      void race.offsetWidth; // restart every animation from take-off
      race.dataset.race = state;
    };
    const play = () => {
      restart('flying');
      timer = window.setTimeout(() => {
        race.dataset.race = 'resetting';
        timer = window.setTimeout(play, FADE);
      }, FLY);
    };
    const update = () => {
      const go = auto.checked && inView && !document.hidden;
      if (go === playing) return;
      playing = go;
      clearTimeout(timer);
      if (go && race.dataset.race === '') {
        race.dataset.race = 'resetting'; // Auto-play back on: rewind the finished race, then take off
        timer = window.setTimeout(play, FADE);
      } else if (go) play();
      else if (auto.checked) restart('armed');
      else race.dataset.race = '';
    };
    if (auto.checked) restart('armed');
    // Take off once most of the race is visible; rest only when it has fully left (no reset in plain sight).
    new IntersectionObserver(
      ([entry]) => {
        if (entry.intersectionRatio >= 0.75) inView = true;
        else if (!entry.isIntersecting) inView = false;
        update();
      },
      { threshold: [0, 0.75] },
    ).observe(race);
    auto.addEventListener('change', update);
    document.addEventListener('visibilitychange', update);
  }
</script>

<style>
  .metis {
    display: grid;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    overflow: clip;
    background: var(--background);
  }
  .metis-main {
    padding: clamp(1.25rem, 4vw, 2.5rem);
  }
  .metis-kicker {
    display: flex;
    justify-content: space-between;
    margin-block-end: 0.75rem;
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }
  .metis-stub {
    position: relative;
    padding: clamp(1.25rem, 4vw, 2.5rem);
    border-block-start: 2px dashed var(--border);
    background: var(--muted);
  }
  /* Boarding-pass notches where the stub tears off. */
  .metis-stub::before,
  .metis-stub::after {
    content: '';
    position: absolute;
    inset-block-start: -0.75rem;
    inline-size: 1.5rem;
    block-size: 1.5rem;
    border-radius: 50%;
    background: var(--background);
    border: 1px solid var(--border);
  }
  .metis-stub::before {
    inset-inline-start: -0.75rem;
  }
  .metis-stub::after {
    inset-inline-end: -0.75rem;
  }
  @media (min-width: 64rem) {
    .metis {
      grid-template-columns: minmax(0, 1fr) 22rem;
    }
    .metis-stub {
      border-block-start: 0;
      border-inline-start: 2px dashed var(--border);
    }
    .metis-stub::before,
    .metis-stub::after {
      inset-inline: auto;
      inset-inline-start: -0.75rem;
    }
    .metis-stub::before {
      inset-block-start: -0.75rem;
    }
    .metis-stub::after {
      inset-block-start: auto;
      inset-block-end: -0.75rem;
    }
  }

  /* Race grid. Narrow (default): steps are rows, the two lanes are columns. Wide: lanes are rows, steps columns. */
  .metis-race-wrap {
    container: race / inline-size;
  }
  .race {
    --dot: 0.875rem;
    --slot: 1.25rem; /* the dot's line box; lane labels and times share it, so the path runs through every centre */
    --row: 2.75rem;
    --pre: 0.4s;
    --d-before: 4.5s;
    --d-after: 1.5s; /* 3:1, as about 3 min against about 1 min */
    /* Flight path: eases out of the first stop and into the last, cruises in between (--at below is its inverse). */
    --cruise: linear(0, 0.0139 5%, 0.0556 10%, 0.9444 90%, 0.9861 95%, 1);
    --clear: 0.08; /* a dot pops once the plane's disc has cleared it (share of the flight: ~17px of the path) */
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 0.9fr) minmax(0, 1.1fr);
    grid-template-rows: auto repeat(6, var(--row)) auto;
    column-gap: 0.75rem;
    font-size: var(--text-sm);
  }
  .race-axis,
  .race-times,
  .race-step {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    align-items: center;
  }
  .race-axis {
    grid-row: 1;
    padding-block-end: 0.5rem;
    color: var(--muted-foreground);
  }
  .race-times {
    grid-row: 8;
    padding-block-start: 0.5rem;
    color: var(--ink);
    white-space: nowrap;
  }
  .race-axis .is-after,
  .race-time.is-after {
    color: var(--ink);
    font-weight: 500;
  }
  .race-steps {
    display: grid;
    grid-column: 1 / -1;
    grid-row: 2 / 8;
    grid-template-columns: subgrid;
    grid-template-rows: subgrid;
  }
  .race-name {
    color: var(--ink);
  }
  .race-cell {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-inline-size: 0;
  }
  .race-dot {
    position: relative;
    z-index: 1;
    flex: none;
    inline-size: var(--dot);
    block-size: var(--dot);
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--background);
  }
  .race-dot::after {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: inherit;
    background: var(--ink);
  }
  /* Booked: an ink outline (the element) round a hole (::before) and a yellow fill (::after), one size up from the
     dots and centred on the same line. All three share the clip-path (--goal-c / --goal-s, generated above). */
  .race-dot.metis-goal {
    inline-size: var(--slot);
    block-size: var(--slot);
    margin-inline-start: calc((var(--dot) - var(--slot)) / 2);
    border: 0;
    border-radius: 0;
    background: var(--ink);
    clip-path: var(--goal-s);
  }
  .race-dot.metis-goal::before,
  .race-dot.metis-goal::after {
    content: '';
    position: absolute;
    inset: 2px;
    clip-path: var(--goal-s);
  }
  .race-dot.metis-goal::before {
    background: var(--background);
  }
  .race-dot.metis-goal::after {
    background: var(--brand);
  }
  /* After: the removed steps keep their slot (the line runs straight through), Ancillaries no longer blocks. */
  .race-step.is-gone .is-after .race-dot {
    visibility: hidden;
  }
  .race-step.is-background .is-after .race-dot {
    border-style: dashed;
  }
  .race-step.is-background .is-after .race-dot::after {
    content: none;
  }
  .race-note {
    font-size: var(--text-xs);
    line-height: 1.35;
    color: var(--muted-foreground);
  }
  .race-note.is-wide {
    display: none;
  }

  /* Paths: the line (under the dots) and the flight (over them), from the first dot's centre to the last. */
  .race-path {
    position: absolute;
    grid-row: 2 / 8;
    grid-column: 2;
    inset-block: calc(var(--row) / 2);
    inset-inline-start: calc(var(--dot) / 2 - 1px);
    inline-size: 2px;
  }
  .race-path.is-after {
    grid-column: 3;
  }
  .race-path:dir(rtl) {
    scale: -1 1;
  }
  .race-line {
    background: var(--border);
  }
  .race-trail {
    position: absolute;
    inset: 0;
    background: var(--ink);
    transform-origin: 50% 0;
  }
  .race-flight {
    z-index: 2;
    container-type: size;
  }
  .race-plane {
    position: absolute;
    top: calc(var(--slot) / -2);
    left: calc(1px - var(--slot) / 2);
    inline-size: var(--slot);
    block-size: var(--slot);
    padding: 0.125rem;
    border-radius: 50%;
    /* A clean token over the dots it passes; they pop once it has cleared them. */
    background: var(--background);
    color: var(--ink);
    --heading: 180deg;
    rotate: var(--heading);
    opacity: 0;
  }

  /* Booked only needs its label, so its column is 0.6fr and the times sit close to the finish. */
  @container race (min-width: 36rem) {
    .race {
      --clear: 0.045; /* ~17px of the shortest wide path (36rem container) */
      grid-template-columns:
        auto repeat(5, minmax(0, 1fr)) minmax(0, 0.6fr)
        auto;
      grid-template-rows: repeat(3, auto);
      column-gap: 0;
      row-gap: 1rem;
    }
    .race-axis,
    .race-times,
    .race-step {
      grid-column: auto;
      grid-row: 1 / -1;
      grid-template-columns: none;
      grid-template-rows: subgrid;
      align-items: start;
      line-height: var(--slot);
    }
    .race-axis {
      grid-column: 1;
      padding-block-end: 0;
      padding-inline-end: 1.5rem;
    }
    .race-times {
      grid-column: 8;
      padding-block-start: 0;
      padding-inline-start: 1rem;
    }
    .race-steps {
      grid-column: 2 / 8;
      grid-row: 1 / -1;
    }
    .race-name {
      padding-inline-end: 0.5rem;
      font-size: var(--text-xs);
    }
    .race-cell {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.375rem;
      padding-inline-end: 0.75rem;
    }
    .race-dot {
      margin-block: calc((var(--slot) - var(--dot)) / 2);
    }
    .race-dot.metis-goal {
      margin-block: 0;
    }
    .race-note.is-wide {
      display: block;
    }
    .race-path {
      grid-row: 2;
      grid-column: 2 / 8;
      inset-block: calc(var(--slot) / 2 - 1px) auto;
      block-size: 2px;
      inset-inline: calc(var(--dot) / 2) calc(100% * 0.6 / 5.6 - var(--dot) / 2);
      inline-size: auto;
    }
    .race-path.is-after {
      grid-row: 3;
      grid-column: 2 / 8;
    }
    .race-trail {
      transform-origin: 0 50%;
    }
    .race-plane {
      top: calc(1px - var(--slot) / 2);
      left: calc(var(--slot) / -2);
      --heading: 90deg;
    }
  }

  /* The race, on the M3 Expressive springs. Both planes pop in on the bouncy spring, nose up, and settle onto their
     heading (overshoot on scale and rotation only), then cruise their lane on --cruise (--d: 3:1; position never
     overshoots). The trail draws behind each plane; every dot pops on the bouncy spring once its plane has cleared it
     (--at: when --cruise reaches that stop, plus --clear). On touchdown the plane shrinks into Booked, which spins and
     springs from a circle into the "sunny" badge; each time turns ink as its plane lands. Animations fill backwards
     only, so the finished race is also the end of every flight. 'resetting' rewinds from there on springs: the trails
     retract, the dots deflate from Booked back to Search and the badge turns back into a circle. */
  @keyframes race-pop {
    from {
      scale: 0;
    }
  }
  @keyframes race-trail-y {
    from {
      scale: 1 0;
    }
  }
  @keyframes race-trail-x {
    from {
      scale: 0 1;
    }
  }
  @keyframes race-fly-y {
    to {
      translate: 0 100cqh;
    }
  }
  @keyframes race-fly-x {
    to {
      translate: 100cqw 0;
    }
  }
  @keyframes race-appear {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes race-takeoff {
    from {
      scale: 0.4;
      rotate: calc(var(--heading) - 40deg);
    }
  }
  @keyframes race-touchdown {
    from {
      opacity: 1;
      scale: 1;
    }
    to {
      opacity: 0;
      scale: 0.3;
    }
  }
  @keyframes race-goal {
    from {
      clip-path: var(--goal-c);
      rotate: -72deg;
    }
  }
  @keyframes race-goal-shape {
    from {
      clip-path: var(--goal-c);
    }
  }
  @keyframes race-goal-fill {
    from {
      clip-path: var(--goal-c);
      scale: 0;
    }
  }
  @keyframes race-arrive {
    from {
      color: var(--muted-foreground);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .race-step:nth-child(2) {
      --at: 0.23;
    }
    .race-step:nth-child(3) {
      --at: 0.41;
    }
    .race-step:nth-child(4) {
      --at: 0.59;
    }
    .race-step:nth-child(5) {
      --at: 0.77;
    }
    .race-step:nth-child(6) {
      --at: 1;
    }
    .race-cell,
    .race-path,
    .race-time {
      --d: var(--d-before);
    }
    .race-cell.is-after,
    .race-path.is-after,
    .race-time.is-after {
      --d: var(--d-after);
    }
    .race:is([data-race='armed'], [data-race='flying']) .race-dot::after {
      animation: race-pop var(--dur-spring-bouncy) var(--ease-spring-bouncy)
        calc(var(--pre) + var(--d) * (var(--at, 0) + var(--clear))) backwards;
    }
    /* Booked opens just before touchdown, so the plane sinks into a growing badge. */
    .race:is([data-race='armed'], [data-race='flying']) .metis-goal {
      --land: calc(var(--pre) + var(--d) - 0.15s);
      animation: race-goal var(--dur-spring-bouncy) var(--ease-spring-bouncy)
        var(--land) backwards;
    }
    .race:is([data-race='armed'], [data-race='flying']) .metis-goal::before {
      animation: race-goal-shape var(--dur-spring-bouncy)
        var(--ease-spring-bouncy) var(--land) backwards;
    }
    .race:is([data-race='armed'], [data-race='flying'])
      .race-dot.metis-goal::after {
      animation: race-goal-fill var(--dur-spring-bouncy)
        var(--ease-spring-bouncy) var(--land) backwards;
    }
    .race:is([data-race='armed'], [data-race='flying']) .race-trail {
      animation: race-trail-y var(--d) var(--cruise) var(--pre) backwards;
    }
    /* Touchdown is last in the list, so once it starts it beats the held opacity and scale. */
    .race:is([data-race='armed'], [data-race='flying']) .race-plane {
      animation:
        race-fly-y var(--d) var(--cruise) var(--pre) backwards,
        race-appear var(--dur-effect) var(--ease-effect) var(--pre) both,
        race-takeoff var(--dur-spring-bouncy) var(--ease-spring-bouncy)
          var(--pre) backwards,
        race-touchdown 0.25s linear calc(var(--pre) + var(--d) - 0.25s) forwards;
    }
    .race:is([data-race='armed'], [data-race='flying']) .race-time {
