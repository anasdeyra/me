---
// Home section 4: the engagement types as a list split by hairlines (heading left, rows right). Each row has a typical
// timeline and its own "Ask about this" WhatsApp link (prefilled with the engagement). How quotes work sits under the
// list, because that is the next question after choosing an engagement.
import SectionHeading from '@/components/site/SectionHeading.astro';
import Section from '@/components/site/Section.astro';
import { t } from '@/i18n';
import { whatsappHref, whatsappServicePrefill } from '@/lib/contact';
import { getHome, getSettings } from '@/lib/content';

const [home, settings] = await Promise.all([getHome(), getSettings()]);
---

<Section id="services" labelledby="services-title">
  <SectionHeading
    id="services-title"
    class="reveal lg:sticky lg:top-24 lg:col-span-4 lg:self-start"
  >
    {t('home.services.title')}
  </SectionHeading>

  <div class="col-span-12 lg:col-span-7 lg:col-start-6">
    <ol>
      {home.services.map((service, i) => (
        <li class="reveal grid gap-x-gutter gap-y-5 border-t border-border py-8 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]">
          <div>
            <p
              class="mb-2 text-sm font-medium text-muted-foreground tabular-nums"
              aria-hidden="true"
            >
              {String(i + 1).padStart(2, '0')}
            </p>
            <h3 class="text-xl">{service.title}</h3>
            {service.timeline && (
              <p class="mt-2 text-sm text-muted-foreground">
                {t('home.services.timeline')}: <span class="text-ink">{service.timeline}</span>
              </p>
            )}
            <p class="mt-4">
              <a
                href={whatsappHref(
                  settings.whatsappNumber,
                  whatsappServicePrefill(service.title),
                )}
                class="link text-sm"
                target="_blank"
                rel="noopener noreferrer"
                data-track="contact_whatsapp"
                data-track-location="services"
              >
                {t('home.services.ask')}
                <span class="sr-only"> {t('a11y.newTab')}</span>
              </a>
            </p>
          </div>
          <div class="space-y-5">
            <div>
              <p class="text-sm font-medium text-muted-foreground">
                {t('home.services.forWho')}
              </p>
              <p class="mt-1">{service.forWho}</p>
            </div>
            <div>
              <p class="text-sm font-medium text-muted-foreground">
                {t('home.services.youGet')}
              </p>
              <ul class="mt-1 space-y-1">
                {service.deliverables.map((d) => (
                  <li>{d}</li>
                ))}
              </ul>
            </div>
          </div>
        </li>
      ))}
    </ol>
    {home.designNote && <p class="mt-8 text-lg text-ink">{home.designNote}</p>}
    <div class="mt-12 border-t border-border pt-8">
      <h3 class="text-xl">{t('home.process.quotes')}</h3>
      <p class="mt-3 max-w-measure">{home.quoteProcess}</p>
    </div>
  </div>
</Section>
