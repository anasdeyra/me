---
// Five star glyphs, `rating` rounded to whole stars. Decorative: pair it with text for the rating.
interface Props {
  rating: number;
  class?: string;
}

const { rating, class: className } = Astro.props;
const filled = Math.max(0, Math.min(5, Math.round(rating)));
const d =
  'm12 2.5 2.94 6.2 6.56.8-4.84 4.55 1.28 6.7L12 17.5l-5.94 3.25 1.28-6.7L2.5 9.5l6.56-.8z';
---

<svg
  viewBox="0 0 120 24"
  class={className ?? 'h-4 w-auto'}
  aria-hidden="true"
  focusable="false"
>
  {[0, 1, 2, 3, 4].map((i) => (
    <path
      d={d}
      transform={`translate(${i * 24} 0)`}
      fill={i < filled ? 'currentColor' : 'none'}
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linejoin="round"
    ></path>
  ))}
</svg>
