---
// Clients world map: a build-time dot grid (Natural Earth land, see src/lib/land-mask.ts), arcs from the home
// city to each client country, and a visible country list. The SVG is decorative; the wrapper is role="img" with a
// label that names the countries, and the list below is the real text. In the `proof` variant the countries that
// have a review are radios (one native group: Tab in, arrows to move) and the matching card shows in a panel beside
// the map. Zero JS: selection is `:checked` + `:has()` (per-country rules come from ClientsMapStyle). The map markers
// are labels for the same radios, so a click selects; the chips below are the touch/keyboard-first equivalent.
import TestimonialCard from '@/components/proof/TestimonialCard.astro';
import { t } from '@/i18n';
import { getClients, getSettings } from '@/lib/content';
import { countryName, utcOffset } from '@/lib/place';
import type { ProofPlace } from '@/lib/proof';
import { buildWorldMap } from '@/lib/world-map';

interface Props {
  variant?: 'full' | 'compact' | 'proof';
  /** `proof` only: countries that have a review, and the one selected on load. */
  places?: ProofPlace[];
  defaultIso?: string;
  /** Id prefix for the SVG defs; must differ between map instances on one page (defaults to the variant). */
  uid?: string;
}

const {
  variant = 'full',
  uid = variant,
  places = [],
  defaultIso = places[0]?.iso,
} = Astro.props;
const [settings, clientEntries] = await Promise.all([
  getSettings(),
  getClients(),
]);
const { city, countryCode, latitude, longitude, timezone } = settings.location;
const clients = clientEntries
  .map((c) => ({
    iso: c.entry.isoCode,
    name: countryName(c.entry.isoCode),
    latitude: c.entry.latitude,
    longitude: c.entry.longitude,
  }))
  .sort((a, b) => a.name.localeCompare(b.name));
const map = buildWorldMap({
  home: { latitude, longitude, countryCode },
  clients,
});
const label = t('clients.label', {
  count: clients.length,
  countries: clients.map((c) => c.name).join(', '),
  city,
});
const landId = `land-${uid}`;
const byIso = new Map(map.arcs.map((a) => [a.iso, a.d]));
const markerByIso = new Map(map.markers.map((m) => [m.iso, m]));
const away = clients.filter((c) => markerByIso.has(c.iso));
const interactive = variant === 'proof' && places.length > 0;
const placed = new Map(places.map((p) => [p.iso, p]));

// Per-client hover/stagger rules live in ClientsMapStyle.astro (placed in the page head by the page).
---

<div
  class:list={[
    'cmap',
    interactive && 'lg:grid lg:grid-cols-12 lg:gap-x-gutter',
  ]}
  data-variant={variant}
>
  <div class={interactive ? 'min-w-0 lg:col-span-8' : undefined}>
    <div class="stage relative" data-glow>
      <div class="frame relative" role="img" aria-label={label}>
        <svg
          viewBox={map.viewBox}
          class="block h-auto w-full"
          aria-hidden="true"
          focusable="false"
        >
          <defs>
            <path id={landId} d={map.land}></path>
            <radialGradient id={`cglow-${uid}`}>
              <stop offset="0" class="gs0"></stop>
              <stop offset="1" class="gs1"></stop>
            </radialGradient>
            {away.map((c) => {
              const m = markerByIso.get(c.iso)!;
              return (
                <linearGradient
                  id={`cg-${uid}-${c.iso}`}
                  gradientUnits="userSpaceOnUse"
                  x1={map.home.x}
                  y1={map.home.y}
                  x2={m.x}
                  y2={m.y}
                >
                  <stop offset="0" class="gf"></stop>
                  <stop offset="1" class="gt"></stop>
                </linearGradient>
              );
            })}
          </defs>
          <use
            href={`#${landId}`}
            class="land"
            stroke-width={map.pitch * 0.6}
            stroke-dasharray={`0 ${map.pitch}`}
          ></use>
          <g>
            <circle
              class="base-glow"
              cx={map.home.x}
              cy={map.home.y}
              r="26"
              fill={`url(#cglow-${uid})`}
            ></circle>
            {clients.map((c) => {
              const m = markerByIso.get(c.iso);
              const d = byIso.get(c.iso);
              return m ? (
                <g class={`cl m-${c.iso}`}>
                  <path
                    class="arc"
                    d={d}
                    pathLength="1"
                    stroke={`url(#cg-${uid}-${c.iso})`}
                  ></path>
                  <path class="spark" d={d} pathLength="1"></path>
                  <circle class="ripple" cx={m.x} cy={m.y} r="4"></circle>
                  <circle class="core" cx={m.x} cy={m.y} r="4"></circle>
                  <circle class="hit" cx={m.x} cy={m.y} r="14"></circle>
                </g>
              ) : (
                <g class={`cl m-${c.iso}`}></g>
              );
            })}
          </g>
          <g>
            <circle
              class="base-ring"
              cx={map.home.x}
              cy={map.home.y}
              r="10"
            ></circle>
            <circle
              class="base-halo"
              cx={map.home.x}
              cy={map.home.y}
              r="5"
            ></circle>
            <text
              class="label"
              x={map.home.x}
              y={map.home.y + 24}
              text-anchor="middle"
            >
              {t('clients.base')}
            </text>
          </g>
          <g>
            {away.map((c) => {
              const m = markerByIso.get(c.iso)!;
              return (
                <text
                  class={`tip m-${c.iso}`}
                  x={m.x}
                  y={m.y - 13}
                  text-anchor="middle"
                >
                  {c.name}
                </text>
              );
            })}
          </g>
        </svg>
        <svg
          viewBox={map.viewBox}
          class="lit"
          aria-hidden="true"
          focusable="false"
        >
          <use
            href={`#${landId}`}
            class="land-lit"
            stroke-width={map.pitch * 0.9}
            stroke-dasharray={`0 ${map.pitch}`}
          ></use>
        </svg>
        <svg
          viewBox={map.viewBox}
          class="over"
          aria-hidden="true"
          focusable="false"
        >
          <text
            class="label"
            x={map.home.x}
            y={map.home.y + 24}
            text-anchor="middle"
          >
            {t('clients.base')}
          </text>
        </svg>
      </div>
      {interactive && (
        <div class="markers" aria-hidden="true">
          {places.map((p) => (
            <label for={`pc-${p.iso}`} class={`mk m-${p.iso}`}></label>
          ))}
        </div>
      )}
    </div>

    <p class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-muted-foreground">
      <span class="inline-flex items-center gap-2">
        <svg
          width="12"
          height="12"
          viewBox="0 0 12 12"
          aria-hidden="true"
          focusable="false"
        >
          <circle cx="6" cy="6" r="4" class="core"></circle>
        </svg>
        {t('clients.legend.client')}
      </span>
      <span class="inline-flex items-center gap-2">
        <svg
          width="20"
          height="20"
          viewBox="0 0 20 20"
          aria-hidden="true"
          focusable="false"
        >
          <circle cx="10" cy="10" r="8.5" class="base-ring"></circle>
          <circle cx="10" cy="10" r="5" class="base-halo"></circle>
        </svg>
        {t('clients.legend.base', { city })}
      </span>
    </p>

    {interactive ? (
      <fieldset class="chips mt-8">
        <legend class="hint text-sm text-muted-foreground">
          {t('proof.pick')}
        </legend>
        <ul class="mt-3 flex flex-wrap gap-x-3 gap-y-3">
          {clients.map((c) =>
            placed.has(c.iso) ? (
              <li
                class={`m-${c.iso}`}
                data-home={c.iso === countryCode ? '' : undefined}
              >
                <input
                  type="radio"
                  name="proof-country"
                  id={`pc-${c.iso}`}
                  checked={c.iso === defaultIso}
                  aria-labelledby={`pl-${c.iso}`}
                  aria-describedby={`card-${c.iso}`}
                />
                <label id={`pl-${c.iso}`} for={`pc-${c.iso}`}>
                  {c.name}
                </label>
              </li>
            ) : (
              <li
                class={`plain m-${c.iso}`}
                data-home={c.iso === countryCode ? '' : undefined}
              >
                {c.name}
              </li>
            ),
          )}
        </ul>
      </fieldset>
    ) : (
      <ul
        aria-label={t('clients.listLabel')}
        class="names mt-8 flex flex-wrap gap-x-8 gap-y-3 text-lg text-ink"
      >
        {clients.map((c) => (
          <li
            class={`m-${c.iso}`}
            data-home={c.iso === countryCode ? '' : undefined}
          >
            {c.name}
          </li>
        ))}
      </ul>
    )}
    {variant !== 'compact' && (
      <p class="mt-8 max-w-measure text-muted-foreground">
        {t('clients.caption', { city, offset: utcOffset(timezone) })}
      </p>
    )}
  </div>
  {interactive && (
    <div class="panels mt-12 lg:col-span-4 lg:mt-0">
      {places.map((p) => (
        <div class={`panel m-${p.iso}`} id={`card-${p.iso}`}>
          <ul class="grid gap-10">
            {p.testimonials.map((item) => (
              <li>
                <TestimonialCard testimonial={item} country={p.name} />
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  )}
</div>

<style>
  /* Colour: land is blue-tinted slate, arcs are the brand gradient (Tunis deep -> destination light), the only warm
     touches are the amber sparks and the Tunis glow (--spark). All decorative; the list below is the real content. */
  .land {
    stroke: var(--muted-foreground);
    stroke-opacity: 0.4;
    stroke-linecap: round;
    fill: none;
  }
  .gf {
    stop-color: var(--map-from);
  }
  .gt {
    stop-color: var(--map-to);
  }
  .gs0 {
    stop-color: var(--spark);
    stop-opacity: 0.55;
  }
  .gs1 {
    stop-color: var(--spark);
    stop-opacity: 0;
  }
  .arc {
    fill: none;
    stroke-opacity: 0.85;
    stroke-width: 1.2;
    stroke-linecap: round;
  }
  .spark {
    fill: none;
    stroke: var(--spark);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-dasharray: 0.1 2;
    stroke-dashoffset: 0.1;
    pointer-events: none;
  }
  .core {
    fill: var(--brand);
    transform-box: fill-box;
    transform-origin: center;
    transition:
      scale var(--dur-2) var(--ease-out),
      opacity var(--dur-1);
  }
  .ripple {
    fill: none;
    stroke: var(--brand-hot);
    stroke-width: 1;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }
  .hit,
  .lit,
  .over,
  .tip {
    display: none;
  }
  .base-halo {
    fill: var(--brand);
    stroke: var(--background);
    stroke-width: 2.5;
  }
  .base-ring {
    fill: none;
    stroke: var(--brand);
    stroke-width: 1.5;
    transform-box: fill-box;
    transform-origin: center;
  }
  .label,
  .tip {
    fill: var(--ink);
    font: 600 9px var(--font-sans, sans-serif);
    letter-spacing: 0;
    paint-order: stroke;
    stroke: var(--background);
    stroke-width: 3px;
    stroke-linejoin: round;
  }
  .label {
    display: none;
    font-weight: 700;
  }
  @media (max-width: 639px) {
    .cmap .land {
      stroke-width: 3.6;
      stroke-opacity: 0.55;
    }
    .cmap .core,
    .cmap .ripple {
      r: 6.5;
    }
    .cmap .arc {
      stroke-width: 2;
    }
    .cmap .spark {
      stroke-width: 3.6;
    }
    .cmap .base-halo {
      r: 8;
    }
    .cmap .base-ring {
      r: 14;
      stroke-width: 2.5;
    }
    .cmap .base-glow {
      r: 36;
    }
  }
  @media (min-width: 768px) {
    .label {
      display: block;
    }
  }

  /* Hover (mouse only): list item or marker lights its arc and dims the rest; labels show on markers. */
  li {
    transition: color var(--dur-1);
  }
  @media (hover: hover) {
    .cmap:has(li:hover) .arc,
    .cmap:has(.cl:hover) .arc,
    .cmap:has(.mk:hover) .arc {
      stroke-opacity: 0.15;
    }
    .cmap:has(li:hover) .cl .core,
    .cmap:has(.cl:hover) .cl .core,
    .cmap:has(.mk:hover) .cl .core {
      opacity: 0.55;
    }
    .cmap:has(li[data-home]:hover) .base-ring {
      stroke-width: 3;
    }
    .names li:hover,
    .plain:hover {
      color: var(--link-hover);
      text-decoration: underline;
      text-underline-offset: 0.25em;
    }
    .tip {
      display: block;
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--dur-1);
    }
    .cl > * {
      pointer-events: none;
    }
    .cl > .hit {
      display: block;
      fill: transparent;
      pointer-events: all;
    }
    .cmap .tip {
      stroke-width: 4.5px;
    }
  }

  /* Land flashlight: a second dot layer in the hot brand blue, revealed under the pointer (fine pointers only).
     --mx/--my come from src/scripts/pointer.ts on the [data-glow] frame; the layer is invisible until it runs. */
  .land-lit {
    stroke: var(--brand-hot);
    stroke-linecap: round;
    fill: none;
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .lit {
      display: block;
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      opacity: 0;
      transition: opacity var(--dur-2);
      mask-image: radial-gradient(
        circle 9rem at var(--mx, -99px) var(--my, -99px),
        #000,
        transparent
      );
    }
    .stage[style*='--mx'] .lit {
      opacity: 0.9;
    }
    /* The base label is repeated above the flashlight layer so its halo keeps it legible over lit dots. */
    .over {
      display: block;
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
    }
  }

  /* Motion. Everything below is off under reduced motion (the map is then fully drawn and still). */
  @media (prefers-reduced-motion: no-preference) {
    @keyframes draw {
      from {
        stroke-dashoffset: 1;
      }
      to {
        stroke-dashoffset: 0;
      }
    }
    @keyframes pop {
      from {
        transform: scale(0);
      }
      65% {
        transform: scale(1.35);
      }
      to {
        transform: scale(1);
      }
    }
    @keyframes ripple {
      from {
        transform: scale(1);
        opacity: 0;
      }
      15% {
        opacity: 0.8;
      }
      to {
        transform: scale(3.4);
        opacity: 0;
      }
    }
    @keyframes travel {
      from {
        stroke-dashoffset: 0.1;
      }
      to {
        stroke-dashoffset: -1;
      }
    }
    @keyframes breathe {
      50% {
        transform: scale(1.4);
        stroke-opacity: 0.4;
      }
    }
    @keyframes bloom {
      from {
        transform: scale(0.4);
        opacity: 0;
      }
    }

    /* Entry sequence, scroll-linked (home map): arcs draw, markers pop, ripples expand, the amber light travels.
       One view timeline on the frame, a per-client slot --a (percent of the cover range, see generated rules).
       No support or no-preference missing = the static, fully drawn map. */
    @supports (animation-timeline: view()) {
      .cmap:not([data-variant='compact']) .frame {
        view-timeline: --cm block;
      }
      .cmap:not([data-variant='compact']) .cl .arc {
        stroke-dasharray: 1;
        animation-name: draw;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --cm;
        animation-range: cover calc(var(--a) * 1%) cover
          calc(var(--a) * 1% + 16%);
      }
      .cmap:not([data-variant='compact']) .cl .core {
        animation-name: pop;
        animation-timing-function: ease-out;
        animation-fill-mode: both;
        animation-timeline: --cm;
        animation-range: cover calc(var(--a) * 1% + 12%) cover
          calc(var(--a) * 1% + 18%);
      }
      .cmap:not([data-variant='compact']) .cl .ripple {
        animation-name: ripple;
        animation-timing-function: ease-out;
        animation-fill-mode: both;
        animation-timeline: --cm;
        animation-range: cover calc(var(--a) * 1% + 15%) cover
          calc(var(--a) * 1% + 26%);
      }
      .cmap:not([data-variant='compact']) .cl .spark {
        animation-name: travel;
        animation-timing-function: ease-in-out;
        animation-fill-mode: both;
        animation-timeline: --cm;
        animation-range: cover calc(var(--a) * 1% + 15%) cover
          calc(var(--a) * 1% + 34%);
      }
      .cmap:not([data-variant='compact']) .base-glow {
        transform-box: fill-box;
        transform-origin: center;
        animation-name: bloom;
        animation-timing-function: ease-out;
        animation-fill-mode: both;
        animation-timeline: --cm;
        animation-range: cover 0% cover 10%;
      }
    }

    /* Hover loops: user-initiated and bounded (2 passes, WCAG 2.2.2), mouse only. */
    @media (hover: hover) {
      .cmap .stage:hover:not(:has(.cl:hover, .mk:hover)) .cl .spark {
        animation: travel 1.8s var(--ease-in-out) 2 both;
        animation-timeline: auto;
        animation-delay: calc(var(--k, 0) * 140ms);
      }
      .cmap .stage:hover:not(:has(.cl:hover, .mk:hover)) .cl .ripple {
        animation: ripple 1.8s var(--ease-out) 2 both;
        animation-timeline: auto;
        animation-delay: calc(var(--k, 0) * 140ms);
      }
      .cmap .stage:hover:not(:has(.cl:hover, .mk:hover)) .base-ring,
      .cmap:has(li[data-home]:hover) .base-ring {
        animation: breathe 2.2s var(--ease-in-out) 3;
      }
    }
  }
  /* Proof variant: radios + :has() (the /work filter pattern). Without :has() support every card is listed in
     reading order and the markers/chips are plain; with it, one panel shows at a time in a single grid cell, so the
     column is always as tall as the tallest card and switching never shifts the page. Per-country selected rules
     (panel, ring, arc, label, marker position) are generated in ClientsMapStyle. */
  .panels {
    display: grid;
    gap: 2.5rem;
  }
  .markers {
    display: none;
  }
  .hint {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .chips {
    margin: 0;
    padding: 0;
    border: 0;
    min-inline-size: 0;
  }
  .chips input {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    opacity: 0;
    pointer-events: none;
  }
  .chips li {
    position: relative;
  }
  .chips label,
  .plain {
    display: inline-flex;
    min-block-size: 2.5rem;
    align-items: center;
    padding-inline: 1rem;
    font-size: var(--text-sm);
  }
  .chips label {
    cursor: pointer;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    color: var(--ink);
  }
  .plain {
    color: var(--muted-foreground);
    transition: color var(--dur-1);
  }
  @supports selector(:has(*)) {
    .hint {
      position: static;
      inline-size: auto;
      block-size: auto;
      overflow: visible;
      clip-path: none;
      white-space: normal;
    }
    .markers {
      display: block;
      position: absolute;
      inset: 0;
      pointer-events: none;
    }
    .mk {
      position: absolute;
      inline-size: 1.75rem;
      block-size: 1.75rem;
      translate: -50% -50%;
      border-radius: 50%;
      cursor: pointer;
      pointer-events: auto;
    }
    .panel {
      grid-area: 1 / 1;
      visibility: hidden;
      opacity: 0;
    }
    .chips input:checked + label {
      background-color: var(--primary);
      border-color: var(--primary);
      color: var(--primary-foreground);
    }
    .chips input:focus-visible + label {
      outline: 2px solid var(--ring);
      outline-offset: 2px;
    }
    .cmap:has(.chips input:checked) .arc {
      stroke-opacity: 0.35;
    }
    @media (hover: hover) {
      .chips label:hover {
        background-color: var(--muted);
      }
      .chips input:checked + label:hover {
        background-color: var(--primary-hover);
      }
      .mk:hover {
        outline: 2px solid var(--brand-hot);
      }
    }
    @media (prefers-reduced-motion: no-preference) {
      .panel {
        transition:
          opacity var(--dur-2) var(--ease-out),
          visibility 0s linear var(--dur-2);
      }
    }
  }
  @media print {
    .panels {
      display: block;
    }
    .panel {
      visibility: visible !important;
      opacity: 1 !important;
      margin-block-end: 2rem;
    }
    .markers {
      display: none !important;
    }
  }
  @media (forced-colors: active) {
    .chips input:checked + label {
      forced-color-adjust: none;
      background-color: Highlight;
      border-color: Highlight;
      color: HighlightText;
    }
    .land {
      stroke: GrayText;
      stroke-opacity: 1;
    }
    .arc,
    .ripple,
    .base-ring {
      stroke: CanvasText;
      stroke-opacity: 1;
    }
    .core,
    .base-halo {
      fill: CanvasText;
    }
    .label,
    .tip {
      fill: CanvasText;
      stroke: Canvas;
    }
    .spark,
    .lit,
    .base-glow {
      display: none !important;
    }
  }
</style>
