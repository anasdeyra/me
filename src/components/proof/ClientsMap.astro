---
// Clients world map: a build-time dot grid of the land (Natural Earth, see src/lib/land-mask.ts) and nothing else: no
// markers, arcs or home base (owner review 2026-11-18). The SVG is decorative; the wrapper is role="img" with a label
// that names the countries. `full` and `compact` add the visible country list (the real text); `bare` is the map
// alone, with a default slot rendered inside the stage (after the map frame) for overlays such as the review loop
// (src/components/proof/ReviewLoop.astro). Under a fine pointer a second dot layer lights the land (pointer.ts).
import { getImage } from 'astro:assets';
import { t } from '@/i18n';
import { getClients, getSettings } from '@/lib/content';
import { countryName, utcOffset } from '@/lib/place';
import { getProofPlaces, testimonialPhoto } from '@/lib/proof';
import { buildWorldMap } from '@/lib/world-map';

interface Props {
  variant?: 'full' | 'compact' | 'bare';
  /** Id prefix for the SVG defs; must differ between map instances on one page (defaults to the variant). */
  uid?: string;
}

const { variant = 'full', uid = variant } = Astro.props;
const [settings, clientEntries] = await Promise.all([
  getSettings(),
  getClients(),
]);
const { city, timezone } = settings.location;
const names = clientEntries
  .map((c) => countryName(c.entry.isoCode))
  .sort((a, b) => a.localeCompare(b));
const map = buildWorldMap({
  places: clientEntries.map((c) => ({ iso: c.entry.isoCode, ...c.entry })),
});
// Avatars sit on each client country (not on `bare`, where the review loop draws its own). A country with a review
// shows that client's photo; any other country gets a generic person glyph. Positioned with SVG attributes (no style="").
const R = 7;
const { places } = variant === 'bare' ? { places: [] } : await getProofPlaces();
const photoByIso = new Map(
  await Promise.all(
    places.map(async (p) => {
      const src = p.testimonials.map(testimonialPhoto).find(Boolean);
      return [p.iso, src ? (await getImage({ src, width: 28, height: 28 })).src : undefined] as const;
    }),
  ),
);
const pins =
  variant === 'bare'
    ? []
    : map.points.map((pt) => ({ ...pt, photo: photoByIso.get(pt.iso) }));
const label = t('clients.label', {
  count: names.length,
  countries: names.join(', '),
});
const landId = `land-${uid}`;
---

<div class="cmap" data-variant={variant}>
  <div class="stage relative" data-pointer>
    <div class="frame relative" role="img" aria-label={label}>
      <svg
        viewBox={map.viewBox}
        class="block h-auto w-full"
        aria-hidden="true"
        focusable="false"
      >
        <defs>
          <path id={landId} d={map.land}></path>
        </defs>
        <use
          href={`#${landId}`}
          class="land"
          stroke-width={map.pitch * 0.6}
          stroke-dasharray={`0 ${map.pitch}`}
        ></use>
      </svg>
      <svg
        viewBox={map.viewBox}
        class="lit"
        aria-hidden="true"
        focusable="false"
      >
        <use
          href={`#${landId}`}
          class="land-lit"
          stroke-width={map.pitch * 0.9}
          stroke-dasharray={`0 ${map.pitch}`}
        ></use>
      </svg>
      {pins.length > 0 && (
        <svg viewBox={map.viewBox} class="pins" aria-hidden="true" focusable="false">
          <defs>
            {pins.map((p) => (
              <clipPath id={`pin-${uid}-${p.iso}`}>
                <circle cx={p.x} cy={p.y} r={R} />
              </clipPath>
            ))}
          </defs>
          {pins.map((p) =>
            p.photo ? (
              <>
                <image href={p.photo} x={p.x - R} y={p.y - R} width={R * 2} height={R * 2} preserveAspectRatio="xMidYMid slice" clip-path={`url(#pin-${uid}-${p.iso})`} />
                <circle class="pin-ring" cx={p.x} cy={p.y} r={R} />
              </>
            ) : (
              <>
                <circle class="pin-bg" cx={p.x} cy={p.y} r={R} />
                <path
                  class="pin-glyph"
                  transform={`translate(${p.x - R * 0.6} ${p.y - R * 0.6}) scale(${(R * 1.2) / 24})`}
                  d="M12 12.25a4.25 4.25 0 1 0 0-8.5 4.25 4.25 0 0 0 0 8.5Zm0 2.25c-4.1 0-7.5 2.1-7.5 5.25V21h15v-1.25c0-3.15-3.4-5.25-7.5-5.25Z"
                />
              </>
            ),
          )}
        </svg>
      )}
    </div>
    <slot />
  </div>

  {variant !== 'bare' && (
    <ul
      aria-label={t('clients.listLabel')}
      class="mt-8 flex flex-wrap gap-x-8 gap-y-3 text-lg text-ink"
    >
      {names.map((name) => (
        <li>{name}</li>
      ))}
    </ul>
  )}
  {variant === 'full' && (
    <p class="mt-8 max-w-measure text-muted-foreground">
      {t('clients.caption', { city, offset: utcOffset(timezone) })}
    </p>
  )}
</div>

<style>
  /* Land: grey dots (muted foreground). Decorative; the label and the list are the real content. */
  .land {
    stroke: var(--muted-foreground);
    stroke-opacity: 0.4;
    stroke-linecap: round;
    fill: none;
  }
  .lit {
    display: none;
  }
  .pins {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .pin-bg {
    fill: var(--muted);
  }
  .pin-glyph {
    fill: var(--muted-foreground);
  }
  .pin-ring,
  .pin-bg {
    stroke: var(--border);
    stroke-width: 0.8;
  }
  .pin-ring {
    fill: none;
  }
  @media (max-width: 639px) {
    .cmap .land {
      stroke-width: 3.6;
      stroke-opacity: 0.55;
    }
  }

  /* Land flashlight: a second dot layer in the yellow brand detail colour, revealed under the pointer (fine pointers only).
     --mx/--my come from src/scripts/pointer.ts on the [data-pointer] stage; the layer is invisible until it runs. */
  .land-lit {
    stroke: var(--brand);
    stroke-linecap: round;
    fill: none;
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .lit {
      display: block;
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      opacity: 0;
      transition: opacity var(--dur-2);
      mask-image: radial-gradient(
        circle 9rem at var(--mx, -99px) var(--my, -99px),
        #000,
        transparent
      );
    }
    .stage[style*='--mx'] .lit {
      opacity: 0.9;
    }
  }

  @media (forced-colors: active) {
    .land {
      stroke: GrayText;
      stroke-opacity: 1;
    }
    .lit {
      display: none !important;
    }
  }
</style>
