---
// Clients world map: a build-time dot grid of the land (Natural Earth, see src/lib/land-mask.ts) and nothing else: no
// markers, arcs or home base (owner review 2026-11-18). The SVG is decorative; the wrapper is role="img" with a label
// that names the countries. `full` and `compact` add the visible country list (the real text); `bare` is the map
// alone, with a default slot rendered inside the stage (after the map frame) for overlays such as the review loop
// (src/components/proof/ReviewLoop.astro). Under a fine pointer a second dot layer lights the land (pointer.ts).
import { t } from '@/i18n';
import { getClients, getSettings } from '@/lib/content';
import { countryName, utcOffset } from '@/lib/place';
import { buildWorldMap } from '@/lib/world-map';

interface Props {
  variant?: 'full' | 'compact' | 'bare';
  /** Id prefix for the SVG defs; must differ between map instances on one page (defaults to the variant). */
  uid?: string;
}

const { variant = 'full', uid = variant } = Astro.props;
const [settings, clientEntries] = await Promise.all([
  getSettings(),
  getClients(),
]);
const { city, timezone } = settings.location;
const names = clientEntries
  .map((c) => countryName(c.entry.isoCode))
  .sort((a, b) => a.localeCompare(b));
const map = buildWorldMap();
const label = t('clients.label', {
  count: names.length,
  countries: names.join(', '),
});
const landId = `land-${uid}`;
---

<div class="cmap" data-variant={variant}>
  <div class="stage relative" data-glow>
    <div class="frame relative" role="img" aria-label={label}>
      <svg
        viewBox={map.viewBox}
        class="block h-auto w-full"
        aria-hidden="true"
        focusable="false"
      >
        <defs>
          <path id={landId} d={map.land}></path>
        </defs>
        <use
          href={`#${landId}`}
          class="land"
          stroke-width={map.pitch * 0.6}
          stroke-dasharray={`0 ${map.pitch}`}
        ></use>
      </svg>
      <svg
        viewBox={map.viewBox}
        class="lit"
        aria-hidden="true"
        focusable="false"
      >
        <use
          href={`#${landId}`}
          class="land-lit"
          stroke-width={map.pitch * 0.9}
          stroke-dasharray={`0 ${map.pitch}`}
        ></use>
      </svg>
    </div>
    <slot />
  </div>

  {variant !== 'bare' && (
    <ul
      aria-label={t('clients.listLabel')}
      class="mt-8 flex flex-wrap gap-x-8 gap-y-3 text-lg text-ink"
    >
      {names.map((name) => (
        <li>{name}</li>
      ))}
    </ul>
  )}
  {variant === 'full' && (
    <p class="mt-8 max-w-measure text-muted-foreground">
      {t('clients.caption', { city, offset: utcOffset(timezone) })}
    </p>
  )}
</div>

<style>
  /* Land: blue-tinted slate dots. Decorative; the label and the list are the real content. */
  .land {
    stroke: var(--muted-foreground);
    stroke-opacity: 0.4;
    stroke-linecap: round;
    fill: none;
  }
  .lit {
    display: none;
  }
  @media (max-width: 639px) {
    .cmap .land {
      stroke-width: 3.6;
      stroke-opacity: 0.55;
    }
  }

  /* Land flashlight: a second dot layer in the hot brand blue, revealed under the pointer (fine pointers only).
     --mx/--my come from src/scripts/pointer.ts on the [data-glow] stage; the layer is invisible until it runs. */
  .land-lit {
    stroke: var(--brand-hot);
    stroke-linecap: round;
    fill: none;
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .lit {
      display: block;
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      opacity: 0;
      transition: opacity var(--dur-2);
      mask-image: radial-gradient(
        circle 9rem at var(--mx, -99px) var(--my, -99px),
        #000,
        transparent
      );
    }
    .stage[style*='--mx'] .lit {
      opacity: 0.9;
    }
  }

  @media (forced-colors: active) {
    .land {
      stroke: GrayText;
      stroke-opacity: 1;
    }
    .lit {
      display: none !important;
    }
  }
</style>
