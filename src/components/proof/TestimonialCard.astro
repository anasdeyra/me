---
// A testimonial as <figure><blockquote>: the quote, then the author's picture, name and role. Nothing else is shown
// (no project, rating, badge or source). Quote text is verbatim from the content (docs/ux-study.md 8b): `excerpt`
// swaps in the verbatim `excerpt` field only when the entry has one. Quote marks are CSS only.
import Avatar from '@/components/proof/Avatar.astro';
import { t } from '@/i18n';
import { briefQuote, type CaseStudy, type Testimonial } from '@/lib/proof';
import { cn } from '@/lib/utils';

interface Props {
  testimonial: Testimonial;
  /** The review's case study, when it is visible: linked under the author. */
  caseStudy?: CaseStudy;
  variant?: 'card' | 'pull';
  excerpt?: boolean;
  /** Id on the <figure>, so a control can point at it (aria-describedby). */
  id?: string;
  class?: string;
}

const {
  testimonial,
  variant = 'card',
  excerpt = false,
  caseStudy,
  id,
  class: className,
} = Astro.props;
const { entry } = testimonial;
const quote = excerpt ? briefQuote(testimonial) : entry.quote;
const pull = variant === 'pull';
---

<figure
  id={id}
  class={cn(
    'relative flex h-full flex-col gap-6',
    className,
  )}
>
  <blockquote class="flex-1">
    <p class={cn('quote text-ink', pull ? 'text-2xl font-medium' : 'text-lg')}>
      {quote}
    </p>
  </blockquote>
  <figcaption class="flex items-center gap-3 text-sm">
    <Avatar testimonial={testimonial} />
    <span class="grid">
      <span class="font-medium text-ink">
        {entry.author || t('testimonial.client')}
      </span>
      {entry.role && <span class="text-muted-foreground">{entry.role}</span>}
    </span>
  </figcaption>
  {caseStudy && (
    <a href={caseStudy.href} class="link text-sm">
      {t('proof.caseStudy', { title: caseStudy.title })}
    </a>
  )}
</figure>
