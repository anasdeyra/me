---
// A review author's picture: the co-located photo when there is one, else an initials monogram, or a neutral person
// glyph when the author is only "Upwork client" (initials would read as "UC"). Decorative (the name is always printed
// next to it), so the image has empty alt text and the fallback is aria-hidden.
import { Image } from 'astro:assets';
import { t } from '@/i18n';
import { initials, testimonialPhoto, type Testimonial } from '@/lib/proof';
import { cn } from '@/lib/utils';

interface Props {
  testimonial: Testimonial;
  /** sm 32px (review bubbles), md 40px (cards). */
  size?: 'sm' | 'md';
  class?: string;
}

const { testimonial, size = 'md', class: className } = Astro.props;
const photo = testimonialPhoto(testimonial);
const px = size === 'sm' ? 32 : 40;
const name = testimonial.entry.author || t('testimonial.client');
const generic = name === t('testimonial.client');
const box = cn(
  'shrink-0 rounded-full ring-1 ring-border',
  size === 'sm' ? 'size-8 text-xs' : 'size-10 text-sm',
  className,
);
---

{photo ? (
  <Image
    src={photo}
    alt=""
    width={px}
    height={px}
    densities={[1, 2]}
    class={cn(box, 'object-cover')}
    loading="lazy"
  />
) : (
  <span
    class={cn(
      box,
      'inline-grid place-items-center bg-muted leading-none font-semibold tracking-wide text-ink',
    )}
    aria-hidden="true"
  >
    {generic ? (
      <svg viewBox="0 0 24 24" class="size-[60%]" fill="currentColor" focusable="false">
        <path d="M12 12.25a4.25 4.25 0 1 0 0-8.5 4.25 4.25 0 0 0 0 8.5Zm0 2.25c-4.1 0-7.5 2.1-7.5 5.25V21h15v-1.25c0-3.15-3.4-5.25-7.5-5.25Z" />
      </svg>
    ) : (
      initials(name)
    )}
  </span>
)}
