---
// Home proof: the clients map with reviews popping from their client country as chat bubbles. Each client first
// arrives as an avatar at their country with typing dots beside it (the same bubble look as "How we work"); when the
// review bubble pops, the avatar and dots are gone and the bubble grows out of the avatar's spot. The loop order, each bubble's side of its country and the rhythms come from
// src/lib/review-loop.ts; the generated CSS (positions, keyframes, the two-at-a-time breakpoint) is ReviewLoopStyle,
// which the page puts in the head with the same `uid`, `places` and `playback`.
// The stage is a size container (`rl`): narrow, one bubble at a time sits under the map with its tail at the
// country's x; from 64rem the bubbles float over the map, and when the model found room two at a time.
// `playback`:
// - `loop` (default, zero JS): CSS keyframes cycle the reviews. WCAG 2.2.2: the loop pauses with the Auto-play switch
//   and on focus in the country chips (not on hover over the map: owner review 2026-11-20); under reduced motion it never rotates (the first
//   review shows, still). Countries are radio chips under the map: picking one stops the loop on that country's
//   review; "All" returns to the loop.
// - `scroll`: the scene is pinned (sticky) over a track with one step per review (snap points); the shown step
//   follows the scroll one step at a time (src/scripts/review-scroll.ts, loaded only in this mode), and each entry
//   is a time-based spring keyed on `data-on`. After the last review the scene scrolls away with the page. No
//   chips or switch: the scroll position is the control. Without scripting or on a short viewport: the plain cards.
// Screen readers get every review once, from the visually hidden list (the animated copies are aria-hidden), so
// nothing is announced on a timer or on scroll. Without :has() the list is the visible fallback, and it prints.
import Avatar from '@/components/proof/Avatar.astro';
import ClientsMap from '@/components/proof/ClientsMap.astro';
import ReviewScroll from '@/components/proof/ReviewScroll.astro';
import TestimonialCard from '@/components/proof/TestimonialCard.astro';
import { t } from '@/i18n';
import {
  briefQuote,
  caseStudies,
  caseStudyOf,
  type ProofPlace,
} from '@/lib/proof';
import { reviewLoopModel } from '@/lib/review-loop';

interface Props {
  /** Must be unique on the page and match the ReviewLoopStyle in the head. */
  uid?: string;
  places: ProofPlace[];
  /** How the reviews play: a timed loop (default) or one step per scroll. Match the ReviewLoopStyle. */
  playback?: 'loop' | 'scroll';
}

const { uid = 'proof', places, playback = 'loop' } = Astro.props;
const model = await reviewLoopModel(places);
const { items, countries } = model;
const scroll = playback === 'scroll';
const loop = items.length > 1;
const id = (s: string) => `${uid}-${s}`;
const cases = await caseStudies();
const author = (it: (typeof items)[number]) =>
  it.testimonial.entry.author || t('testimonial.client');
// The loop order is chosen for layout; the list (screen readers, print, no :has()) keeps the testimonial order.
const listed = [...items].sort(
  (a, b) => (a.testimonial.entry.order ?? 0) - (b.testimonial.entry.order ?? 0),
);
---

{items.length > 0 && (
  <div
    class={`rl rl-${uid}`}
    data-playback={playback}
    data-n={loop ? 'loop' : 'one'}
    data-pagefind-ignore
  >
    <div class="track">
      <div class="pin">
        <div class="area">
          <ClientsMap variant="bare" uid={uid}>
            <div class="ov" aria-hidden="true">
              {items.map((it) => (
                <span
                  class={`av anim sel q-${it.i} at-${it.iso}`}
                  data-q={it.i}
                >
                  <Avatar testimonial={it.testimonial} size="sm" class="pic" />
                  <span class="dots anim">
                    <i class="anim" />
                    <i class="anim" />
                    <i class="anim" />
                  </span>
                </span>
              ))}
            </div>
            <div class="msgs" aria-hidden="true">
              {items.map((it) => (
                <div
                  class={`bub anim sel q-${it.i} at-${it.iso} t-${it.tail} v-${it.v}`}
                  data-q={it.i}
                >
                  <div class="card">
                    <div class="who">
                      <Avatar testimonial={it.testimonial} size="sm" />
                      <span class="who-t">
                        <span class="name">{author(it)}</span>
                        <span class="role">
                          {it.testimonial.entry.role && (
                            <span>{it.testimonial.entry.role}</span>
                          )}
                          <span>{it.name}</span>
                        </span>
                      </span>
                    </div>
                    <p class="q quote">{briefQuote(it.testimonial)}</p>
                    {caseStudyOf(it.testimonial, cases) && (
                      /* Mouse only: the bubbles are decorative (aria-hidden), and the country chips and the review
                         cards reach the same reviews from the keyboard. */
                      <a
                        class="case"
                        href={caseStudyOf(it.testimonial, cases)!.href}
                        tabindex="-1"
                      >
                        {t('proof.caseStudy', {
                          title: caseStudyOf(it.testimonial, cases)!.title,
                        })}
                      </a>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </ClientsMap>
        </div>

        {scroll ? (
          <div class="prog" aria-hidden="true">
            <span class="pips">
              {items.map((it) => (
                <i data-q={it.i} />
              ))}
            </span>
            <span class="hint">{t('proof.scroll.hint')}</span>
          </div>
        ) : (
          <div class="ctl">
            <fieldset class="work-filter pick">
              <legend class="sr-only">{t('proof.loop.pick')}</legend>
              <input
                type="radio"
                class="all"
                name={id('c')}
                id={id('all')}
                checked
              />
              <label for={id('all')}>{t('proof.loop.all')}</label>
              {countries.map((c) => (
                <>
                  <input
                    type="radio"
                    class="cr"
                    name={id('c')}
                    id={id(`c-${c.iso}`)}
                    aria-describedby={c.items
                      .map((it) => id(`r-${it.i}`))
                      .join(' ')}
                  />
                  <label for={id(`c-${c.iso}`)}>{c.name}</label>
                </>
              ))}
            </fieldset>
            {loop && (
              <label class="switch">
                <input type="checkbox" role="switch" class="auto" checked />
                <span class="track-ui" aria-hidden="true" />
                <span>{t('proof.loop.auto')}</span>
              </label>
            )}
          </div>
        )}
      </div>
      {scroll && (
        <div class="steps" aria-hidden="true">
          {items.map(() => (
            <span />
          ))}
        </div>
      )}
    </div>

    <ul class="list" aria-label={t('proof.loop.list')}>
      {listed.map((it) => (
        <li>
          <TestimonialCard testimonial={it.testimonial} id={id(`r-${it.i}`)} />
        </li>
      ))}
    </ul>
  </div>
)}
{scroll && items.length > 0 && <ReviewScroll />}

<style>
  .rl {
    /* Soft, rounded bubbles that follow the radius token if it grows. */
    --bubble-r: max(1.125rem, var(--radius-xl));
    /* Review bubble: a surface that sits on the map in each theme (white / near-black), with the theme's own text.
       Typing indicator: the same incoming-bubble surface as "How we work", so the two read as one chat. */
    --review-bg: #ffffff;
    --review-line: #e5e5e5; /* hairline edge where the white card sits on the white map */
    --review-fg: #0a0a0a;
    --review-muted: #595959;
    --review-shadow: 0 0.75rem 2rem -0.75rem rgb(0 0 0 / 0.35);
    --typing-bg: #ffffff;
    --typing-fg: #595959; /* 7.0:1 on white */
    --typing-line: #d4d4d4;
    /* The client avatar on the map: sized to read as a person, not a marker (grows with the stage). */
    --av: 1.5rem;
  }
  :global(.dark) .rl {
    /* Dark surface, light text: no white slab glaring on the black page (17:1 text, 7.3:1 secondary). */
    --review-bg: #171717;
    --review-line: #333333;
    --review-fg: #ededed;
    --review-muted: #a3a3a3;
    --review-shadow: 0 0.75rem 2rem -0.75rem rgb(0 0 0 / 0.8);
    --typing-bg: #171717;
    --typing-fg: #a3a3a3;
    --typing-line: #333333;
  }
  /* The map stage is the size container both layouts (and the generated two-at-a-time rhythm) query. */
  .area {
    container: rl / inline-size;
  }

  /* Fallback (no :has()): the plain list of reviews; no overlays, no controls. */
  .ov,
  .msgs,
  .ctl,
  .prog {
    display: none;
  }
  .list {
    display: grid;
    gap: 2.5rem;
    margin-block-start: 3rem;
  }
  @media (min-width: 768px) {
    .list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @supports selector(:has(*)) {
    .list {
      position: absolute;
      inline-size: 1px;
      block-size: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .ov {
      display: block;
      position: absolute;
      inset: 0 0 auto 0;
      aspect-ratio: var(--rl-ar);
      pointer-events: none;
    }
    .msgs {
      display: grid;
      margin-block-start: 1.25rem;
    }
    .ctl,
    .prog {
      display: flex;
    }
  }

  /* Everything that plays starts hidden; the loop, a step or a selection shows it. */
  .av,
  .bub,
  .dots {
    opacity: 0;
    visibility: hidden;
  }

  /* The client: their avatar at the country, haloed so it reads on the dots, with typing dots beside it. */
  .av {
    position: absolute;
    left: var(--x);
    top: var(--y);
    inline-size: var(--av);
    block-size: var(--av);
    translate: -50% -50%;
    border-radius: 50%;
    box-shadow:
      0 0 0 2px var(--background),
      0 0.375rem 0.875rem -0.375rem
        color-mix(in oklab, var(--ink) 45%, transparent);
  }
  .av :global(.pic) {
    inline-size: 100%;
    block-size: 100%;
  }
  /* Typing indicator: the incoming bubble of "How we work" (ProcessThread), beside the avatar with its tail toward
     it (physical sides: the map is not mirrored in RTL). */
  .dots {
    position: absolute;
    left: calc(100% + 0.25rem);
    top: 50%;
    display: inline-flex;
    gap: 0.3rem;
    padding: 0.625rem 0.875rem;
    translate: 0 -50%;
    border: 1px solid var(--typing-line);
    border-radius: 1rem;
    border-top-left-radius: 0.375rem;
    background-color: var(--typing-bg);
  }
  .dots i {
    inline-size: 0.4rem;
    block-size: 0.4rem;
    border-radius: 50%;
    background-color: var(--typing-fg);
    opacity: 0.7;
  }
  .dots i:nth-child(2) {
    --j: 1;
  }
  .dots i:nth-child(3) {
    --j: 2;
  }
  @container rl (min-width: 40rem) {
    .av {
      --av: 1.875rem;
    }
  }

  /* The review bubble: a themed surface (white / near-black) that pops off the map. */
  .card {
    position: relative;
    display: grid;
    gap: 0.625rem;
    padding: 0.875rem 1rem 1rem;
    border: 1px solid var(--review-line);
    border-radius: var(--bubble-r);
    background-color: var(--review-bg);
    box-shadow: var(--review-shadow);
    color: var(--review-fg);
    pointer-events: auto;
  }
  .who {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: var(--text-sm);
    line-height: 1.3;
  }
  .who-t {
    display: grid;
  }
  .name {
    color: var(--review-fg);
    font-weight: 600;
  }
  .role {
    color: var(--review-muted);
    font-size: var(--text-xs);
  }
  .case {
    justify-self: start;
    color: var(--review-fg);
    font-size: var(--text-xs);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .role > * + *::before {
    content: '\00b7' / '';
    margin-inline: 0.375em;
  }
  .q {
    color: var(--review-fg);
    font-size: var(--text-base);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 6;
    line-clamp: 6;
    overflow: hidden;
  }
  .card::before {
    content: '';
    position: absolute;
    top: -7px;
    left: var(--tail);
    inline-size: 12px;
    block-size: 12px;
    margin-left: -6px;
    background-color: var(--review-bg);
    border: 1px solid var(--review-line);
    border-right-color: transparent;
    border-bottom-color: transparent;
    rotate: 45deg;
  }

  /* Narrow: one bubble under the map (all share one grid cell), at most 30rem wide, slid along so its tail sits
     under the country. Physical sides throughout: the map is not mirrored in RTL. */
  .msgs > * {
    grid-area: 1 / 1;
  }
  .bub {
    --cw: min(100cqi, 30rem);
    --cl: clamp(0px, calc(var(--xn) * 1cqi - 2.5rem), calc(100cqi - var(--cw)));
    --tail: clamp(
      1.25rem,
      calc(var(--xn) * 1cqi - var(--cl)),
      calc(var(--cw) - 1.25rem)
    );
    justify-self: left;
    inline-size: var(--cw);
    margin-left: var(--cl);
    transform-origin: var(--tail) -0.5rem;
  }

  /* From 64rem: bubbles float over the map, on the side of their country chosen by the model (`t-<n>`: the tail at
     n% of the bubble's width, the ends kept 1.5rem in; `v-b` below, `v-a` above), 1.75rem from the country so they
     clear the avatar, and grow out of the avatar (transform-origin) with a hint of rotation that unfolds away from
     it. Widths and gaps: keep in step with review-loop.ts. Avatars stay above the bubbles. */
  @container rl (min-width: 64rem) {
    @supports selector(:has(*)) {
      .msgs {
        display: block;
        position: absolute;
        inset: 0 0 auto 0;
        aspect-ratio: var(--rl-ar);
        margin: 0;
        z-index: 1;
        pointer-events: none;
      }
      .ov {
        z-index: 2;
      }
    }
    .av {
      --av: 2.25rem;
    }
    .bub {
      position: absolute;
      left: var(--x);
      top: var(--y);
      inline-size: min(20rem, 28cqi);
      margin: 0;
      translate: calc(-1 * var(--tail)) var(--ty);
      transform-origin: var(--tail) var(--oy);
    }
    .t-0 {
      --tail: 1.5rem;
    }
    .t-25 {
      --tail: max(1.5rem, 25%);
    }
    .t-50 {
      --tail: 50%;
    }
    .t-75 {
      --tail: min(75%, calc(100% - 1.5rem));
    }
    .t-100 {
      --tail: calc(100% - 1.5rem);
    }
    .v-b {
      --ty: 1.75rem;
      --oy: -1.75rem;
    }
    .v-a {
      --ty: calc(-100% - 1.75rem);
      --oy: calc(100% + 1.75rem);
    }
    :is(.t-0, .t-25).v-b,
    :is(.t-75, .t-100).v-a {
      --rl-rot: -4deg;
    }
    :is(.t-75, .t-100).v-b,
    :is(.t-0, .t-25).v-a {
      --rl-rot: 4deg;
    }
    .v-a .card::before {
      top: auto;
      bottom: -7px;
      border-color: transparent var(--review-line) var(--review-line) transparent;
    }
  }

  /* Loop controls: the country chips (radios, the global .work-filter chip style) and the Auto-play switch. */
  .ctl {
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-block-start: 1.5rem;
  }
  .pick {
    margin: 0;
    padding: 0;
    border: 0;
    min-inline-size: 0;
  }
  .switch {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-block-size: 2.5rem;
    margin-inline-start: auto;
    color: var(--ink);
    font-size: var(--text-sm);
    cursor: pointer;
  }
  .switch input {
    position: absolute;
    inset-inline-start: 0;
    inline-size: 1px;
    block-size: 1px;
    margin: 0;
    opacity: 0;
  }
  .track-ui {
    position: relative;
    flex: none;
    inline-size: 2.25rem;
    block-size: 1.25rem;
    border: 1px solid var(--input);
    border-radius: 999px;
    background-color: var(--background);
    transition: background-color var(--dur-effect) var(--ease-effect);
  }
  .track-ui::after {
    content: '';
    position: absolute;
    inset-block-start: 0.125rem;
    inset-inline-start: 0.125rem;
    inline-size: 0.875rem;
    block-size: 0.875rem;
    border-radius: 50%;
    background-color: var(--muted-foreground);
    transition:
      translate var(--dur-spring-fast) var(--ease-spring-fast),
      background-color var(--dur-effect) var(--ease-effect);
  }
  .switch:has(input:checked) .track-ui {
    border-color: var(--primary);
    background-color: var(--primary);
  }
  .switch:has(input:checked) .track-ui::after {
    translate: 1rem 0;
    background-color: var(--primary-foreground);
  }
  :global([dir='rtl']) .switch:has(input:checked) .track-ui::after {
    translate: -1rem 0;
  }
  .switch:has(input:focus-visible) .track-ui {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }
  .rl:has(.cr:checked) .switch {
    display: none;
  }

  /* No rotation (reduced motion, or a single review): the first review and its client show, still. */
  .rl[data-playback='loop'][data-n='one']:has(.all:checked) .bub.q-0 {
    opacity: 1;
    visibility: visible;
  }
  @media (prefers-reduced-motion: reduce) {
    .rl[data-playback='loop']:has(.all:checked) .bub.q-0 {
      opacity: 1;
      visibility: visible;
    }
    .switch {
      display: none;
    }
  }

  /* The loop. Keyframes, period (--T), per-review delays (--d) and keyframe names (--k-*) are generated in
     ReviewLoopStyle, per rhythm. Longhands only. Easings are the motion tokens: the avatar on the fast spring, the
     bubble's scale on the bouncy spring, opacity and the dots on the effects spring (exits set their own curve in
     the keyframes). The one `infinite` loop on the site: it has a pause control (the Auto-play switch), pauses on
     focus in the chips (WCAG 2.2.2; not on hover, owner review 2026-11-20), and never runs under reduced motion. Paused, everything holds still (dots too). */
  @media (prefers-reduced-motion: no-preference) {
    .rl[data-playback='loop'][data-n='loop']:has(.all:checked) .anim {
      animation-duration: var(--T);
      animation-delay: var(--d);
      animation-iteration-count: infinite;
      animation-fill-mode: both;
    }
    .rl[data-playback='loop'][data-n='loop']:has(.all:checked) .av {
      animation-name: var(--k-av);
      animation-timing-function: var(--ease-spring-fast);
    }
    .rl[data-playback='loop'][data-n='loop']:has(.all:checked) .dots {
      animation-name: var(--k-dots);
      animation-timing-function: var(--ease-effect);
    }
    .rl[data-playback='loop'][data-n='loop']:has(.all:checked) .dots i {
      animation-name: var(--k-type);
      animation-delay: calc(var(--d) + var(--j, 0) * 0.12s);
      animation-timing-function: var(--ease-in-out);
    }
    .rl[data-playback='loop'][data-n='loop']:has(.all:checked) .bub {
      animation-name: var(--k-pop), var(--k-fade);
      animation-timing-function: var(--ease-spring-bouncy), var(--ease-effect);
    }
    /* Pause: the switch off, or focus in the country chips. A pointer over the map does not pause it (owner). */
    .rl:has(.auto:not(:checked)) .anim,
    .rl[data-playback='loop']:has(.pick:focus-within) .anim {
      animation-play-state: paused;
    }
  }

  /* Scroll playback. Only where it can work (scripting on, a viewport tall enough to pin the scene); elsewhere the
     reviews are the plain cards. The scene (map + progress) sticks under the header, centred in the viewport, while
     the track scrolls one --step per review (the .steps rows set the length; the script reads one row's height).
     No scroll snap: tested with real input in Chrome, proximity snapping pulls each wheel notch back to the current
     row (a notched wheel can never advance) and mandatory stops End at the last row, and neither stops a fling.
     The script sets `data-on` (cur / prev / out) on the [data-q] parts and `data-fast` while it walks several steps. */
  @media (scripting: enabled) and (min-height: 30rem) {
    .rl[data-playback='scroll'] {
      --step: 40svh;
      --pin-h: calc(100svh - var(--spacing-header) - 1rem);
      --lead: 0.6s;
    }
    .rl[data-playback='scroll'][data-fast] {
      --lead: 0.1s;
    }
    .rl[data-playback='scroll'] .track {
      display: grid;
    }
    .rl[data-playback='scroll'] .track > * {
      grid-area: 1 / 1;
    }
    .rl[data-playback='scroll'] .pin {
      position: sticky;
      top: calc(var(--spacing-header) + 1rem);
      z-index: 1;
      display: grid;
      align-content: center;
      align-self: start;
      min-block-size: var(--pin-h);
    }
    .rl[data-playback='scroll'] .steps {
      display: grid;
      grid-auto-rows: var(--step);
      padding-block: calc(var(--step) / 2) calc(var(--pin-h) - var(--step) / 2);
      pointer-events: none;
    }
  }
  @media not all and (scripting: enabled) and (min-height: 30rem) {
    .rl[data-playback='scroll'] :is(.ov, .msgs, .prog) {
      display: none;
    }
    .rl[data-playback='scroll'] .list {
      position: static;
      inline-size: auto;
      block-size: auto;
      overflow: visible;
      clip-path: none;
      white-space: normal;
    }
  }

  /* Progress under the map: one pip per review (the current one long), and a hint until the last review. */
  .prog {
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-block-start: 1.5rem;
    color: var(--muted-foreground);
    font-size: var(--text-sm);
  }
  .pips {
    display: flex;
    gap: 0.375rem;
  }
  .pips i {
    inline-size: 0.5rem;
    block-size: 0.5rem;
    border-radius: 999px;
    background-color: var(--border);
    transition:
      inline-size var(--dur-spring-fast) var(--ease-spring-fast),
      background-color var(--dur-effect) var(--ease-effect);
  }
  .pips i[data-on] {
    background-color: var(--ink);
  }
  .pips i[data-on='cur'] {
    inline-size: 1.5rem;
  }
  .hint {
    transition: opacity var(--dur-effect) var(--ease-effect);
  }
  .rl:has(.pips i:last-child[data-on='cur']) .hint {
    opacity: 0;
  }

  /* Scroll steps: time-based entries keyed on data-on, never scrubbed. The client pops in, types for --lead, then
     the bubble grows out of the avatar; a step back or a step on (narrow) sends the old one out. cur -> prev keeps
