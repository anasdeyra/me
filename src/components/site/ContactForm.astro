---
// Contact form (3 fields, FR-10). Works without JS: native validation + a plain POST that the endpoint answers
// with a 303 to /contact/sent or /contact/error. With JS the script below validates with the shared rules
// (src/lib/contact-validate.ts), posts with fetch and shows inline errors, an error summary and the result panels.
// Messages reach the script through data-* attributes on the form (the script never imports the dictionary).
import { t, tParts } from '@/i18n';
import { mailtoHref, whatsappHref } from '@/lib/contact';
import { CONTACT_LIMITS } from '@/lib/contact-validate';
import { getSettings } from '@/lib/content';
import { cn } from '@/lib/utils';
import Button from './Button.astro';

interface Props {
  /** Where the form sits: sent with the message (analytics + mail) and used as the default id prefix. */
  location: 'contact' | 'final';
  /** Prefix for element ids; set it when two forms could share a page. Defaults to `<location>-form`. */
  idPrefix?: string;
  class?: string;
}

const {
  location,
  idPrefix = `${location}-form`,
  class: className,
} = Astro.props;
const settings = await getSettings();
const id = (name: string) => `${idPrefix}-${name}`;
const failure = tParts('contact.form.failure.body');

const field =
  'block h-11 w-full rounded-sm border border-input bg-background px-3 text-base text-ink aria-invalid:border-destructive';
const label = 'mb-1.5 block text-sm font-medium text-ink';
const error = 'mt-1.5 text-sm text-destructive empty:hidden';
---

<div class={cn('contact-form', className)} data-contact-root>
  <form
    method="post"
    action="/api/contact"
    data-contact-form
    data-location={location}
    data-err-name-required={t('contact.form.err.nameRequired')}
    data-err-email-invalid={t('contact.form.err.emailInvalid')}
    data-err-message-short={t('contact.form.err.messageShort')}
    data-err-message-long={t('contact.form.err.messageLong')}
    data-err-generic={t('contact.form.err.generic')}
    data-summary-title={t('contact.form.summary')}
    data-sending={t('contact.form.sending')}
    class="flex flex-col gap-6"
  >
    <div
      data-summary
      role="alert"
      tabindex="-1"
      hidden
      class="border border-destructive p-4 text-sm text-ink"
    >
      <p class="font-medium" data-summary-title></p>
      <ul class="mt-2 list-disc ps-5" data-summary-list></ul>
    </div>

    <div>
      <label for={id('name')} class={label}>
        {t('contact.form.name')}
      </label>
      <input
        id={id('name')}
        name="name"
        type="text"
        autocomplete="name"
        required
        maxlength={CONTACT_LIMITS.name}
        aria-describedby={id('name-error')}
        class={field}
      />
      <p id={id('name-error')} class={error}></p>
    </div>

    <div>
      <label for={id('email')} class={label}>
        {t('contact.form.email')}
      </label>
      <input
        id={id('email')}
        name="email"
        type="email"
        autocomplete="email"
        inputmode="email"
        required
        maxlength={CONTACT_LIMITS.email}
        aria-describedby={id('email-error')}
        class={field}
      />
      <p id={id('email-error')} class={error}></p>
    </div>

    <div>
      <label for={id('message')} class={label}>
        {t('contact.form.message')}
      </label>
      <textarea
        id={id('message')}
        name="message"
        rows="6"
        required
        minlength={CONTACT_LIMITS.messageMin}
        maxlength={CONTACT_LIMITS.messageMax}
        aria-describedby={`${id('message-hint')} ${id('message-error')}`}
        class={cn(field, 'h-auto py-2.5')}
      ></textarea>
      <p id={id('message-hint')} class="mt-1.5 text-sm text-muted-foreground">
        {t('contact.form.hint')}
      </p>
      <p id={id('message-error')} class={error}></p>
    </div>

    <!-- Honeypot: humans never see or reach it; bots fill it and get a fake success. -->
    <div class="honeypot" aria-hidden="true">
      <label for={id('company_url')}>{t('contact.form.honeypot')}</label>
      <input
        id={id('company_url')}
        name="company_url"
        type="text"
        tabindex="-1"
        autocomplete="off"
      />
    </div>
    <input type="hidden" name="location" value={location} />

    <div
      data-failure
      tabindex="-1"
      role="alert"
      hidden
      class="border border-destructive p-4 text-sm text-ink"
    >
      <p class="font-medium">{t('contact.form.failure.title')}</p>
      <p class="mt-1">
        {failure.map((part) =>
          'text' in part ? (
            part.text
          ) : part.slot === 'email' ? (
            <a href={mailtoHref(settings.email)} class="link" translate="no">
              {settings.email}
            </a>
          ) : (
            <a
              href={whatsappHref(settings.whatsappNumber)}
              class="link"
              target="_blank"
              rel="noopener noreferrer"
            >
              {t('whatsapp.short')}
              <span class="sr-only"> {t('a11y.newTab')}</span>
            </a>
          ),
        )}
      </p>
    </div>

    <div class="flex flex-wrap items-center gap-4">
      <Button type="submit" size="lg" data-submit>
        {t('contact.form.submit')}
      </Button>
      <span
        role="status"
        class="text-sm text-muted-foreground"
        data-status
      ></span>
    </div>
  </form>

  <div data-success tabindex="-1" hidden class="border border-rule p-6">
    <p class="text-2xl font-semibold text-ink">
      {t('contact.form.success.title')}
    </p>
    <p class="mt-2 max-w-measure">{t('contact.form.success.body')}</p>
  </div>
</div>

<script>
  import { validateContact, type ContactField } from '@/lib/contact-validate';

  type Track = (kind: 'event', e: { name: string; data: object }) => void;
  const FIELDS: ContactField[] = ['name', 'email', 'message'];

  function init(form: HTMLFormElement) {
    const root = form.closest<HTMLElement>('[data-contact-root]')!;
    const q = <T extends HTMLElement>(sel: string) =>
      form.querySelector<T>(sel)!;
    const summary = q('[data-summary]');
    const list = q('[data-summary-list]');
    const failure = q('[data-failure]');
    const status = q('[data-status]');
    const submit = q<HTMLButtonElement>('[data-submit]');
    const success = root.querySelector<HTMLElement>('[data-success]')!;
    const location = form.dataset.location ?? '';
    const input = (f: ContactField) =>
      form.elements.namedItem(f) as HTMLInputElement | HTMLTextAreaElement;
    const errorBox = (f: ContactField) =>
      document.getElementById(
        input(f).getAttribute('aria-describedby')!.split(' ').pop()!,
      )!;

    // i18n key (contact.form.err.nameRequired) -> data attribute (data-err-name-required).
    const message = (key: string) => {
      const last = key.split('.').pop() ?? '';
      const attr = 'err' + last[0].toUpperCase() + last.slice(1);
      return form.dataset[attr] ?? form.dataset.errGeneric ?? '';
    };
    const track = (name: string) =>
      (window as unknown as { va?: Track }).va?.('event', {
        name,
        data: { location },
      });

    const clear = () => {
      for (const f of FIELDS) {
        input(f).removeAttribute('aria-invalid');
        errorBox(f).textContent = '';
      }
      summary.hidden = true;
      list.replaceChildren();
      failure.hidden = true;
    };

    const showErrors = (errors: Partial<Record<ContactField, string>>) => {
      q('[data-summary-title]').textContent = form.dataset.summaryTitle ?? '';
      for (const f of FIELDS) {
        const key = errors[f];
        if (!key) continue;
        const text = message(key);
        input(f).setAttribute('aria-invalid', 'true');
        errorBox(f).textContent = text;
        const a = document.createElement('a');
        a.href = '#' + input(f).id;
        a.className = 'link';
        a.textContent = text;
        a.addEventListener('click', (e) => {
          e.preventDefault();
          input(f).focus();
        });
        const li = document.createElement('li');
        li.append(a);
        list.append(li);
      }
      summary.hidden = false;
      summary.focus();
    };

    form.noValidate = true; // our rules and messages replace the browser bubbles; without JS the native ones apply
    for (const f of FIELDS) {
      input(f).addEventListener('input', () => {
        input(f).removeAttribute('aria-invalid');
        errorBox(f).textContent = '';
      });
    }

    let busy = false;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (busy) return;
      clear();
      const result = validateContact({
        name: input('name').value,
        email: input('email').value,
        message: input('message').value,
      });
      if (!result.ok) return showErrors(result.errors);

      busy = true;
      submit.disabled = true;
      status.textContent = form.dataset.sending ?? '';
      try {
        const body = new URLSearchParams();
        for (const [k, v] of new FormData(form)) {
          if (typeof v === 'string') body.append(k, v);
        }
        const res = await fetch(form.getAttribute('action')!, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body,
        });
        const data = await res.json().catch(() => null);
        if (res.ok && data?.ok) {
          form.hidden = true;
          success.hidden = false;
          success.focus();
          track('contact_form_success');
        } else if (
          res.status === 422 &&
          data?.errors &&
          Object.keys(data.errors).length
        ) {
          showErrors(data.errors);
        } else {
          throw new Error('send failed');
        }
      } catch {
        failure.hidden = false;
        failure.focus();
        track('contact_form_error');
      } finally {
        busy = false;
        submit.disabled = false;
        status.textContent = '';
      }
    });
  }

  document
    .querySelectorAll<HTMLFormElement>('form[data-contact-form]')
    .forEach(init);
</script>
