---
// The primary CTA: a prefilled wa.me link in WhatsApp green. Opens in a new tab so the site stays open.
import { t } from '@/i18n';
import type { ButtonVariants } from '@/components/ui/button';
import { whatsappHref } from '@/lib/contact';
import { getSettings } from '@/lib/content';
import Button from './Button.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';

interface Props {
  size?: ButtonVariants['size'];
  /** Visible label; defaults to "Message me on WhatsApp". */
  label?: string;
  /** Prefilled message; defaults to the generic template. */
  text?: string;
  /** Analytics location (hero, header, final, ...): adds data-track="contact_whatsapp" data-track-location. */
  trackLocation?: string;
  /** Optional analytics slug (project pages): adds data-track-slug. */
  trackSlug?: string;
  class?: string;
}

const {
  size = 'default',
  label = t('whatsapp.cta'),
  text,
  trackLocation,
  trackSlug,
  class: className,
} = Astro.props;
const settings = await getSettings();
---

<Button
  href={whatsappHref(settings.whatsappNumber, text)}
  variant="whatsapp"
  size={size}
  class={className}
  target="_blank"
  rel="noopener noreferrer"
  data-track={trackLocation ? 'contact_whatsapp' : undefined}
  data-track-location={trackLocation}
  data-track-slug={trackLocation ? trackSlug : undefined}
>
  <WhatsAppIcon />
  <span>
    {label}
    <span class="sr-only"> {t('a11y.newTab')}</span>
  </span>
  <slot name="end" />
</Button>
