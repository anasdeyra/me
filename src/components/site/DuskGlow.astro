---
// Dusk grainy-gradient glow (decorative). Put it inside a `relative isolate` box; it sits behind the
// box's content and bleeds past it by --dusk-inset (default -20%; e.g. class="[--dusk-inset:0%]").
// Never behind body text. Removed under forced colors. Styles: .dusk in src/styles/global.css.
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'div'>;
// Spread the rest so the parent's scope attribute reaches the div (scoped rules such as .hero-halo apply).
const { class: className, ...rest } = Astro.props;
---

<div class:list={['dusk', className]} aria-hidden="true" {...rest}></div>
