---
// Site search (FR-14): a trigger button and a native <dialog> (showModal: focus trap, ESC, inert background).
// The tiny script below opens the dialog; the Pagefind client lives in a lazy chunk (src/scripts/search-dialog.ts)
// that loads on first open, so nothing search-related is fetched before interaction. The `data-search-dialog`
// marker makes config/security-headers.mjs add 'wasm-unsafe-eval' to this route's CSP (Pagefind compiles WASM).
// The whole block is data-pagefind-ignore: it lives inside <main>, which is what gets indexed.
import Button from '@/components/site/Button.astro';
import { t } from '@/i18n';
import { whatsappHref, whatsappPrefill } from '@/lib/contact';
import { getSettings } from '@/lib/content';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const settings = await getSettings();
---

<div data-pagefind-ignore class:list={['js-only', className]}>
  <Button
    variant="outline"
    data-search-open
    aria-haspopup="dialog"
    aria-keyshortcuts="/"
    data-track="search_open"
    data-track-trigger="button"
  >
    <svg
      viewBox="0 0 16 16"
      width="16"
      height="16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      aria-hidden="true"
      focusable="false"
    >
      <circle cx="7" cy="7" r="4.75"></circle>
      <path d="M10.5 10.5 14 14" stroke-linecap="round"></path>
    </svg>
    {t('search.trigger')}
    <kbd
      class="hidden rounded-xs border border-border px-1.5 font-mono text-xs text-muted-foreground pointer-fine:inline"
      aria-hidden="true"
      title={t('search.hint')}
    >
      /
    </kbd>
  </Button>

  <dialog
    data-search-dialog
    aria-labelledby="search-title"
    data-one={t('search.result')}
    data-many={t('search.results', { n: '{n}' })}
    data-none={t('search.none')}
    data-loading={t('search.loading')}
    data-unavailable={t('search.unavailable')}
    data-error={t('search.error')}
    class="search-dialog mx-auto mt-[8dvh] mb-auto max-h-[84dvh] w-[min(100%-2rem,44rem)] max-w-none overflow-hidden border border-rule bg-background p-0 text-foreground"
  >
    <div class="flex max-h-[84dvh] flex-col">
      <div class="flex items-center justify-between gap-4 border-b border-border px-5 py-3">
        <h2 id="search-title" class="text-lg">
          {t('search.title')}
        </h2>
        <form method="dialog">
          <Button type="submit" variant="ghost" size="sm" data-search-close>
            {t('search.close')}
          </Button>
        </form>
      </div>
      <div class="px-5 pt-4 pb-3">
        <label
          for="search-input"
          class="mb-2 block text-sm text-muted-foreground"
        >
          {t('search.label')}
        </label>
        <input
          id="search-input"
          type="search"
          data-search-input
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          autofocus
          placeholder={t('search.placeholder')}
          class="h-12 w-full rounded-xs border border-ink bg-background px-3 text-base text-ink placeholder:text-muted-foreground"
        />
        <p
          role="status"
          data-search-status
          class="mt-3 min-h-5 font-mono text-xs text-muted-foreground tabular-nums"
        ></p>
      </div>
      <div class="px-5 pb-3">
        <label class="inline-flex min-h-6 items-center gap-2 text-sm text-muted-foreground">
          <input
            type="checkbox"
            data-shortcuts-toggle
            checked
            class="size-4 accent-[var(--ink)]"
          />
          {t('search.shortcuts')}
        </label>
      </div>
      <div class="overflow-y-auto overscroll-contain px-5 pb-5">
        <ul data-search-results class="border-t border-border"></ul>
        <p data-search-none hidden class="mt-4">
          <a
            href={whatsappHref(
              settings.whatsappNumber,
              whatsappPrefill('contact'),
            )}
            class="link text-ink"
            target="_blank"
            rel="noopener noreferrer"
            data-track="contact_whatsapp"
            data-track-location="search"
          >
            {t('search.noneCta')}
            <span class="sr-only"> {t('a11y.newTab')}</span>
          </a>
        </p>
      </div>
    </div>
  </dialog>
</div>

<style is:global>
  html:has(dialog[data-search-dialog][open]) {
    overflow: hidden;
  }
  dialog[data-search-dialog]::backdrop {
    background: oklch(0 0 0 / 0.6);
  }
  @media (prefers-reduced-motion: no-preference) {
    dialog[data-search-dialog][open] {
      animation: search-in 140ms ease-out;
    }
    @keyframes search-in {
      from {
        opacity: 0;
        transform: translateY(-6px);
      }
    }
  }
  .search-dialog input[type='search']::-webkit-search-cancel-button {
    filter: grayscale(1);
  }
  .search-result {
    display: block;
    padding-block: 0.875rem;
    border-bottom: 1px solid var(--border);
    min-height: 44px;
  }
  .search-result:hover .search-result-title {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .search-result-title {
    display: block;
    font-weight: 600;
    color: var(--ink);
  }
  .search-result-excerpt {
    display: block;
    margin-top: 0.25rem;
    font-size: var(--text-sm);
    color: var(--muted-foreground);
  }
  .search-result-excerpt mark {
    background: transparent;
    color: var(--ink);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>

<script>
  import { shortcutKey } from '@/scripts/shortcuts';

  type Track = (kind: 'event', e: { name: string; data: object }) => void;

  const dialog = document.querySelector<HTMLDialogElement>(
    '[data-search-dialog]',
  );
  const trigger = document.querySelector<HTMLElement>('[data-search-open]');

  if (dialog && trigger) {
    let ready: Promise<unknown> | undefined;
    const open = () => {
      if (dialog.open) return;
      dialog.showModal();
      ready ??= import('@/scripts/search-dialog').then((m) =>
        m.initSearch(dialog),
      );
    };
    trigger.addEventListener('click', open);
    dialog.addEventListener('close', () => trigger.focus());
    addEventListener('keydown', (e) => {
      if (dialog.open || !shortcutKey(e, '/')) return;
      e.preventDefault();
      (window as unknown as { va?: Track }).va?.('event', {
        name: 'search_open',
        data: { trigger: 'key' },
      });
      open();
    });
  }
</script>
