---
// Email as a mailto link plus a copy button (hidden without JS). The status region announces the result.
// Analytics: the link and the button carry data-track; the copy click bubbles to the delegated listener.
import { t } from '@/i18n';
import { mailtoHref } from '@/lib/contact';
import { cn } from '@/lib/utils';

interface Props {
  email: string;
  /** Analytics location (contact, final, ...). */
  location: string;
  class?: string;
}

const { email, location, class: className } = Astro.props;
---

<div
  class={cn('flex flex-wrap items-center gap-x-4 gap-y-2', className)}
  data-copy-email-root
>
  <a
    href={mailtoHref(email)}
    class="link text-lg text-ink"
    translate="no"
    data-track="contact_email_click"
    data-track-location={location}
  >
    {email}
  </a>
  <button
    type="button"
    class="js-only inline-flex h-10 items-center rounded-full border border-input px-4 text-sm text-ink hover:bg-muted"
    data-copy-email={email}
    data-copied={t('contact.email.copied')}
    data-failed={t('contact.email.copyFailed')}
    data-track="contact_email_copy"
    data-track-location={location}
  >
    {t('contact.email.copy')}
  </button>
  <span role="status" class="sr-only" data-copy-status></span>
</div>

<script>
  const timers = new WeakMap<Element, number>();
  const announce = (root: Element | null, message: string) => {
    const status = root?.querySelector('[data-copy-status]');
    if (!root || !status) return;
    clearTimeout(timers.get(root));
    // Empty first so an identical repeated message is announced again.
    status.textContent = '';
    requestAnimationFrame(() => {
      status.textContent = message;
      timers.set(
        root,
        window.setTimeout(() => (status.textContent = ''), 4000),
      );
    });
  };

  const legacyCopy = (text: string) => {
    const area = document.createElement('textarea');
    area.value = text;
    area.setAttribute('readonly', '');
    area.style.position = 'fixed';
    area.style.opacity = '0';
    document.body.append(area);
    area.select();
    let ok = false;
    try {
      ok = document.execCommand('copy');
    } catch {}
    area.remove();
    return ok;
  };

  document.addEventListener('click', async (e) => {
    const btn =
      e.target instanceof Element
        ? e.target.closest<HTMLElement>('[data-copy-email]')
        : null;
    if (!btn) return;
    const email = btn.dataset.copyEmail ?? '';
    let ok = false;
    try {
      await navigator.clipboard.writeText(email);
      ok = true;
    } catch {
      ok = legacyCopy(email);
    }
    announce(
      btn.closest('[data-copy-email-root]'),
      (ok ? btn.dataset.copied : btn.dataset.failed) ?? '',
    );
  });
</script>
