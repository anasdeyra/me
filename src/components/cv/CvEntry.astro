---
// One CV entry (job, degree, project): title line, plain-text dates, optional text and bullets.
import type { CvEntry } from '@/lib/cv-model';

interface Props {
  entry: CvEntry;
}

const { entry } = Astro.props;
const meta = [entry.range, entry.meta].filter(Boolean).join(' · ');
---

<li class="py-5 first:pt-0 last:pb-0">
  <h3 class="text-lg">
    {entry.href ? (
      <a href={entry.href} class="link">
        {entry.title}
      </a>
    ) : (
      entry.title
    )}
    {entry.org && (
      <span class="font-normal text-foreground">, {entry.org}</span>
    )}
  </h3>
  {meta && <p class="mt-1 text-sm text-muted-foreground">{meta}</p>}
  {entry.text && <p class="mt-2">{entry.text}</p>}
  {entry.bullets?.length ? (
    <ul class="mt-3 list-disc space-y-1.5 ps-5">
      {entry.bullets.map((b) => (
        <li>{b}</li>
      ))}
    </ul>
  ) : null}
</li>
