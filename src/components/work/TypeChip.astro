---
// Project (client / side / research) or post (article / note) type label: hairline chip, mono, text only.
import { t } from '@/i18n';
import type { PostType } from '@/lib/posts';
import type { ProjectType } from '@/lib/projects';
import { cn } from '@/lib/utils';

interface Props {
  type: ProjectType | PostType;
  class?: string;
}

const { type, class: className } = Astro.props;
---

<span class={cn('chip font-mono', className)}>
  {type === 'article' || type === 'note'
    ? t(`blog.type.${type}`)
    : t(`work.type.${type}`)}
</span>
