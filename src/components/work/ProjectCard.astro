---
// Project card: the whole card is one link (stretched title link, no nested links).
// Order: visual, type chip, title, headline metric or outcome, stack chips, year. The caller adds `data-type`
// and the `work-card` class to the <li> wrapper when the chip filter is used. Hover/focus morphs the frame's corners
// (rounded-lg -> xl, like the buttons' shape morph; no lift) on the bouncy spring, so they land with a soft wobble, and
// slides in and turns the title arrow (global [data-arrow] rule: its springs, no transition utilities on the icon).
import { t } from '@/i18n';
import type { ProjectView } from '@/lib/projects';
import ArrowIcon from '@/components/site/ArrowIcon.astro';
import { cn } from '@/lib/utils';
import ProjectVisual from './ProjectVisual.astro';
import TypeChip from './TypeChip.astro';

interface Props {
  project: ProjectView;
  headingLevel?: 2 | 3 | 4;
  /** Eager-load the visual (above the fold only). */
  priority?: boolean;
  class?: string;
}

const {
  project,
  headingLevel = 3,
  priority = false,
  class: className,
} = Astro.props;
const Heading = `h${headingLevel}` as const;
const stack = project.stack.slice(0, 4);
---

<article
  data-glow
  class={cn(
    'group relative flex flex-col gap-4 rounded-lg has-[a:focus-visible]:outline-2 has-[a:focus-visible]:outline-offset-4',
    className,
  )}
>
  <ProjectVisual
    project={project}
    size="card"
    loading={priority ? 'eager' : 'lazy'}
    class="glow-tint isolate transition-[border-radius] duration-(--dur-spring-bouncy) ease-(--ease-spring-bouncy) motion-safe:group-hover:rounded-xl motion-safe:group-has-[a:focus-visible]:rounded-xl"
  />
  <div class="flex flex-wrap items-center gap-2">
    <TypeChip type={project.type} />
    {project.status && (
      <span class="chip">{t(`work.status.${project.status}`)}</span>
    )}
  </div>
  <Heading class="text-xl">
    <a
      href={project.href}
      class="decoration-1 underline-offset-4 transition-colors duration-(--dur-effect) ease-(--ease-effect) after:absolute after:inset-0 group-hover:text-link-hover group-hover:underline focus-visible:outline-none"
    >
      {project.title}
      <ArrowIcon class="ms-1 inline-block size-4 -translate-x-1 align-[-0.1em] opacity-0 group-hover:translate-x-0 group-hover:opacity-100 group-has-[a:focus-visible]:translate-x-0 group-has-[a:focus-visible]:opacity-100 motion-reduce:translate-x-0" />
    </a>
  </Heading>
  {project.headline ? (
    <p class="text-muted-foreground">
      <span class="text-ink font-semibold">{project.headline.value}</span>{' '}
      {project.headline.label}
      {project.headline.context && <span>, {project.headline.context}</span>}
    </p>
  ) : (
    <p class="text-muted-foreground">{project.outcome}</p>
  )}
  {(stack.length > 0 || project.year) && (
    <div class="mt-auto flex items-end justify-between gap-4">
      {stack.length > 0 && (
        <ul class="flex flex-wrap gap-1.5">
          {stack.map((s) => (
            <li class="chip">{s}</li>
          ))}
        </ul>
      )}
      {project.year && (
        <span class="font-mono text-xs text-muted-foreground tabular-nums">
          {project.year}
        </span>
      )}
    </div>
  )}
</article>
