---
// Byline row under the post title: type, published (and updated when different), reading time.
import TypeChip from '@/components/work/TypeChip.astro';
import { t } from '@/i18n';
import { formatDate } from '@/lib/entries';
import type { PostView } from '@/lib/posts';
import { cn } from '@/lib/utils';

interface Props {
  post: PostView;
  class?: string;
}

const { post, class: className } = Astro.props;
---

<div
  data-pagefind-ignore
  class={cn(
    'flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-muted-foreground',
    className,
  )}
>
  <TypeChip type={post.type} />
  {post.draft && <span class="chip">{t('blog.draftBadge')}</span>}
  <span>
    {t('blog.published', { date: '' }).trimEnd()}{' '}
    <time datetime={post.date}>{formatDate(post.date)}</time>
  </span>
  {post.updated && (
    <span>
      {t('blog.updated', { date: '' }).trimEnd()}{' '}
      <time datetime={post.updated}>{formatDate(post.updated)}</time>
    </span>
  )}
  <span>{t('blog.readingTime', { minutes: post.readingMinutes })}</span>
</div>
