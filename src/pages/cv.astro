---
// /cv (study 6.4): ATS-first, semantic single-column HTML from the same model as /cv.pdf. Sections with no
// data are omitted. Standard headings, plain-text dates, skills as text. Print stylesheet in global.css.
import CvEntry from '@/components/cv/CvEntry.astro';
import Button from '@/components/site/Button.astro';
import Section from '@/components/site/Section.astro';
import { t } from '@/i18n';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCvData } from '@/lib/cv';
import { buildCvModel } from '@/lib/cv-model';
import { isLive } from '@/lib/routes';
import { personNode } from '@/lib/schema';

const data = await getCvData();
const m = await buildCvModel(data, { workLive: await isLive('work') });
const { settings, profile } = data;

const sections = [
  { id: 'summary', title: t('cv.summary') },
  { id: 'experience', title: t('cv.experience') },
  { id: 'freelance', title: t('cv.freelance') },
  { id: 'skills', title: t('cv.skills') },
  { id: 'education', title: t('cv.education') },
  { id: 'research', title: t('cv.research') },
  { id: 'languages', title: t('cv.languages') },
  { id: 'projects', title: t('cv.projects') },
] as const;
const title = Object.fromEntries(sections.map((s) => [s.id, s.title]));
---

<BaseLayout
  og="cv"
  title={t('cv.title')}
  description={t('cv.description')}
  schema={[personNode(settings, profile)]}
  footerCta={false}
>
  <main id="main" class="cv-page pt-8 pb-section md:pt-14 lg:pt-20">
    <div class="wrap grid-page pb-10 md:pb-14">
      <div class="col-span-12 lg:col-span-9">
        <h1 class="text-3xl" data-spec="type:text-3xl contrast">
          {m.heading}
        </h1>
        <ul class="mt-6 space-y-1 text-lg">
          {m.openLine && <li class="text-ink">{m.openLine}</li>}
          <li>{m.locationLine}</li>
        </ul>
        <ul class="mt-3 flex flex-wrap gap-x-6 gap-y-1">
          {m.links.map((l) => (
            <li>
              <a
                href={l.href}
                class="link text-ink"
                translate="no"
                data-track={
                  l.href.startsWith('mailto:')
                    ? 'contact_email_click'
                    : undefined
                }
                data-track-location="cv"
              >
                {l.label}
              </a>
            </li>
          ))}
        </ul>
        <div class="no-print mt-8 flex flex-wrap items-center gap-3">
          <Button
            href="/cv.pdf"
            download
            size="lg"
            data-track="cv_pdf_download"
            data-track-source="cv_page"
          >
            {t('cv.download')}
          </Button>
          <Button
            variant="outline"
            size="lg"
            class="js-only"
            data-print
            data-track="cv_print"
          >
            {t('cv.print')}
          </Button>
        </div>
      </div>
    </div>

    {m.summary && (
      <Section
        id="summary"
        labelledby="summary-title"
        class="cv-section border-t border-rule py-10 md:py-12 lg:py-14"
      >
        <h2
          id="summary-title"
          class="col-span-12 mb-5 text-2xl md:col-span-3 md:mb-0"
        >
          {title.summary}
        </h2>
        <p
          class="col-span-12 max-w-measure md:col-span-9 lg:col-span-8"
          data-spec="type contrast"
        >
          {m.summary}
        </p>
      </Section>
    )}
    {m.experience.length > 0 && (
      <Section
        id="experience"
        labelledby="experience-title"
        class="cv-section border-t border-rule py-10 md:py-12 lg:py-14"
      >
        <h2
          id="experience-title"
          class="col-span-12 mb-5 text-2xl md:col-span-3 md:mb-0"
        >
          {title.experience}
        </h2>
        <ul class="col-span-12 max-w-measure md:col-span-9 lg:col-span-8">
          {m.experience.map((e) => (
            <CvEntry entry={e} />
          ))}
        </ul>
      </Section>
    )}
    {m.freelance && (
      <Section
        id="freelance"
        labelledby="freelance-title"
        class="cv-section border-t border-rule py-10 md:py-12 lg:py-14"
      >
        <h2
          id="freelance-title"
          class="col-span-12 mb-5 text-2xl md:col-span-3 md:mb-0"
        >
          {title.freelance}
        </h2>
        <p class="col-span-12 max-w-measure md:col-span-9 lg:col-span-8">
          {m.freelance}
        </p>
      </Section>
    )}
    {m.skills.length > 0 && (
      <Section
        id="skills"
        labelledby="skills-title"
        class="cv-section border-t border-rule py-10 md:py-12 lg:py-14"
      >
        <h2
          id="skills-title"
          class="col-span-12 mb-5 text-2xl md:col-span-3 md:mb-0"
        >
          {title.skills}
        </h2>
        <dl class="col-span-12 max-w-measure space-y-2 md:col-span-9 lg:col-span-8">
          {m.skills.map((g) => (
            <div class="sm:flex sm:gap-x-4">
              <dt class="font-semibold text-ink sm:w-36 sm:shrink-0">
                {g.name}
              </dt>
              <dd>{g.items.join(', ')}</dd>
            </div>
          ))}
        </dl>
      </Section>
    )}
    {m.education.length > 0 && (
      <Section
        id="education"
        labelledby="education-title"
        class="cv-section border-t border-rule py-10 md:py-12 lg:py-14"
      >
        <h2
          id="education-title"
          class="col-span-12 mb-5 text-2xl md:col-span-3 md:mb-0"
        >
          {title.education}
        </h2>
        <ul class="col-span-12 max-w-measure md:col-span-9 lg:col-span-8">
          {m.education.map((e) => (
            <CvEntry entry={e} />
          ))}
        </ul>
      </Section>
    )}
    {m.research.length > 0 && (
      <Section
        id="research"
        labelledby="research-title"
        class="cv-section border-t border-rule py-10 md:py-12 lg:py-14"
      >
        <h2
          id="research-title"
          class="col-span-12 mb-5 text-2xl md:col-span-3 md:mb-0"
        >
          {title.research}
        </h2>
        <ul class="col-span-12 max-w-measure md:col-span-9 lg:col-span-8">
          {m.research.map((e) => (
            <CvEntry entry={e} />
          ))}
        </ul>
      </Section>
    )}
    {m.languages.length > 0 && (
      <Section
        id="languages"
        labelledby="languages-title"
        class="cv-section border-t border-rule py-10 md:py-12 lg:py-14"
      >
        <h2
          id="languages-title"
          class="col-span-12 mb-5 text-2xl md:col-span-3 md:mb-0"
        >
          {title.languages}
        </h2>
        <p class="col-span-12 max-w-measure md:col-span-9 lg:col-span-8">
          {m.languages.join(', ')}
        </p>
      </Section>
    )}
    {m.projects.length > 0 && (
      <Section
        id="projects"
        labelledby="projects-title"
        class="cv-section border-t border-rule py-10 md:py-12 lg:py-14"
      >
        <h2
          id="projects-title"
          class="col-span-12 mb-5 text-2xl md:col-span-3 md:mb-0"
        >
          {title.projects}
        </h2>
        <ul class="col-span-12 max-w-measure md:col-span-9 lg:col-span-8">
          {m.projects.map((e) => (
            <CvEntry entry={e} />
          ))}
        </ul>
      </Section>
    )}
  </main>
</BaseLayout>

<script>
  for (const b of document.querySelectorAll('[data-print]')) {
    b.addEventListener('click', () => window.print());
  }
</script>
