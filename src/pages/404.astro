---
// 404 (FR-17): the status code set as type, a way home, gated section links, and a contact route.
// Search joins in Phase 4. The Dusk glow sits beside the numeral, never behind text.
import { tParts, t } from '@/i18n';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/site/Button.astro';
import DuskGlow from '@/components/site/DuskGlow.astro';
import { mailtoHref, whatsappHref } from '@/lib/contact';
import { getSettings } from '@/lib/content';
import { links } from '@/lib/routes';

const settings = await getSettings();
const sections = await links(['work', 'writing'], Astro.url.pathname);
const help = tParts('notFound.help');
---

<BaseLayout
  title={t('notFound.title')}
  description={t('notFound.description')}
  noindex
>
  <main id="main" class="wrap grid-page content-start pt-section">
    <p class="col-span-7 text-7xl font-semibold text-ink tabular-nums">
      {t('notFound.code')}
    </p>
    <div class="relative isolate col-span-4 col-start-9 aspect-square self-center">
      <DuskGlow class="[--dusk-inset:0%]" />
    </div>

    <h1 class="col-span-12 mt-10 text-4xl md:col-span-9 lg:col-span-8">
      {t('notFound.heading')}
    </h1>
    <p class="col-span-12 mt-5 max-w-measure text-lg md:col-span-7 lg:col-span-6">
      {t('notFound.body')}
    </p>

    <div class="col-span-12 mt-9 flex flex-wrap items-center gap-x-7 gap-y-4">
      <Button href="/">{t('notFound.home')}</Button>
      {sections.map((s) => (
        <a href={s.href} class="link text-lg text-ink">
          {s.label}
        </a>
      ))}
    </div>

    <p class="col-span-12 mt-12 max-w-measure border-t border-border pt-5 text-muted-foreground md:col-span-8 lg:col-span-7">
      {help.map((part) =>
        'text' in part ? (
          part.text
        ) : part.slot === 'whatsapp' ? (
          <a
            href={whatsappHref(settings.whatsappNumber)}
            class="link text-ink"
            target="_blank"
            rel="noopener noreferrer"
          >
            {t('whatsapp.cta')}
            <span class="sr-only"> {t('a11y.newTab')}</span>
          </a>
        ) : (
          <a
            href={mailtoHref(settings.email)}
            class="link text-ink"
            translate="no"
          >
            {settings.email}
          </a>
        ),
      )}
    </p>
  </main>
</BaseLayout>
