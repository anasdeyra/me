---
// /privacy: plain-language notice. Copy lives in i18n (privacy.*); [Draft] marks legal wording to confirm.
import { t, type Key } from '@/i18n';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { mailtoHref } from '@/lib/contact';
import { getSettings } from '@/lib/content';
import { countryName } from '@/lib/place';

const settings = await getSettings();
const { city, countryCode } = settings.location;
const vars = {
  name: settings.name,
  city,
  country: countryName(countryCode),
  email: settings.email,
};
const sections = [
  'who',
  'form',
  'analytics',
  'channels',
  'processors',
  'rights',
  'contact',
] as const;
const updated = new Intl.DateTimeFormat('en', { dateStyle: 'long' }).format(
  new Date('2026-11-16'),
);
---

<BaseLayout
  og="privacy"
  title={t('privacy.title')}
  description={t('privacy.description')}
>
  <main id="main" class="wrap grid-page content-start pt-section pb-section">
    <h1 class="col-span-12 text-5xl md:col-span-9">{t('privacy.heading')}</h1>
    <p class="col-span-12 mt-6 max-w-measure text-lg md:col-span-8">
      {t('privacy.intro')}
    </p>
    <p class="col-span-12 mt-2 text-sm text-muted-foreground">
      {t('privacy.updated', { date: updated })}
    </p>

    <div class="col-span-12 mt-12 md:col-span-9 lg:col-span-8">
      {sections.map((id) => (
        <section
          aria-labelledby={`privacy-${id}`}
          class="border-t border-rule py-6"
        >
          <h2 id={`privacy-${id}`} class="text-2xl">
            {t(`privacy.${id}.title` as Key)}
          </h2>
          <p class="mt-3 max-w-measure">
            {t(`privacy.${id}.body` as Key, vars)}
          </p>
          {id === 'contact' && (
            <p class="mt-3">
              <a
                href={mailtoHref(settings.email)}
                class="link text-ink"
                translate="no"
              >
                {settings.email}
              </a>
            </p>
          )}
        </section>
      ))}
    </div>
  </main>
</BaseLayout>
