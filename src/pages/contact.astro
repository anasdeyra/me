---
// /contact (FR-9): WhatsApp first (with a QR for desktop visitors), then email, the form and the other
// profiles. The page is the CTA, so the footer's closing CTA is off.
import { t } from '@/i18n';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContactForm from '@/components/site/ContactForm.astro';
import CopyEmail from '@/components/site/CopyEmail.astro';
import QrCode from '@/components/site/QrCode.astro';
import WhatsAppButton from '@/components/site/WhatsAppButton.astro';
import { formatPhone, whatsappHref, whatsappPrefill } from '@/lib/contact';
import { getSettings } from '@/lib/content';

const settings = await getSettings();
const prefilled = whatsappHref(
  settings.whatsappNumber,
  whatsappPrefill('contact'),
);
const row = 'col-span-12 grid grid-cols-subgrid border-t border-rule pt-6';
const rowTitle = 'col-span-12 text-xl font-semibold text-ink md:col-span-4';
---

<BaseLayout
  og="contact"
  title={t('contact.title')}
  description={t('contact.description')}
  footerCta={false}
>
  <main
    id="main"
    class="wrap grid-page content-start pt-section pb-section"
  >
    <h1 class="col-span-12 text-5xl md:col-span-9 lg:col-span-8">
      {t('contact.heading')}
    </h1>
    <div class="col-span-12 mt-6 max-w-measure space-y-4 text-lg md:col-span-7 lg:col-span-6">
      <p>{t('contact.intro')}</p>
      <p class="text-muted-foreground">{t('contact.hiring')}</p>
    </div>

    <div class="col-span-12 mt-14 grid grid-cols-subgrid gap-y-12">
      <section aria-labelledby="contact-whatsapp" class:list={[row, 'md:pb-8']}>
        <h2 id="contact-whatsapp" class={rowTitle}>
          {t('contact.whatsapp.title')}
        </h2>
        <div class="col-span-12 mt-4 md:col-span-5 md:mt-0">
          <WhatsAppButton
            size="lg"
            text={whatsappPrefill('contact')}
            trackLocation="contact"
          />
          <p class="mt-4 text-lg text-ink">
            {t('contact.whatsapp.number', {
              number: formatPhone(settings.whatsappNumber),
            })}
          </p>
          <p class="mt-1 text-sm text-muted-foreground">
            {t('contact.reply.whatsapp')}
          </p>
        </div>
        <div class="col-span-3 mt-4 hidden md:mt-0 md:block">
          <QrCode
            value={prefilled}
            label={t('contact.qr.label')}
            class="w-full max-w-32 border border-border p-2"
          />
          <p class="mt-3 text-sm text-muted-foreground">
            {t('contact.whatsapp.scan')}
          </p>
        </div>
      </section>

      <section aria-labelledby="contact-email" class={row}>
        <h2 id="contact-email" class={rowTitle}>
          {t('contact.email.title')}
        </h2>
        <div class="col-span-12 mt-4 md:col-span-8 md:mt-0">
          <CopyEmail email={settings.email} location="contact" />
          <p class="mt-2 text-sm text-muted-foreground">
            {t('contact.reply.email')}
          </p>
        </div>
      </section>

      <section aria-labelledby="contact-form" class={row}>
        <h2 id="contact-form" class={rowTitle}>
          {t('contact.form.title')}
        </h2>
        <div class="col-span-12 mt-4 md:col-span-6 md:mt-0">
          <p class="mb-6 text-muted-foreground">{t('contact.form.intro')}</p>
          <ContactForm location="contact" />
        </div>
      </section>

      <section aria-labelledby="contact-elsewhere" class={row}>
        <h2 id="contact-elsewhere" class={rowTitle}>
          {t('contact.elsewhere.title')}
        </h2>
        <p class="col-span-12 mt-4 flex flex-wrap gap-x-6 gap-y-2 text-lg md:col-span-8 md:mt-0">
          <a
            href={settings.links.linkedin}
            class="link text-ink"
            rel="me noopener noreferrer"
            target="_blank"
            data-track="contact_linkedin"
            data-track-location="contact"
          >
            {t('contact.linkedin')}
            <span class="sr-only"> {t('a11y.newTab')}</span>
          </a>
          <a
            href={settings.links.upwork}
            class="link text-ink"
            rel="me noopener noreferrer"
            target="_blank"
            data-track="upwork_click"
            data-track-location="contact"
          >
            {t('contact.upwork')}
            <span class="sr-only"> {t('a11y.newTab')}</span>
          </a>
        </p>
      </section>
    </div>
  </main>
</BaseLayout>
