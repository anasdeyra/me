---
// /blog (FR-5): every published post as a row, with the zero-JS type filter (radios + :has(), see global.css).
// Below the FR-22 threshold the page is an empty state and noindex (it never ships as a thin page).
import EntryRow from '@/components/blog/EntryRow.astro';
import Search from '@/components/site/Search.astro';
import WhatsAppButton from '@/components/site/WhatsAppButton.astro';
import { t } from '@/i18n';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { whatsappPrefill } from '@/lib/contact';
import { postEntry } from '@/lib/entries';
import { getPostViews, postTypes } from '@/lib/posts';
import { MIN_POSTS } from '@/lib/routes';
import { getSettings } from '@/lib/content';
import {
  personRefNode,
  breadcrumbNode,
  collectionPageNode,
} from '@/lib/schema';

const posts = await getPostViews();
const settings = await getSettings();
const gated = posts.length < MIN_POSTS;
const types = postTypes.filter((ty) => posts.some((p) => p.type === ty));
const url = new URL('/blog', Astro.site).href;
const home = new URL('/', Astro.site).href;
---

<BaseLayout
  og="blog"
  title={t('blog.title')}
  description={t('blog.description')}
  noindex={gated}
  schema={
    gated
      ? []
      : [
          collectionPageNode({
            url,
            name: t('blog.title'),
            description: t('blog.description'),
          }),
          breadcrumbNode([
            { name: t('work.breadcrumb.home'), url: home },
            { name: t('blog.title'), url },
          ]),
          personRefNode(settings),
        ]
  }
>
  <main id="main" class="work-scope">
    <section
      class="wrap grid-page pt-8 pb-section md:pt-14 lg:pt-20"
      aria-labelledby="blog-title"
    >
      <nav
        data-pagefind-ignore
        aria-label={t('work.breadcrumb.label')}
        class="col-span-12 mb-8 text-sm text-muted-foreground md:mb-12"
      >
        <ol class="flex flex-wrap items-center gap-x-2">
          <li>
            <a href="/" class="link">
              {t('work.breadcrumb.home')}
            </a>
          </li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-ink">
            {t('blog.title')}
          </li>
        </ol>
      </nav>
      <div class="col-span-12 lg:col-span-7">
        <p class="mb-3 text-sm font-medium text-muted-foreground">
          {t('blog.eyebrow')}
        </p>
        <h1 id="blog-title" class="text-5xl">
          {t('blog.title')}
        </h1>
      </div>
      <p class="col-span-12 mt-6 max-w-measure text-lg text-ink md:col-span-8 lg:col-span-5 lg:col-start-8 lg:mt-0 lg:self-end">
        {t('blog.intro')}
      </p>

      <Search class="col-span-12 mt-8" />

      {gated ? (
        <div class="col-span-12 mt-12 border-t border-rule pt-8 md:col-span-8 lg:col-span-6">
          <h2 class="text-2xl">{t('blog.empty.title')}</h2>
          <p class="mt-3 max-w-measure text-lg">{t('blog.empty.body')}</p>
          <WhatsAppButton
            size="lg"
            text={whatsappPrefill('contact')}
            trackLocation="blog"
            class="mt-6"
          />
        </div>
      ) : (
        <div class="col-span-12 mt-12 md:mt-16">
          {types.length > 1 && (
            <fieldset class="work-filter mb-8 md:mb-12" data-pagefind-ignore>
              <legend class="sr-only">{t('blog.filter.legend')}</legend>
              <input
                type="radio"
                name="blog-type"
                id="f-all"
                checked
                data-track="filter_chip"
                data-track-page="blog"
                data-track-type="all"
              />
              <label for="f-all">{t('blog.filter.all')}</label>
              {types.map((ty) => (
                <>
                  <input
                    type="radio"
                    name="blog-type"
                    id={`f-${ty}`}
                    data-track="filter_chip"
                    data-track-page="blog"
                    data-track-type={ty}
                  />
                  <label for={`f-${ty}`}>{t(`blog.type.${ty}`)}</label>
                </>
              ))}
            </fieldset>
          )}
          <ul class="border-b border-border" data-pagefind-ignore>
            {posts.map((p) => (
              <li class="work-card" data-type={p.type}>
                <EntryRow entry={postEntry(p)} headingLevel={2} showTags />
              </li>
            ))}
          </ul>
        </div>
      )}
    </section>
  </main>
</BaseLayout>
