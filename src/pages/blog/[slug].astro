---
// /blog/[slug] (study 6.3): an editorial post. 68ch body, sticky ToC for articles with three or more H2s,
// series navigation, an end-of-post CTA by pillar, related entries. Zero JS.
import { Image } from 'astro:assets';
import EndCta from '@/components/blog/EndCta.astro';
import EntryRow from '@/components/blog/EntryRow.astro';
import PostProgress from '@/components/blog/PostProgress.astro';
import PostMeta from '@/components/blog/PostMeta.astro';
import SeriesNav from '@/components/blog/SeriesNav.astro';
import ShareLink from '@/components/blog/ShareLink.astro';
import TagChips from '@/components/blog/TagChips.astro';
import Toc from '@/components/blog/Toc.astro';
import { t } from '@/i18n';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  getPostBySlug,
  getPostViews,
  getRelatedEntries,
  getRelatedProject,
  getSeries,
  resolveCta,
} from '@/lib/posts';
import { getSettings } from '@/lib/content';
import { breadcrumbNode, blogPostingNode, personRefNode } from '@/lib/schema';
import { tagLinks } from '@/lib/tags';

export async function getStaticPaths() {
  const views = await getPostViews();
  return views.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const { view: post, html, headings } = (await getPostBySlug(slug!))!;
const [series, related, tags] = await Promise.all([
  getSeries(post),
  getRelatedEntries(post, 3),
  tagLinks(post.tags),
]);
const settings = await getSettings();
const variant = resolveCta(post);
const relatedProject =
  variant === 'project' ? await getRelatedProject(post) : undefined;

// ToC rule (D2): articles with at least three H2s only.
const showToc =
  post.type === 'article' && headings.filter((h) => h.level === 2).length >= 3;

const url = new URL(post.href, Astro.site).href;
const cover = post.cover;
const crumbs = [
  { name: t('work.breadcrumb.home'), url: new URL('/', Astro.site).href },
  { name: t('blog.title'), url: new URL('/blog', Astro.site).href },
  { name: post.title, url },
];
---

<BaseLayout
  og={`blog/${post.slug}`}
  title={post.title}
  description={post.description}
  type="article"
  footerCta={false}
  canonical={post.canonicalUrl}
  publishedTime={post.date}
  modifiedTime={post.updated}
  articleTags={post.tags.map((tag) => tag.label)}
  schema={[
    blogPostingNode({
      url,
      title: post.title,
      description: post.description,
      datePublished: post.date,
      dateModified: post.updated ?? post.date,
      image: new URL(`/og/blog/${post.slug}.png`, Astro.site).href,
      tags: post.tags.map((tag) => tag.label),
    }),
    breadcrumbNode(crumbs),
    personRefNode(settings),
  ]}
>
  <PostProgress />
  <main id="main" class="post-page">
    <article class="wrap grid-page pt-8 md:pt-14 lg:pt-20">
      <nav
        data-pagefind-ignore
        aria-label={t('work.breadcrumb.label')}
        class="col-span-12 mb-8 text-sm text-muted-foreground md:mb-12"
      >
        <ol class="flex flex-wrap items-center gap-x-2">
          <li>
            <a href="/" class="link">
              {crumbs[0].name}
            </a>
          </li>
          <li aria-hidden="true">/</li>
          <li>
            <a href="/blog" class="link">
              {crumbs[1].name}
            </a>
          </li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-ink">
            {post.title}
          </li>
        </ol>
      </nav>

      <div class="col-span-12 grid grid-cols-subgrid gap-y-6">
        <PostMeta post={post} class="col-span-12" />
        <h1 class="col-span-12 text-5xl lg:col-span-9">{post.title}</h1>
        <p class="col-span-12 max-w-measure text-lg text-ink md:col-span-9 lg:col-span-7">
          {post.description}
        </p>
        <TagChips tags={tags} class="col-span-12" />
      </div>

      {cover && (
        <figure class="col-span-12 mt-12">
          <Image
            src={cover.image}
            alt={cover.alt}
            width={1600}
            height={900}
            widths={[640, 960, 1280, 1600]}
            sizes="(min-width: 1440px) 1280px, 100vw"
            loading="eager"
            fetchpriority="high"
            class="aspect-video w-full rounded-[var(--radius)] border border-border object-cover"
          />
        </figure>
      )}

      <div class="col-span-12 mt-12 grid grid-cols-subgrid gap-y-8 lg:mt-16">
        {showToc && (
          <Toc
            headings={headings}
            variant="aside"
            class="lg:col-span-3 lg:col-start-1 lg:row-start-1"
          />
        )}
        <div class="col-span-12 lg:col-span-7 lg:col-start-5 lg:row-start-1">
          {showToc && (
            <Toc headings={headings} variant="details" class="mb-10" />
          )}
          <div class="prose-site text-lg" set:html={html} />

          {series && <SeriesNav series={series} class="mt-16" />}

          <p class="mt-10" data-pagefind-ignore>
            <ShareLink url={url} slug={post.slug} />
          </p>
        </div>
      </div>
    </article>

    {variant !== 'none' && (
      <div class="wrap grid-page pt-section">
        <div class="col-span-12 lg:col-span-7 lg:col-start-5">
          <EndCta
            post={post}
            variant={variant}
            relatedProject={relatedProject}
          />
        </div>
      </div>
    )}

    {related.length > 0 ? (
      <section
        data-pagefind-ignore
        aria-labelledby="related-title"
        class="no-print wrap grid-page pt-section pb-section"
      >
        <div class="col-span-12 mb-8 lg:col-span-4 lg:mb-0">
          <h2 id="related-title" class="text-2xl">
            {t('blog.related')}
          </h2>
          <p class="mt-4">
            <a href="/blog" class="link text-ink">
              {t('blog.back')}
            </a>
          </p>
        </div>
        <ul class="col-span-12 border-b border-border lg:col-span-7 lg:col-start-5">
          {related.map((e) => (
            <li>
              <EntryRow entry={e} headingLevel={3} />
            </li>
          ))}
        </ul>
      </section>
    ) : (
      <div
        class="no-print wrap grid-page pt-10 pb-section"
        data-pagefind-ignore
      >
        <p class="col-span-12 lg:col-span-7 lg:col-start-5">
          <a href="/blog" class="link text-ink">
            {t('blog.back')}
          </a>
        </p>
      </div>
    )}
  </main>
</BaseLayout>
