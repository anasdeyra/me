---
// /work (FR-4): every project as a card, with a zero-JS type filter (radios + :has(), see global.css).
// Below the FR-22 threshold the page is an empty state and noindex (it never ships as a thin page).
import ProjectCard from '@/components/work/ProjectCard.astro';
import WhatsAppButton from '@/components/site/WhatsAppButton.astro';
import { t } from '@/i18n';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { whatsappPrefill } from '@/lib/contact';
import { getProjectViews, projectTypes } from '@/lib/projects';
import { MIN_PROJECTS } from '@/lib/routes';
import { getSettings } from '@/lib/content';
import {
  personRefNode,
  breadcrumbNode,
  collectionPageNode,
} from '@/lib/schema';

const projects = await getProjectViews();
const settings = await getSettings();
const gated = projects.length < MIN_PROJECTS;
const types = projectTypes.filter((ty) => projects.some((p) => p.type === ty));
const url = new URL('/work', Astro.site).href;
const home = new URL('/', Astro.site).href;
---

<BaseLayout
  og="work"
  title={t('work.title')}
  description={t('work.description')}
  noindex={gated}
  schema={
    gated
      ? []
      : [
          collectionPageNode({
            url,
            name: t('work.title'),
            description: t('work.description'),
          }),
          breadcrumbNode([
            { name: t('work.breadcrumb.home'), url: home },
            { name: t('work.title'), url },
          ]),
          personRefNode(settings),
        ]
  }
>
  <main id="main" class="work-scope">
    <section
      class="wrap grid-page pt-8 pb-section md:pt-14 lg:pt-20"
      aria-labelledby="work-title"
    >
      <nav
        aria-label={t('work.breadcrumb.label')}
        class="col-span-12 mb-8 text-sm text-muted-foreground md:mb-12"
      >
        <ol class="flex flex-wrap items-center gap-x-2">
          <li>
            <a href="/" class="link">
              {t('work.breadcrumb.home')}
            </a>
          </li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-ink">
            {t('work.title')}
          </li>
        </ol>
      </nav>
      <div class="col-span-12 lg:col-span-7">
        <p class="mb-3 text-sm font-medium text-muted-foreground">
          {t('work.eyebrow')}
        </p>
        <h1 id="work-title" class="text-5xl">
          {t('work.title')}
        </h1>
      </div>
      <p class="col-span-12 mt-6 max-w-measure text-lg text-ink md:col-span-8 lg:col-span-5 lg:col-start-8 lg:mt-0 lg:self-end">
        {t('work.intro')}
      </p>

      {gated ? (
        <div class="col-span-12 mt-16 md:col-span-8 lg:col-span-6">
          <h2 class="text-2xl">{t('work.empty.title')}</h2>
          <p class="mt-3 max-w-measure text-lg">{t('work.empty.body')}</p>
          <WhatsAppButton
            size="lg"
            text={whatsappPrefill('contact')}
            trackLocation="work"
            class="mt-6"
          />
        </div>
      ) : (
        <div class="col-span-12 mt-12 md:mt-16">
          {types.length > 1 && (
            <fieldset class="work-filter mb-8 md:mb-12">
              <legend class="sr-only">{t('work.filter.legend')}</legend>
              <input
                type="radio"
                name="work-type"
                id="f-all"
                checked
                data-track="filter_chip"
                data-track-page="work"
                data-track-type="all"
              />
              <label for="f-all">{t('work.filter.all')}</label>
              {types.map((ty) => (
                <>
                  <input
                    type="radio"
                    name="work-type"
                    id={`f-${ty}`}
                    data-track="filter_chip"
                    data-track-page="work"
                    data-track-type={ty}
                  />
                  <label for={`f-${ty}`}>{t(`work.type.${ty}`)}</label>
                </>
              ))}
            </fieldset>
          )}
          <ul class="grid gap-x-gutter gap-y-14 sm:grid-cols-2">
            {projects.map((p, i) => (
              <li class="reveal work-card" data-type={p.type}>
                <ProjectCard
                  project={p}
                  headingLevel={2}
                  priority={i < 2}
                  class="h-full"
                />
              </li>
            ))}
          </ul>
        </div>
      )}
    </section>
  </main>
</BaseLayout>
