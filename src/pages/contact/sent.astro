---
// Result page after a successful no-JS form post (the endpoint 303s here). Static, noindex.
import { t } from '@/i18n';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/site/Button.astro';
import WhatsAppButton from '@/components/site/WhatsAppButton.astro';
import { whatsappPrefill } from '@/lib/contact';
---

<BaseLayout
  title={t('contact.sent.title')}
  description={t('contact.sent.description')}
  noindex
  spec={false}
  footerCta={false}
>
  <main id="main" class="wrap grid-page content-start pt-section pb-section">
    <h1 class="col-span-12 text-5xl md:col-span-9 lg:col-span-8">
      {t('contact.sent.heading')}
    </h1>
    <p class="col-span-12 mt-6 max-w-measure text-lg md:col-span-7 lg:col-span-6">
      {t('contact.sent.body')}
    </p>
    <div class="col-span-12 mt-9 flex flex-wrap items-center gap-x-6 gap-y-4">
      <WhatsAppButton
        size="lg"
        text={whatsappPrefill('contact')}
        trackLocation="contact_sent"
      />
      <Button href="/" variant="outline" size="lg">
        {t('contact.sent.home')}
      </Button>
    </div>
  </main>
</BaseLayout>
