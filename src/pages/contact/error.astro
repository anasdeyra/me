---
// Result page when the form could not send (the endpoint 303s here). Static, noindex, with fallbacks.
import { t } from '@/i18n';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CopyEmail from '@/components/site/CopyEmail.astro';
import WhatsAppButton from '@/components/site/WhatsAppButton.astro';
import { whatsappPrefill } from '@/lib/contact';
import { getSettings } from '@/lib/content';

const settings = await getSettings();
---

<BaseLayout
  title={t('contact.error.title')}
  description={t('contact.error.description')}
  noindex
  spec={false}
  footerCta={false}
>
  <main id="main" class="wrap grid-page content-start pt-section pb-section">
    <h1 class="col-span-12 text-5xl md:col-span-9 lg:col-span-8">
      {t('contact.error.heading')}
    </h1>
    <p class="col-span-12 mt-6 max-w-measure text-lg md:col-span-7 lg:col-span-6">
      {t('contact.error.body')}
    </p>
    <div class="col-span-12 mt-9 flex flex-wrap items-center gap-x-6 gap-y-4">
      <CopyEmail email={settings.email} location="contact_error" />
      <WhatsAppButton
        size="lg"
        text={whatsappPrefill('contact')}
        trackLocation="contact_error"
      />
      <a href="/contact" class="link text-lg text-ink">
        {t('contact.error.back')}
      </a>
    </div>
  </main>
</BaseLayout>
