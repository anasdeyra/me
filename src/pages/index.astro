---
// Home (study 6.1). Sections 3, 4 (Phase 3) and 10 (Phase 4) are gated by isSectionLive and added later.
import AboutTeaser from '@/components/home/AboutTeaser.astro';
import Faq from '@/components/home/Faq.astro';
import LatestWriting from '@/components/home/LatestWriting.astro';
import Hero from '@/components/home/Hero.astro';
import HeroShapeStyle from '@/components/home/HeroShapeStyle.astro';
import Process from '@/components/home/Process.astro';
import ReviewLoopStyle from '@/components/proof/ReviewLoopStyle.astro';
import Proof from '@/components/home/Proof.astro';
import SelectedWork from '@/components/home/SelectedWork.astro';
import Services from '@/components/home/Services.astro';
import Statement from '@/components/home/Statement.astro';
import ContactBlock from '@/components/site/ContactBlock.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getImage } from 'astro:assets';
import { contentImage, getProfile, getSettings } from '@/lib/content';
import { isSectionLive } from '@/lib/routes';
import { personNode, websiteNode } from '@/lib/schema';

const [settings, profile] = await Promise.all([getSettings(), getProfile()]);
// The portrait shown in the hero (same options as Hero.astro, so the file is shared).
const photo = contentImage('en/profile', profile.photo);
const portrait = photo
  ? new URL(
      (await getImage({ src: photo, width: 700, height: 875 })).src,
      Astro.site,
    ).href
  : undefined;
const proofLive = await isSectionLive('proof');
// How the proof map plays its reviews: 'loop' (timed, zero JS) or 'scroll' (pinned, one review per scroll step;
// preview at /lab/proof in dev). Used by the section and its generated head style, so set it here only.
const reviewPlayback: 'loop' | 'scroll' = 'loop';
---

<BaseLayout
  schema={[
    websiteNode(settings, { withPublisher: true }),
    personNode(settings, profile, { image: portrait }),
  ]}
  footerCta={false}
>
  <HeroShapeStyle slot="head" />
  {proofLive && (
    <ReviewLoopStyle slot="head" uid="proof" playback={reviewPlayback} />
  )}
  <main id="main">
    <Hero />
    <Statement />
    <SelectedWork />
    <Proof playback={reviewPlayback} />
    <Services />
    <Process />
    <AboutTeaser />
    <Faq />
    <LatestWriting />
    <ContactBlock location="final" headingId="final-cta-title" form />
  </main>
</BaseLayout>
