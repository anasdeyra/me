---
// /about (FR-8): who, how I work, languages, research, human details, then the two doors (WhatsApp, CV).
// Long text comes from Keystatic markdoc fields rendered at build time (src/lib/markdoc.ts).
import { getImage, Image } from 'astro:assets';
import ClientsMapStyle from '@/components/proof/ClientsMapStyle.astro';
import ClientsMap from '@/components/proof/ClientsMap.astro';
import Button from '@/components/site/Button.astro';
import DuskGlow from '@/components/site/DuskGlow.astro';
import Section from '@/components/site/Section.astro';
import SpecHook from '@/components/site/SpecHook.astro';
import WhatsAppButton from '@/components/site/WhatsAppButton.astro';
import { t } from '@/i18n';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { whatsappPrefill } from '@/lib/contact';
import { contentImage, getProfile, getSettings } from '@/lib/content';
import { renderMarkdoc } from '@/lib/markdoc';
import { languageList } from '@/lib/place';
import { getResearchHref } from '@/lib/projects';
import { isLive, isSectionLive } from '@/lib/routes';
import { endorsementTally } from '@/lib/proof';
import { personNode, profilePageNode } from '@/lib/schema';

const [settings, profile] = await Promise.all([getSettings(), getProfile()]);
const [bio, howIWork] = await Promise.all([
  renderMarkdoc(profile.longBio),
  renderMarkdoc(profile.howIWork),
]);
const photo = contentImage('en/profile', profile.photo);
const portrait = photo
  ? new URL(
      (await getImage({ src: photo, width: 700, height: 875 })).src,
      Astro.site,
    ).href
  : undefined;
const languages = languageList(settings.languages.map((l) => l.code));
const researchHref = (await isLive('work'))
  ? await getResearchHref()
  : undefined;
const facts = profile.facts ?? [];
const endorsements = await endorsementTally();
const cvLive = await isLive('cv');
const clientsLive = await isSectionLive('clients');
const heading = t('about.heading', { name: settings.name });
const pageUrl = new URL('/about', Astro.site).href;
const h2 = 'reveal col-span-12 mb-5 text-2xl md:col-span-3 md:mb-0';
const body = 'reveal col-span-12 [--i:1] md:col-span-9 lg:col-span-7';
---

<BaseLayout
  og="about"
  title={t('about.title')}
  description={t('about.description')}
  type="profile"
  schema={[
    personNode(settings, profile, { image: portrait }),
    profilePageNode(settings, profile, {
      url: pageUrl,
      name: heading,
      description: t('about.description'),
    }),
  ]}
  footerCta={false}
>
  {clientsLive && <ClientsMapStyle slot="head" />}
  <main id="main">
    <section
      data-spec="spacing grid"
      class="wrap grid-page pt-8 pb-12 md:pt-14 md:pb-16 lg:grid-rows-[auto_auto_1fr] lg:pt-20 lg:pb-20"
    >
      <h1
        class="col-span-12 text-5xl lg:col-span-7"
        data-spec="type:text-5xl contrast"
      >
        {heading}
      </h1>
      <p class="col-span-12 mt-5 text-lg text-ink md:mt-7 lg:col-span-7">
        {profile.shortBio}
      </p>

      {photo && (
        <div class="relative isolate col-span-8 mt-12 sm:col-span-6 md:col-span-5 md:col-start-8 lg:col-span-4 lg:col-start-9 lg:row-span-3 lg:row-start-1 lg:mt-0 lg:self-start">
          <DuskGlow />
          <Image
            src={photo}
            alt={profile.photoAlt}
            width={700}
            height={875}
            widths={[360, 540, 700]}
            sizes="(min-width: 1024px) 30vw, (min-width: 640px) 50vw, 66vw"
            loading="eager"
            fetchpriority="high"
            data-spec="image"
            class="aspect-[4/5] h-auto w-full rounded-md object-cover"
          />
        </div>
      )}

      <div
        class="prose-site col-span-12 mt-12 lg:col-span-7 lg:mt-8"
        set:html={bio}
      />
    </section>

    {howIWork && (
      <Section
        id="how-i-work"
        labelledby="how-title"
        class="border-t border-rule py-12 md:py-16 lg:py-20"
      >
        <h2 id="how-title" class={h2}>
          {t('about.howIWork')}
        </h2>
        <div class:list={[body, 'prose-site']} set:html={howIWork} />
      </Section>
    )}

    <Section
      id="languages"
      labelledby="languages-title"
      class="border-t border-rule py-12 md:py-16 lg:py-20"
    >
      <h2 id="languages-title" class={h2}>
        {t('about.languages')}
      </h2>
      <p class:list={[body, 'text-lg']}>
        {t('about.languagesBody', { languages })}
      </p>
    </Section>

    {profile.researchSummary && (
      <Section
        id="research"
        labelledby="research-title"
        class="border-t border-rule py-12 md:py-16 lg:py-20"
      >
        <h2 id="research-title" class={h2}>
          {t('about.research')}
        </h2>
        <div class={body}>
          <p class="text-lg">{profile.researchSummary}</p>
          {researchHref && (
            <p class="mt-5">
              <a href={researchHref} class="link text-ink">
                {t('about.researchLink')}
              </a>
            </p>
          )}
        </div>
      </Section>
    )}

    {endorsements.length > 0 && (
      <Section
        id="endorsements"
        labelledby="endorsements-title"
        class="border-t border-rule py-12 md:py-16 lg:py-20"
      >
        <h2 id="endorsements-title" class={h2}>
          {t('about.endorsements')}
        </h2>
        <ul
          class:list={[
            body,
            'flex flex-wrap content-start items-start gap-x-3 gap-y-3',
          ]}
        >
          {endorsements.map((e) => (
            <li class="chip text-sm text-ink">
              {e.label}
              <span class="ms-2 tabular-nums">×{e.count}</span>
            </li>
          ))}
        </ul>
      </Section>
    )}

    {clientsLive && (
      <Section
        id="clients"
        labelledby="clients-title"
        class="border-t border-rule py-12 md:py-16 lg:py-20"
      >
        <h2 id="clients-title" class={h2}>
          {t('about.clients')}
        </h2>
        <div class="col-span-12 md:col-span-9 lg:col-span-9">
          <ClientsMap variant="compact" />
        </div>
      </Section>
    )}

    {facts.length > 0 && (
      <Section
        id="facts"
        labelledby="facts-title"
        class="border-t border-rule py-12 md:py-16 lg:py-20"
      >
        <h2 id="facts-title" class={h2}>
          {t('about.facts')}
        </h2>
        <dl
          class:list={[body, 'divide-y divide-border border-y border-border']}
        >
          {facts.map((f) => (
            <div class="grid gap-x-gutter gap-y-1 py-4 sm:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
              <dt class="text-muted-foreground">{f.label}</dt>
              <dd class="text-ink">{f.value}</dd>
            </div>
          ))}
        </dl>
      </Section>
    )}

    <Section
      id="colophon"
      data-pagefind-ignore
      labelledby="colophon-title"
      class="js-only border-t border-rule py-12 md:py-16 lg:py-20"
    >
      <h2 id="colophon-title" class={h2}>
        {t('spec.colophon.title')}
      </h2>
      <div class={body}>
        <p class="text-lg">{t('spec.colophon.body')}</p>
        <SpecHook class="mt-5 text-lg text-ink" />
      </div>
    </Section>

    <Section
      id="contact"
      labelledby="about-cta-title"
      class="border-t border-rule py-12 md:py-16 lg:py-20"
    >
      <h2 id="about-cta-title" class={h2}>
        {t('about.ctaTitle')}
      </h2>
      <div class={body}>
        <p class="text-lg">{t('about.ctaBody')}</p>
        <div class="mt-7 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center">
          <WhatsAppButton
            size="lg"
            text={whatsappPrefill('about')}
            trackLocation="about"
          />
          {cvLive && (
            <Button
              href="/cv"
              variant="outline"
              size="lg"
              data-track="cv_view"
              data-track-source="about"
            >
              {t('cta.viewCv')}
            </Button>
          )}
        </div>
      </div>
    </Section>
  </main>
</BaseLayout>
