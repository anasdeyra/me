---
import '@/styles/global.css';
import { Font } from 'astro:assets';
import JsonLd from '@/components/seo/JsonLd.astro';
import SiteFooter from '@/components/layout/SiteFooter.astro';
import SiteHeader from '@/components/layout/SiteHeader.astro';
import Analytics from '@/components/site/Analytics.astro';
import SpecToggle from '@/components/site/SpecToggle.astro';
import ThemeScript from '@/components/site/ThemeScript.astro';
import { defaultLocale, t } from '@/i18n';
import { getProfile, getSettings } from '@/lib/content';
import { schemaIds, websiteRefNode, type SchemaNode } from '@/lib/schema';
import { isLive } from '@/lib/routes';
import { canonicalUrl } from '@/lib/seo';
import { THEME_COLOR } from '@/lib/theme';

interface Props {
  /** Page name, e.g. "Work". Omit on the home page, which uses the full-name title. */
  title?: string;
  /** Meta description; defaults to the profile short bio. */
  description?: string;
  /** Override for the social card (e.g. a project hero). Wins over `og`. */
  image?: { src: string; alt: string; width?: number; height?: number };
  /** Key of a generated card in src/lib/og-entries.ts (`default`, `about`, `blog/<slug>`...). */
  og?: string;
  type?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  /** JSON-LD nodes for this page's @graph (see src/lib/schema.ts). */
  schema?: SchemaNode[];
  /** Closing CTA above the footer. Off on the home page, which has its own final CTA section. */
  footerCta?: boolean;
  /** Vercel Web Analytics + [data-track] events (production only). Turn off for pages that should not be measured. */
  tracking?: boolean;
  /** Spec mode toggle (bottom-end). Off on the noindex result pages. */
  spec?: boolean;
  /** Canonical URL override (a post first published elsewhere). OG url stays on this page. */
  canonical?: string;
  /** Article meta (`type="article"`): `YYYY-MM-DD` dates and topic labels. */
  publishedTime?: string;
  modifiedTime?: string;
  articleTags?: string[];
}

const settings = await getSettings();
const profile = await getProfile();
const {
  title,
  description = profile.shortBio,
  image,
  og = 'default',
  type = 'website',
  noindex = false,
  schema = [],
  footerCta = true,
  tracking = true,
  spec = true,
  canonical: canonicalOverride,
  publishedTime,
  modifiedTime,
  articleTags = [],
} = Astro.props;

const lang = Astro.currentLocale ?? defaultLocale;
const fullTitle = title
  ? t('seo.title', { page: title, brand: settings.brand })
  : t('seo.homeTitle', { name: settings.name });
const pageUrl = canonicalUrl(Astro.url.pathname, Astro.site!);
const card = image ?? {
  src: `/og/${og}.png`,
  alt: t('og.alt', { title: title ?? settings.name }),
  width: 1200,
  height: 630,
};
const imageUrl = new URL(card.src, Astro.site).href;
const rssLive = await isLive('rss');
// Every node that points at the WebSite by @id can resolve it inside its own page graph: pages other than the home
// (which defines the full node) get a stub with the same @id.
const graph =
  schema.length > 0 && !schema.some((n) => n['@id'] === schemaIds.website)
    ? [websiteRefNode(settings), ...schema]
    : schema;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content={THEME_COLOR.light}
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content={THEME_COLOR.dark}
    />
    <ThemeScript />
    {tracking && <Analytics />}
    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-geist-mono" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonicalOverride ?? pageUrl} />}
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {rssLive && (
      <link
        rel="alternate"
        type="application/rss+xml"
        title={t('rss.title', { brand: settings.brand })}
        href="/rss.xml"
      />
    )}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={settings.brand} />
    <meta property="og:locale" content={t('seo.ogLocale')} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {type === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {type === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}
    {type === 'article' &&
      articleTags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={card.alt} />
    {card.width && (
      <meta property="og:image:width" content={String(card.width)} />
    )}
    {card.height && (
      <meta property="og:image:height" content={String(card.height)} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={card.alt} />

    <slot name="head" />
    {graph.length > 0 && <JsonLd graph={graph} />}
  </head>
  <body class="grid min-h-dvh grid-rows-[auto_1fr_auto]">
    <a
      href="#main"
      class="sr-only z-50 bg-primary text-sm font-medium text-primary-foreground focus:not-sr-only focus:fixed focus:start-4 focus:top-2 focus:z-50 focus:inline-flex focus:min-h-11 focus:items-center focus:px-4 focus:py-3"
    >
      {t('a11y.skipToContent')}
    </a>
    <SiteHeader />
    <slot />
    <SiteFooter cta={footerCta} spec={spec} />
    {spec && <SpecToggle />}
    <script>
      import '@/scripts/pointer';
    </script>
  </body>
</html>
