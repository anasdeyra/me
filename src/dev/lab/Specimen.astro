---
// Dev-only specimen: a slice of the planned site built from real study content.
// Copy marked (draft) or (sample) is placeholder and not final.
import type { SlotName } from './presets';

interface Props {
  name: SlotName;
}
const { name } = Astro.props;
const id = (s: string) => `${name.toLowerCase()}-${s}`;
---

<div class="frame-wrap" data-frame-wrap={name}>
  <p class="frame-label" data-frame-label={name}>{name}</p>
  <div class="frame">
    <div class="spec-root" data-specimen={name} data-dir="swiss" data-theme="light">
      <header class="s-header s-ruled">
        <a class="s-wordmark" href="#top">Anas Deyra</a>
        <nav class="s-nav" aria-label="Main">
          <ul>
            <li><a href="#work">Work</a></li>
            <li><a href="#writing">Writing</a></li>
            <li><a href="#about">About</a></li>
            <li><a href="#cv">CV</a></li>
          </ul>
        </nav>
        <div class="s-header-actions">
          <button class="s-icon-btn" type="button" aria-label="Switch theme">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
              ><circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="1.5"
              ></circle><path d="M12 4a8 8 0 0 1 0 16Z" fill="currentColor"></path></svg
            >
          </button>
          <a class="s-btn s-btn-primary s-btn-sm" href="#contact">
            <span>WhatsApp</span>
          </a>
          <button class="s-menu-btn" type="button">Menu</button>
        </div>
      </header>

      <section class="s-hero">
        <h1 class="s-h1">Polished software for startup founders</h1>
        <p class="s-lead">
          Full-stack engineer in Tunis. I design and build MVPs, new features and marketing sites
          that load fast, work for everyone and stay secure from the first release.
        </p>
        <div class="s-actions">
          <a class="s-btn s-btn-primary" href="#contact"><span>Message me on WhatsApp</span></a>
          <a class="s-btn s-btn-secondary" href="#cv"><span>Hiring? View my CV</span></a>
        </div>
        <ul class="s-trust" aria-label="Upwork record">
          <li><strong>Top Rated</strong><span>on Upwork</span></li>
          <li><strong>100%</strong><span>Job Success</span></li>
          <li><strong>5.0</strong><span>from 5 reviews</span></li>
          <li><strong>7</strong><span>client countries</span></li>
        </ul>
      </section>

      <section class="s-section s-ruled">
        <h2 class="s-h2">Selected work</h2>
        <div class="s-body">
          <div class="s-cards">
            <article class="s-card">
              <span class="s-chip">Client</span>
              <h3 class="s-h3">ArtBeat</h3>
              <p>Web3 artwork marketplace with smart contracts.</p>
              <p class="s-metric">
                <span class="s-metric-value">1.2 s</span>
                <span class="s-metric-label">Largest Contentful Paint (sample)</span>
              </p>
              <ul class="s-stack" aria-label="Stack">
                <li>React</li><li>Node.js</li><li>Solidity</li>
              </ul>
            </article>
            <article class="s-card">
              <span class="s-chip">Research</span>
              <h3 class="s-h3">Information systems research</h3>
              <p>Placeholder for the first published research project.</p>
              <p class="s-metric">
                <span class="s-metric-value">2026</span>
                <span class="s-metric-label">Ongoing</span>
              </p>
              <ul class="s-stack" aria-label="Topics">
                <li>Information Systems</li><li>Research Master's</li>
              </ul>
            </article>
          </div>
        </div>
      </section>

      <section class="s-section s-ruled">
        <h2 class="s-h2">What clients say</h2>
        <div class="s-body s-quotes">
          <figure class="s-quote s-quote-lg">
            <blockquote>
              <p>“I really think you have a superpower around front-end”</p>
            </blockquote>
            <figcaption>Upwork client, React form app</figcaption>
          </figure>
          <figure class="s-quote">
            <blockquote>
              <p>
                “Anas has a solid understanding of current development best practices… I would
                happily recommend Anas for any (Full-stack) web development project!”
              </p>
            </blockquote>
            <figcaption>
              <span class="s-quote-project">Solana NFT marketplace (React, Metaplex)</span>
              <span class="s-quote-meta">
                <span>Upwork client</span>
                <span class="s-stars" aria-label="Rated 5.0 out of 5">★ 5.0</span>
                <span class="s-chip s-chip-accent">Committed to Quality</span>
                <a href="#upwork">Verified on Upwork</a>
              </span>
            </figcaption>
          </figure>
        </div>
      </section>

      <section class="s-section s-ruled">
        <h2 class="s-h2">How we work</h2>
        <div class="s-body">
          <ol class="s-steps">
            <li>
              <h3 class="s-h4">Chat on WhatsApp or a call</h3>
              <p>Tell me what you are building. I usually reply within an hour.</p>
            </li>
            <li>
              <h3 class="s-h4">Scope and quote</h3>
              <p>You get a written scope, a quote and a timeline before any work starts.</p>
            </li>
            <li>
              <h3 class="s-h4">Build with weekly updates</h3>
              <p>Progress every week, with performance and accessibility checked as we go.</p>
            </li>
            <li>
              <h3 class="s-h4">Launch and handover</h3>
              <p>You own the code, the accounts and the docs. Support continues if you need it.</p>
            </li>
          </ol>
          <p class="s-note">Process copy is a draft.</p>
        </div>
      </section>

      <section class="s-section s-ruled s-article">
        <h2 class="s-h2">Writing</h2>
        <div class="s-body s-prose">
          <p class="s-meta">
            <span class="s-chip">Article</span>
            <time datetime="2026-11-12">12 Nov 2026</time>
            <span>6 min read</span>
          </p>
          <h3 class="s-h2b">The performance budget I set on every project</h3>
          <p class="s-lead">
            A budget turns “fast” into a number the whole team can check on every pull request.
          </p>
          <p>
            Before the first commit, I agree three limits with the client: page weight, JavaScript
            before interaction, and <a href="#lcp">Largest Contentful Paint</a> on a mid-range
            phone. They live in the repository as <code>budget.json</code>, so the build fails when a
            change breaks them.
          </p>
          <h4 class="s-h3">Measure on the slowest device you support</h4>
          <p>
            A fast laptop on office Wi‑Fi hides most problems. I test on a throttled 4G profile with
            a 4× CPU slowdown, which is closer to what many of your users actually have.
          </p>
          <ul>
            <li>HTML and CSS under 60 KB compressed</li>
            <li>Under 5 KB of JavaScript before interaction</li>
            <li>LCP under 1.5 s on 4G</li>
          </ul>
          <pre class="s-code"><code>[
  &#123;
    "path": "/*",
    "resourceSizes": [&#123; "resourceType": "script", "budget": 5 &#125;],
    "timings": [&#123; "metric": "largest-contentful-paint", "budget": 1500 &#125;]
  &#125;
]</code></pre>
        </div>
      </section>

      <section class="s-section s-ruled">
        <h2 class="s-h2">Questions founders ask</h2>
        <div class="s-body">
          <details class="s-faq" open>
            <summary>Do you design too?</summary>
            <p>Either way. Bring your designs, or I will design the UX and UI.</p>
          </details>
          <details class="s-faq">
            <summary>How do quotes work?</summary>
            <p>
              After a short call I send a written scope with a price and a timeline. No hourly
              surprises.
            </p>
          </details>
          <details class="s-faq">
            <summary>What about timezones?</summary>
            <p>
              I am in Tunis (UTC+1, no daylight saving): full overlap with Europe, mornings with
              India and Singapore, afternoons with the US East Coast.
            </p>
          </details>
        </div>
      </section>

      <section class="s-section s-ruled s-cv">
        <h2 class="s-h2">Experience</h2>
        <div class="s-body">
          <article class="s-cv-entry">
            <div class="s-cv-head">
              <h3 class="s-h4">Full-stack Engineer</h3>
              <p class="s-cv-dates">Dates TBD (sample)</p>
            </div>
            <p class="s-cv-org">Freelance, Upwork · Remote</p>
            <ul>
              <li>Shipped 10+ client projects for startups in 7 countries, 100% Job Success.</li>
              <li>Built React and Next.js front ends, Node.js APIs and Solidity smart contracts.</li>
              <li>Set performance, accessibility and security budgets on every project.</li>
            </ul>
          </article>
        </div>
      </section>

      <section class="s-section s-ruled">
        <h2 class="s-h2">Send a message</h2>
        <div class="s-body">
          <div class="s-form">
            <div class="s-field">
              <label for={id('name')}>Name</label>
              <input id={id('name')} type="text" autocomplete="off" />
            </div>
            <div class="s-field">
              <label for={id('email')}>Email</label>
              <input id={id('email')} type="email" autocomplete="off" />
            </div>
            <div class="s-field s-field-wide">
              <label for={id('message')}>What are you building?</label>
              <textarea id={id('message')} rows="3"></textarea>
            </div>
            <div class="s-field-wide s-form-actions">
              <button class="s-btn s-btn-primary" type="button"><span>Send message</span></button>
              <span class="s-hint">I reply within 24 hours.</span>
            </div>
          </div>
        </div>
      </section>

      <section class="s-section s-ruled s-glyphs">
        <h2 class="s-h2">Glyphs</h2>
        <div class="s-body">
          <p class="s-glyph-display">Aa Gg Rr Qq &amp; 0123456789</p>
          <p class="s-glyph-ui">1,240 ms · 98 / 100 · +216 93 028 674 · UTC+1 · “quotes” — dash</p>
          <p class="s-glyph-mono"><code>const budget = &#123; lcp: 1500, js: 5 &#125;; // 0O 1lI</code></p>
        </div>
      </section>

      <footer class="s-footer s-ruled">
        <p>© 2026 Anas Deyra</p>
        <p>Press S to inspect this page.</p>
      </footer>
    </div>
  </div>
</div>
