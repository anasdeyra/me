# Copy to .env (never commit it). Secrets and server-only values only:
# site settings and contact details live in Keystatic (src/content/shared/settings.yaml).

# Resend API key for the contact form Astro Action (server only)
RESEND_API_KEY=
# Inbox that receives contact form submissions (server only)
CONTACT_TO_EMAIL=
# Sender address for contact form mail (domain must be verified in Resend)
CONTACT_FROM_EMAIL=contact@deyra.dev
