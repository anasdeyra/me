# Copy to .env (never commit it). PUBLIC_* vars are exposed to the browser.
# All of these are PLANNED (contact flow not implemented yet).

# Canonical site URL (sitemap, canonical links, OG)
PUBLIC_SITE_URL=https://example.com

# Resend API key for the contact Astro Action (server only)
RESEND_API_KEY=
# Inbox that receives contact form submissions (server only)
CONTACT_TO_EMAIL=

# Cal.com booking link, e.g. https://cal.com/your-handle/intro
PUBLIC_CAL_LINK=
# LinkedIn profile URL
PUBLIC_LINKEDIN_URL=
# WhatsApp number in international format without "+" (used for wa.me link)
PUBLIC_WHATSAPP_NUMBER=
